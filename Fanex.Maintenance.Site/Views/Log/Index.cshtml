@using Fanex.Maintenance.Criteria.Log
@model GetLogCriteria
@{
    ViewBag.Title = "View Logs";
    Layout = "~/Views/Shared/_Layout.cshtml";
    IEnumerable<Log> listLog = (IEnumerable<Log>)ViewBag.ListLog;
}
@section Head {
    <link href="~/themes/job/user/manage.less" rel="stylesheet" type="text/css" />
    <link href="~/scripts/Plugin/jquery-ui-1.8.23.custom/development-bundle/themes/base/jquery.ui.all.css"
        rel="stylesheet" type="text/css" />
    <script src="~/scripts/Plugin/jquery-ui-1.8.23.custom/development-bundle/ui/jquery.ui.core.js"
        type="text/javascript"></script>
    <script src="~/scripts/Plugin/jquery-ui-1.8.23.custom/development-bundle/ui/jquery.ui.widget.js"
        type="text/javascript"></script>
    <script src="~/scripts/Plugin/jquery-ui-1.8.23.custom/development-bundle/ui/jquery.ui.datepicker.js"
        type="text/javascript"></script>
}
@section Headline {
    <h1>
        <span class="title">@ViewBag.Title</span>
    </h1>
}
@using (Html.BeginForm())
{  
    <section id="filter-bar">
        <div class="filter-form">
            <div class="lbl-field width-auto">
                @Html.Label(@ViewResource.Category)
            </div>
            <div class="edit-field">
                @Html.DropDownListFor(m => m.CategoryId, (List<SelectListItem>)ViewBag.ListCategory, "All")
            </div>
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.Severity)
            </div>
            <div class="edit-field">
                @Html.DropDownListFor(m => m.Severity, (List<SelectListItem>)ViewBag.ListSeverity)
            </div>
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.From)
            </div>
            <div class="edit-field">
                @Html.TextBox("From", Model.From.ToString("MMM dd,yyyy"), new { @style = "width:90px;margin-right:5px;", @autocomplete = "off" })
            </div>
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.To)
            </div>
            <div class="edit-field">
                @Html.TextBox("To", Model.To.ToString("MMM dd,yyyy"), new { @style = "width:90px;margin-right:5px;", @autocomplete = "off" })
            </div>
            <div class="submit">
                <input type="submit" value="Submit" />
            </div>
            <div class="submit">
                <input type="button" value="Remove (Before date @DateTime.Now.AddDays(-5).ToShortDateString())" id="btnRemoveLog" />
            </div>
        </div>
    </section>
    @Html.HiddenFor(m => m.Page)
    <div class="pagesize">
        Page Size :
        @Html.DropDownListFor(m => m.Size, (List<SelectListItem>)ViewBag.PageSize, new { onChange = "Index.OnChangePageSize();" })
    </div>
}
@if (!ReferenceEquals(listLog, null))
{
    if (listLog.Count() > 0)
    {
    <div class="pagingcontainer">
        <a href="#" class="pagiPre pagingitem" onclick="Index.OnNextPage(-1);">← Prev</a>
        <a href="#" class="pagiNext pagingitem" onclick="Index.OnNextPage(1);">Next →</a>
    </div>
    }
}
<table class="grid">
    <thead>
        <tr>
            <th>
                #
            </th>
            <th>
                @ViewResource.Message
            </th>
            <th>
                @ViewResource.Category
            </th>
            <th>
                @ViewResource.Machine_Name
            </th>
            <th>
                @ViewResource.Timestamp
            </th>
        </tr>
    </thead>
    <tbody>
        @{
            int i = 1;
            if (!ReferenceEquals(listLog, null))
            {
                foreach (Log logitem in listLog)
                {
                    string row_class = i % 2 == 0 ? "alt" : string.Empty;
					
            <tr class="@row_class">
                <td class="align-center">
                    @(i++)
                </td>
                <td>
                    @*<a href="#" class="logMessage" logid="@logitem.LogId"></a>*@@logitem.Message
                </td>
                <td class="align-center">
                    @foreach (var item in logitem.Category)
                    {
                        <label>@item.CategoryName</label>
                    }
                </td>
                <td class="align-center">
                    @logitem.MachineName
                </td>
                <td class="align-center">
                    @logitem.TimeStamp
                </td>
            </tr>
                }
            }
            else
            {
            <tr>
                <td colspan="5" class="align-center">
                    @ViewResource.NoInformationAvailable
                </td>
            </tr>
            }
        }
    </tbody>
</table>
<input type="hidden" id="countData" value="listLog.Count()" />
@Html.Hidden("imagePath", (string)@Url.Content("~/images/calendar.gif"))
@section Foot {
    <script src="~/scripts/Logs/Index.js" type="text/javascript"></script>
    <script type="text/javascript">
        var dateNow = $("#dateNow").val();

        $(function () {

            $("#From").datepicker({
                defaultDate: "+1w",
                changeMonth: true,
                numberOfMonths: 1,
                dateFormat: "M dd,yy",
                showOn: "button",
                buttonImage: $('#imagePath').val(),
                buttonText: "From",
                buttonImageOnly: true,
                onSelect: function (selectedDate) {
                    $("#To").datepicker("option", "minDate", selectedDate);
                    //                    $("#To").val($(this).val());
                }
            });
            $("#To").datepicker({
                defaultDate: "+1w",
                changeMonth: true,
                numberOfMonths: 1,
                dateFormat: "M dd,yy",
                showOn: "button",
                buttonImage: $('#imagePath').val(),
                buttonText: "To",
                buttonImageOnly: true,
                onSelect: function (selectedDate) {
                }
            });
        });        
    </script>
}
