@using Fanex.Maintenance.Core.Model
@using Fanex.Maintenance.Core.Criteria.Log
@model GetLogCriteria
@{
    ViewBag.Title = "Index Logs";
    Layout = "~/Views/Shared/_Layout.cshtml";
    IEnumerable<Logs> listLog = (IEnumerable<Logs>)ViewBag.ListLog;
}
@section Head {
    <link href="~/themes/nap/site/manage.less" rel="stylesheet" type="text/css" />
    <link href="~/scripts/Plugin/jquery-ui-1.8.23.custom/development-bundle/themes/base/jquery.ui.all.css"
        rel="stylesheet" type="text/css" />
    <script src="~/scripts/Plugin/jquery-ui-1.8.23.custom/development-bundle/ui/jquery.ui.core.js"
        type="text/javascript"></script>
    <script src="~/scripts/Plugin/jquery-ui-1.8.23.custom/development-bundle/ui/jquery.ui.widget.js"
        type="text/javascript"></script>
    <script src="~/scripts/Plugin/jquery-ui-1.8.23.custom/development-bundle/ui/jquery.ui.datepicker.js"
        type="text/javascript"></script>
}
@section Headline {
    <h1>
        <span class="title">@ViewBag.Title</span>
    </h1>
}
<section id="filter-bar">    
        @using (Html.BeginForm())
        {       
			<div class="filter-form">	
            <div class="lbl-field width-auto">
				@Html.LabelFor(m => m.CategoryId)
			</div>
            <div class="edit-field">				
               @Html.DropDownListFor(m => m.CategoryId, (List<SelectListItem>)ViewBag.ListCategory)
			</div>		
            <div class="lbl-field width-auto">
				@Html.LabelFor(m => m.Severity)
			</div>
            <div class="edit-field">				
                @Html.DropDownListFor(m => m.Severity, (List<SelectListItem>)ViewBag.ListSeverity)
			</div>					                                   
            <div class="lbl-field width-auto">
				@Html.LabelFor(m => m.From)
			</div>
            <div class="edit-field">				                
                @Html.TextBoxFor(m => m.From, new { @style = "width:90px;margin-right:5px;" })
			</div>					                                   
            <div class="lbl-field width-auto">
				@Html.LabelFor(m => m.To)
			</div>
            <div class="edit-field">				
                 @Html.TextBoxFor(m => m.To, new { @style = "width:90px;margin-right:5px;" })
			</div>					                                   
            <div class="submit">
					<input type="submit" value="Submit" />                  
		    </div>                               
            <div class="submit">
					<input type="button" value="Remove (Before date @DateTime.Now.AddDays(-5).ToShortDateString())" id="btnRemoveLog" />                  
                   
		    </div>                               
			</div>    
            <div class="pagesize">
                Page Size :
                @Html.DropDownListFor(m => m.Size, (List<SelectListItem>)ViewBag.PageSize)
            </div>        
        }    
    </section>
<table class="grid">
    <thead>
        <tr>
            <th>
                #
            </th>
            <th>
                Message
            </th>
            <th>
                Category
            </th>
            <th>
                Machine Name
            </th>
            <th>
                Timestamp
            </th>
        </tr>
    </thead>
    <tbody>
        @{
            int i = 0;
            if (!ReferenceEquals(listLog, null))
            {
                foreach (Logs logitem in listLog)
                {
                    string row_class = i % 2 == 0 ? "alt" : string.Empty;
					
            <tr class="@row_class">
                <td class="align-center">
                    @(i + 1)
                </td>
                <td>
                    @*<a href="#" class="logMessage" logid="@logitem.LogId"></a>*@@logitem.Message
                </td>
                <td class="align-center">
                    @foreach (var item in logitem.Category)
                    {
                        <label>@item.CategoryName</label>
                    }
                </td>
                <td class="align-center">
                    @logitem.MachineName
                </td>
                <td class="align-center">
                    @logitem.TimeStamp
                </td>
            </tr>
                }
            }
            else
            {
            <tr>
                <td colspan="5">
                    Not found !
                </td>
            </tr>
            }
        }
    </tbody>
</table>
@Html.Hidden("dateNow", DateTime.Now.ToString("dd/MM/yyyy"))
@section Foot {
    <script src="../../scripts/Logs/Index.js" type="text/javascript"></script>
    <script type="text/javascript">
        var dateNow = $("#dateNow").val();

        $(function () {

            $("#From").val(dateNow);
            $("#To").val(dateNow);

            $("#From").datepicker({
                showOn: "button",
                buttonImage: "images/calendar.gif",
                buttonImageOnly: true,
                dateFormat: "dd/mm/yy"
            });

            $("#To").datepicker({
                showOn: "button",
                buttonImage: "images/calendar.gif",
                buttonImageOnly: true,
                dateFormat: "dd/mm/yy"
            });
        });        
    </script>
}
