@using Fanex.Maintenance.Criteria.Log
@model GetLogCriteria
@{
    ViewBag.Title = "View Logs";
    Layout = "~/Views/Shared/_Layout.cshtml";
    IEnumerable<Log> listLog = (IEnumerable<Log>)ViewBag.ListLog;
}
@section Head {
    <link href="~/themes/job/user/manage.less" rel="stylesheet" type="text/css" />
    <link href="~/scripts/Plugin/Fanex.Grid/Fanex.Grid.css" rel="stylesheet" type="text/css" />
    <link href="~/scripts/Plugin/Fanex.Grid/Fanex.Pagination.css" rel="stylesheet" type="text/css" />
}
@section Headline {
    <h1>
        <span class="title">@ViewBag.Title</span>
    </h1>
}
@using (Html.BeginForm())
{  
    <section id="filter-bar">
        <div class="filter-form">
            <div class="lbl-field width-auto">
                @Html.Label(@ViewResource.Category)
            </div>
            <div class="edit-field">
                @Html.DropDownListFor(m => m.CategoryId, (List<SelectListItem>)ViewBag.ListCategory, "All")
            </div>
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.Severity)
            </div>
            <div class="edit-field">
                @Html.DropDownListFor(m => m.Severity, (List<SelectListItem>)ViewBag.ListSeverity)
            </div>
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.From)
            </div>
            <div class="edit-field">
                @Html.TextBox("From", Model.From.ToString("MMM dd,yyyy"), new { @style = "width:90px;margin-right:5px;", @autocomplete = "off" })
            </div>
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.To)
            </div>
            <div class="edit-field">
                @Html.TextBox("To", Model.To.ToString("MMM dd,yyyy"), new { @style = "width:90px;margin-right:5px;", @autocomplete = "off" })
            </div>
            <div class="submit">
                <input type="button" value="Submit" id="submit" />
            </div>
            <div class="submit">
                <input type="button" value="Remove (Before date @DateTime.Now.AddDays(-5).ToShortDateString())" id="btnRemoveLog" />
            </div>
        </div>
    </section>
    @Html.HiddenFor(m => m.Page)
    <div id="gridId" class="freegrid  content-grid">
    </div>
}
@Html.Hidden("imagePath", (string)@Url.Content("~/images/calendar.gif"))
@section Foot {
    <script src="~/scripts/Logs/Index.js" type="text/javascript"></script>
    <script type="text/javascript">
        var dateNow = $("#dateNow").val();

        $(function () {

            $("#From").datepicker({
                defaultDate: "+1w",
                changeMonth: true,
                numberOfMonths: 1,
                dateFormat: "M dd,yy",
                showOn: "button",
                buttonImage: $('#imagePath').val(),
                buttonText: "From",
                buttonImageOnly: true,
                onSelect: function (selectedDate) {
                    $("#To").datepicker("option", "minDate", selectedDate);
                    //                    $("#To").val($(this).val());
                }
            });
            $("#To").datepicker({
                defaultDate: "+1w",
                changeMonth: true,
                numberOfMonths: 1,
                dateFormat: "M dd,yy",
                showOn: "button",
                buttonImage: $('#imagePath').val(),
                buttonText: "To",
                buttonImageOnly: true,
                onSelect: function (selectedDate) {
                }
            });
        });        
    </script>
}
