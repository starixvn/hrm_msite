@{
    ViewBag.Title = "Server Management";
    Layout = "~/Views/Shared/_SqlJobManagementLayout.cshtml";
    var leftArray = (List<ResourceInfo>)ViewBag.LeftArray;
    var rightArray = (List<ResourceInfo>)ViewBag.RightArray;    
    
}
@helper RenderContainer(ResourceInfo resourceInfo)
    {

        var sqlCpuId = resourceInfo.ServerName + "SqlCpu";
        var sqlMemoryId = resourceInfo.ServerName + "Memory";
    <div class="subcontainer" informvalue="0" ishightlight="0">
        <div class="serverinfo">
            <div class="serveripchart" serverdetailip="@resourceInfo.ServerIp">@resourceInfo.ServerIp</div>
            <span class="servercpu"><span class="servermemoryusagevalue">0</span>%</span> <span
                class="servermemory"><span class="servermemoryusage">0</span>%</span> <a class="toggler collapse" servername="@resourceInfo.ServerName" servershow="1" title="Expand/Collapse" href="javascript:void(0)">
                </a>
        </div>
        <div id="@sqlCpuId" class="sqlcpu">
            <div class="loading">
            </div>
        </div>
        <div id="@sqlMemoryId" class="memory">
            <div class="loading">
            </div>
        </div>
    </div>
}
@section Head {
    <link href="~/themes/job/server/manage.less" rel="stylesheet" type="text/css" />
    <script src="~/scripts/Plugin/highchart/highcharts.js" type="text/javascript"></script>
    <script src="~/scripts/Plugin/highchart/exporting.js" type="text/javascript"></script>
    <script src="~/scripts/lib/jquery.signalR-1.0.0-rc1.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/signalr/hubs"></script>
    <script src="~/scripts/Job/ServerManagement.js" type="text/javascript"></script>
    <script type="text/javascript">
        var getDataTimeInterval = @(AppSetting.GetServerResourcesInfoInterval);
        var getCpuUtilizationInterval = @(AppSetting.GetCpuUtilizationInterval);
        var getMemoryUtilizationInterval = @(AppSetting.GetMemoryUtilizationInterval);
    </script>
}
@section HeaderBar {
    <article class="breadcrumbs">
        <a href="index.html"></a>
        <div class="breadcrumb_divider">
        </div>
        <a class="current">@ViewResource.ServerManagement</a>
        
        </article>
    <a id="togglerall" class="toggler collapse" servershow="1" title="Expand/Collapse"
        href="javascript:void(0)" style="margin-top: 12px; margin-right: 2px;"></a>
}
<section class="column" id="main">
    <div class="content">
        <table class="tablesorter" id="dataTable" style="width: 99%; display:none;">
            <thead>
                <tr>
                    <th>
                        Under development
                    </th>
                </tr>
            </thead>
        </table>
        <div id="resourceInfoContainer">
            <div id="resourceInfoContainerLeft" class="connectedSortable"> 
                @foreach (var resourceInfo in leftArray)
                {
                    @RenderContainer(resourceInfo)
                }
            </div>
            <div id="resourceInfoContainerRight" class="connectedSortable"> 
                @foreach (var resourceInfo in rightArray)
                {
                    @RenderContainer(resourceInfo)
                }
            </div>
        </div>
    </div>
    
</section>
@section Foot {
    <script type="text/javascript">
        $(function () {
            Highcharts.setOptions({
                global: {
                    useUTC: false
                }
            });
        });
    </script>
}
