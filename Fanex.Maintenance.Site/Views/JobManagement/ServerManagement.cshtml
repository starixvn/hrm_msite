@{
    ViewBag.Title = "Server Management";
    Layout = "~/Views/Shared/_SqlJobManagementLayout.cshtml";    
}
@section Head {
    <link href="~/themes/job/server/manage.less" rel="stylesheet" type="text/css" />
    <style type="text/css">
        .sqlcpu
        {
            width: 100%;
            height: 45%;
            float: left;
            margin-top: 5px;
        }
        .memory
        {
            width: 100%;
            height: 45%;
            float: left;
        }
        .subcontainer
        {
            width: 90%;
            height: 420px;
            float: left;
            margin-left: 20px;
            background-color: #F4F4F4;
            border: 1px solid #C8C8C8;
            border-radius: 2px 2px 2px 2px;
            box-shadow: 1px 1px 5px #888888;
            margin-top: 10px;
            padding: 15px 10px;
        }
        #resourceInfoContainer
        {
            height: 760px;
            overflow: auto;
        }
        .serverinfo
        {
            font-weight: bold;
            margin-bottom: 10px;
            text-align: center;
            width: 100%;
        }
        #resourceInfoContainerLeft
        {
            width: 50%;
            height: 100%;
            float: left;
        }
        #resourceInfoContainerRight
        {
            width: 50%;
            height: 100%;
            float: left;
        }
        .serveripchart
        {
            padding-top: 2px;
            cursor: pointer;
        }
    </style>
    <script src="~/scripts/lib/jsrender.js" type="text/javascript"></script>
    <script src="~/scripts/Plugin/highchart/highcharts.js" type="text/javascript"></script>
    <script src="~/scripts/Plugin/highchart/exporting.js" type="text/javascript"></script>
    <script src="~/scripts/lib/jquery.signalR-0.5.3.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/signalr/hubs"></script>
    <script type="text/javascript">
        var ServerManagement = function ($) {
            return {
                Servers: [],
                FirstTime: true,
                MaxMemory: 0,
                UpdateServerData: function (resourceInfo) {
                    for (var i = 0; i < ServerManagement.Servers.length; i++) {
                        if (ServerManagement.Servers[i].ServerIp == resourceInfo.ServerIp) {
                            ServerManagement.Servers[i] = resourceInfo;
                            break;
                        }
                    }
                },
                GetMaxMemory: function (serverName) {
                    for (var i = 0; i < ServerManagement.Servers.length; i++) {
                        var server = ServerManagement.Servers[i];
                        if (server.ServerName == serverName) {
                            return server.TotalMemory;
                        }
                    }
                },
                GetDataFromServerName: function (serverName, type) {
                    for (var i = 0; i < ServerManagement.Servers.length; i++) {
                        var server = ServerManagement.Servers[i];
                        if (server.ServerName == serverName) {
                            if (type == 1) {
                                var containerdiv = $("#" + serverName + (type == 1 ? "SqlCpu" : "Memory")).prev();
                                var oldSqlCpu = containerdiv.find(".servermemoryusagevalue").text();
                                var newSqlCpu = server.SqlCpuPercent;
                                if (oldSqlCpu != newSqlCpu) {
                                    var currentColor = containerdiv.find(".servermemoryusagevalue").css("color");
                                    containerdiv.find(".servermemoryusagevalue").css("color", "Red");
                                    setTimeout(function () {
                                        containerdiv.find(".servermemoryusagevalue").css("color", currentColor);
                                    }, 3000);
                                }
                                containerdiv.find(".servermemoryusagevalue").text(newSqlCpu);

                                var oldSqlRam = containerdiv.find(".servermemoryusage").text();
                                var newSqlRam = Math.round(server.MemoryUsage * 100 / server.TotalMemory);
                                if (oldSqlRam != newSqlRam) {
                                    var currentColor = containerdiv.find(".servermemoryusage").css("color");
                                    containerdiv.find(".servermemoryusage").css("color", "Red");
                                    setTimeout(function () {
                                        containerdiv.find(".servermemoryusage").css("color", currentColor);
                                    }, 3000);
                                }
                                containerdiv.find(".servermemoryusage").text(newSqlRam);

                                return server.SqlCpuPercent;
                            }
                            else {
                                return server.MemoryUsage;
                            }
                        }
                    }
                },
                RenderChart: function (charid, type, title, ytitle, pointTitle) {
                    var charIdCombine = charid + (type == 1 ? "SqlCpu" : "Memory");
                    var pointColor = (type == 1 ? '#4572A7' : '#888888');
                    var yAxisCustom = (type == 1 ? {
                        title: {
                            text: ytitle
                        },
                        plotLines: [{
                            value: 0,
                            width: 1,
                            color: '#8011111'
                        }],
                        min: 0,
                        max: 100
                    } : {
                        title: {
                            text: ytitle
                        },
                        plotLines: [{
                            value: 0,
                            width: 1,
                            color: '#8011111'
                        }],
                        min: 0,
                        max: 100
                    });
                    return new Highcharts.Chart({
                        name: charid,
                        chart: {
                            renderTo: charIdCombine,
                            type: 'spline',
                            marginRight: 25,
                            events: {
                                load: function () {

                                    // set up the updating of the chart each second
                                    var series = this.series[0];
                                    setInterval(function () {
                                        var x = (new Date()).getTime() // current time
                                        y = ServerManagement.GetDataFromServerName(charid, type); //Math.random();
                                        if (type != 1) {
                                            y = Math.round(y * 100 / ServerManagement.GetMaxMemory(charid))
                                        }
                                        series.addPoint([x, y], true, true);
                                    }, 4000);
                                }
                            }
                        },
                        title: {
                            text: title
                        },
                        xAxis: {
                            type: 'datetime',
                            tickPixelInterval: 75
                        },
                        yAxis: yAxisCustom,
                        tooltip: {
                            formatter: function () {
                                return '<b>' + this.series.name + '</b><br/>' +
                                Highcharts.dateFormat('%Y-%m-%d %H:%M:%S', this.x) + '<br/>' +
                                Highcharts.numberFormat(this.y, 2);
                            }
                        },
                        legend: {
                            enabled: false
                        },
                        exporting: {
                            enabled: false
                        },
                        series: [{
                            name: pointTitle,
                            color: pointColor,
                            data: (function () {
                                // generate an array of random data
                                var data = [],
                                time = (new Date()).getTime(),
                                i;

                                for (i = -10; i <= 0; i++) {
                                    var yValue = ServerManagement.GetDataFromServerName(charid, type);
                                    if (type != 1) {
                                        yValue = Math.round(yValue * 100 / ServerManagement.GetMaxMemory(charid))
                                    }
                                    data.push({
                                        x: time + i * 4000,
                                        y: yValue
                                    });
                                }
                                return data;
                            })()
                        }]
                    });
                }
            };

        } (jQuery);

        // Proxy created on the fly
        var serverInfoHub = $.connection.serverInfoHub;

        // Declare a function on the chat hub so the server can invoke it
        serverInfoHub.addMessage = function (message) {
            alert(message);
        };

        serverInfoHub.firstMessage = function (resourceInfoes) {
            $('#information').empty()
            for (var i = 0; i < resourceInfoes.length; i++) {
                ServerManagement.Servers.push(resourceInfoes[i]);
            }
            var totalLeft = Math.round(ServerManagement.Servers.length / 2);
            var totalRight = ServerManagement.Servers.length - totalLeft;
            var arrayLeft = [];
            var arrayRight = [];
            var index;
            for (var i = 0; i < totalLeft; i++) {
                arrayLeft.push(ServerManagement.Servers[i]);
            }
            for (var i = totalLeft; i < totalRight + totalLeft; i++) {
                arrayRight.push(ServerManagement.Servers[i]);
            }
            $("#resourceInfoContainerLeft").empty().html($("#containerTemplate").render(arrayLeft));
            $("#resourceInfoContainerRight").empty().html($("#containerTemplate").render(arrayRight));
            ServerManagement.FirstTime = false;
            var arrayChart = [];
            for (var i = 0; i < ServerManagement.Servers.length; i++) {
                var server = ServerManagement.Servers[i];
                arrayChart.push(ServerManagement.RenderChart(server.ServerName, 1, "Sql Server Cpu", "%", "Cpu Usage"));
                arrayChart.push(ServerManagement.RenderChart(server.ServerName, 2, "Sql Server Memory Usage", "%", "Memory Usage"));
            }
            $('.subcontainer .toggler').live("click", function () {
                var $this = $(this);
                var granParent = $this.parent().parent();
                var serverName = $this.attr("servername");
                var serverShow = $this.attr("servershow");
                if (serverShow == "1") {
                    $("#" + serverName + "SqlCpu").hide("fast");
                    $("#" + serverName + "Memory").hide("fast");
                    $this.attr("servershow", "0");
                    granParent.css("height", 30);
                }
                else {
                    $("#" + serverName + "SqlCpu").show("fast");
                    $("#" + serverName + "Memory").show("fast");
                    $this.attr("servershow", "1");
                    granParent.css("height", 420);
                }
            });
            $('#togglerall').live("click", function () {
                var $this = $(this);
                var serverShow = $this.attr("servershow");
                if (serverShow == "1") {
                    //$(".subcontainer .sqlcpu,.subcontainer .memory").hide();
                    $(".subcontainer .toggler").attr("servershow", "1");
                    $(".subcontainer .toggler").trigger("click");
                    $this.attr("servershow", "0");
                }
                else {
                    //$(".subcontainer .sqlcpu,.subcontainer .memory").show();
                    $(".subcontainer .toggler").attr("servershow", "0");
                    $(".subcontainer .toggler").trigger("click");
                    $this.attr("servershow", "1");
                }
            });
            $(".serverinfo .serveripchart").live("click", function () {
                var serverIp = $(this).attr("serverdetailip");
                var queryString = NAP.resolveClientUrl("JobManagement/ServerDetail?serverIp=" + serverIp);
                parent.$("#centerFr").attr("src", queryString);
            });
            NAP.loadingBox.close();
        };

        serverInfoHub.gotMessage = function (resourceInfo) {
            ServerManagement.UpdateServerData(resourceInfo);
        };

    </script>
    <script id="containerTemplate" type="text/x-jsrender">
        <div class="subcontainer">
            <div class="serverinfo">
                <div class="serveripchart" serverdetailip="{{>ServerIp}}">{{>ServerIp}}</div>
                <span class="servercpu"><span class="servermemoryusagevalue">{{>SqlCpuPercent}}</span>%</span>
                <span class="servermemory"><span class="servermemoryusage">{{>MemoryUsage}}</span>%</span>
                <a class="toggler" servername="{{>ServerName}}" servershow="1" title="Expand/Collapse" href="javascript:void(0)">  </a>
            </div>
            <div id="{{>ServerName}}SqlCpu" class="sqlcpu"></div>
            <div id="{{>ServerName}}Memory" class="memory"></div>
        </div>
    </script>
}
@section HeaderBar {
    <article class="breadcrumbs">
        <a href="index.html"></a>
        <div class="breadcrumb_divider">
        </div>
        <a class="current">@ViewResource.ServerManagement</a>
        
        </article>
        <a id="togglerall" class="toggler" servershow="1" title="Expand/Collapse" href="javascript:void(0)" style="margin-top:16px;">  </a>
}
<section class="column" id="main">
    <div class="content">
        <table class="tablesorter" id="dataTable" style="width: 99%; display:none;">
            <thead>
                <tr>
                    <th>
                        Under development
                    </th>
                </tr>
            </thead>
        </table>
        <div id="resourceInfoContainer">
            <div id="resourceInfoContainerLeft"> </div>
            <div id="resourceInfoContainerRight"> </div>
        </div>
    </div>
    
</section>
@section Foot {
    <script type="text/javascript">
        $(function () {
            NAP.loadingBox.show();
            Highcharts.setOptions({
                global: {
                    useUTC: false
                }
            });

            $.connection.hub.start(function () {
                serverInfoHub.getListServerInfoFirstTime();
            });


        });
    </script>
}
