@{
    ViewBag.Title = "Sql Job Management";
    Layout = "~/Views/Shared/_Layout.cshtml";    
}
@section Head {
    <link href="~/themes/job/job/manage.less" rel="stylesheet" type="text/css" />
    <style type="text/css">
        body
        {
            overflow: hidden;
        }
    </style>
    <link href="~/themes/SqlJobManagement/MainContentPage.css" rel="stylesheet" type="text/css" />
}
<div class="contentbox">
    <input id="collapsepanel" type="hidden" value="0" />
    <div class="leftcontent">
        <iframe id="leftPanel" name="leftPanel" marginwidth="0" scrolling="auto" src="@Url.Action("LeftMenuPage", "JobManagement")"
            marginheight="0" frameborder="0" vspace="0" hspace="0" style="width: 100%; height: 850px;">
        </iframe>
    </div>
    <div class="rightcontent">
        <iframe id="centerFr" name="centerFr" src="" scrolling="auto" marginwidth="0" marginheight="0"
            frameborder="0" vspace="0" hspace="0" style="width: 100%; height: 850px;"></iframe>
    </div>
</div>
@Html.Hidden("type", (string)ViewBag.Type)
@Html.Hidden("server", (string)ViewBag.Server)
@Html.Hidden("jobname", (string)ViewBag.JobName)
@Html.Hidden("go", (string)ViewBag.Go)
@Html.Hidden("NapAdminRoot", Url.Content("~/"))
@section Foot{
    <script src="~/scripts/Job/Index.js" type="text/javascript"></script>
}
