<script src="~/themes/job1/js/hideshow.js" type="text/javascript"></script>
@using Fanex.Maintenance.Core.Configurations
@model ServerCollection
@{
    ViewBag.Title = "Sql Job Management";
    Layout = "~/Views/Shared/_Layout.cshtml";    
}
@section Head {
    <link href="~/themes/job/job/manage.less" rel="stylesheet" type="text/css" />
}
<aside class="column" id="sidebar">   	
		<h3>Content <a class="toggleLink" href="#"></a></h3>
		<ul class="toggle">
			<li class="icn_new_article">
                @Html.ActionLink(ViewResource.ServerManagement, "ServerManagement", "JobManagement"
                                      , new { @id = "jobmanagement_servermanagement_" })
            </li>
			<li class="icn_edit_article">
                @Html.ActionLink(ViewResource.ScheduleManagement, "ScheduleManagement", "JobManagement"
                         , new { @id = "jobmanagement_schedulemanagement_" })
            </li>
			<li class="icn_categories"> 
                @Html.ActionLink(ViewResource.JobManagement, "JobManagement", "JobManagement"
                                   , new { @id = "jobmanagement_jobmanagement_" })
                </li>			
		</ul>	
       	<h3>Database Servers <a class="toggleLink" href="#"></a></h3>   
        <ul class="toggle" style="overflow-y:auto;height:680px;">
    @{                
        var classClose = string.Empty;
        foreach (ServerElement server in Model)
        {
        <div id="demo1">
	    <ul >
		    <li id="phtml_1">                           
			    <a href="#" class="rootServer">             
                @server.ServerIp                
                </a>
			    <ul @(server.ServerIp.Replace('.', '_') != ViewBag.Server ? "style=display:none" : "")>
				    <li id="phtml_2">
					    @Html.ActionLink(ViewResource.SqlServerLog, "ServerLogManagement"
                            , new { server = server.ServerIp }
                                    , new
                                    {
                                        @id = "jobmanagement_serverlogmanagement_" + server.ServerIp.Replace('.', '_'),
                                        @class = "navChild serverlog"
                                    })
				    </li>
				    <li id="phtml_3">
					    @Html.ActionLink(ViewResource.SqlAgentLog, "AgentLogManagement"
                            , new { server = server.ServerIp }
                                                    , new
                                                    {
                                                        @id = "jobmanagement_agentlogmanagement_" + server.ServerIp.Replace('.', '_'),
                                                        @class = "navChild agentlog"
                                                    })
				    </li>
                    <li id="phtml_4">
                     @Html.ActionLink(ViewResource.Schedule, "ScheduleManagement"
                            , new { server = server.ServerIp }
        , new
        {
            @id = "jobmanagement_schedulemanagement_" + server.ServerIp.Replace('.', '_'),
            @class = "navChild shcedule"
        })
                    </li>
                    <li id="phtml_5">
                      @Html.ActionLink(ViewResource.Jobs, "JobManagement"
                            , new { server = server.ServerIp }
         , new
         {
             @id = "jobmanagement_jobmanagement_" + server.ServerIp.Replace('.', '_'),
             @class = "navChild job"
         })
                    </li>
			    </ul>
		    </li>		
	    </ul>
        </div>
        }
    }
  </ul>   
</aside>

<script type="text/javascript">
    $(document).ready(function () {

        $('.rootServer').live('click', function () {
            var liChildren = $(this).parent().find("ul");
            liChildren.toggle("fast");
        });
        @*
        var currentUrl = '@(ViewBag.Controller.ToString().ToLower() + "_" + ViewBag.Action.ToString().ToLower() + "_" + ViewBag.Server.ToString().ToLower())';
        var selectNavItem = $("#" + currentUrl);
        if (selectNavItem != undefined) {
            selectNavItem.addClass("selected");
        }*@
    });
</script>
