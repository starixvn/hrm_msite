@using Fanex.Maintenance.Core.Configurations
<!DOCTYPE html>
<!--[if IEMobile 7]><html class="no-js iem7 oldie"><![endif]-->
<!--[if (IE 7)&!(IEMobile)]><html class="no-js ie7 oldie" lang="en"><![endif]-->
<!--[if (IE 8)&!(IEMobile)]><html class="no-js ie8 oldie" lang="en"><![endif]-->
<!--[if (IE 9)&!(IEMobile)]><html class="no-js ie9" lang="en"><![endif]-->
<!--[if (gt IE 9)|(gt IEMobile 7)]><!-->
<html lang="en" class="linen">
<!--<![endif]-->
<head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8" />
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <title>@ViewBag.Title</title>
    <meta http-equiv="cleartype" content="on" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link href="~/themes/reset.css" rel="stylesheet" type="text/css" />
    <link href="~/themes/fonts.css" rel="stylesheet" type="text/css" />
    <link href="~/themes/jquery-ui/smoothness/jquery-ui-1.8.23.min.css" rel="stylesheet"
        type="text/css" />
    <link href="~/themes/assets/css/prettify.css" rel="stylesheet" type="text/css" />
    <link href="~/themes/assets/css/site.css" rel="stylesheet" type="text/css" />
    <link href="~/scripts/lib/tipsy/tipsy-1.0.0.min.css" rel="stylesheet" type="text/css" />
    <link href="~/scripts/lib/msgbox/msgbox-0.0.1.min.css" rel="stylesheet" type="text/css" />
    <script src="~/scripts/lib/jquery-1.8.0.min.js" type="text/javascript"></script>
    <script src="~/scripts/lib/modernizr-2.6.1.js" type="text/javascript"></script>
    <script src="~/themes/assets/js/prettify.min.js" type="text/javascript"></script>
    <script src="~/themes/assets/js/underscore.min.js" type="text/javascript"></script>
    <script src="~/scripts/lib/fxHeader_0.6.js" type="text/javascript"></script>
    <link href="~/themes/job/job/manage.less" rel="stylesheet" type="text/css" />
    <link href="~/scripts/Plugin/jquery.treeview/jquery.treeview.css" rel="stylesheet"
        type="text/css" />
    <script src="~/scripts/Plugin/jquery.treeview/jquery.treeview.js" type="text/javascript"></script>
    <script src="~/scripts/lib/jquery.signalR-0.5.3.js" type="text/javascript"></script>
    <script src="~/scripts/lib/jquery.qtip-1.0.0-rc3.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/signalr/hubs"></script>
    <style type="text/css">
        .imgcollapse
        {
            background: url("../themes/job/images/forward-back.png") no-repeat transparent;
            float: right;
            margin-right: 5px;
            cursor: pointer;
            background-position: 0px 0px;
            display: block;
            width: 30px;
            height: 25px;
            font-size: 0;
        }
        
        a.imgcollapse:hover
        {
            background-position: 0px -35px;
        }
    </style>
    <script src="~/scripts/Job/LeftMenuPage.js" type="text/javascript"></script>
</head>
<body>
    <section id="body">
        <div class="content">
            <section id="secondary_bar">
                <a href="#" class="imgcollapse" title="Collapse">Collapse</a>
                <div class="user">
                    <p>
                        Monitor Servers</p>
                </div>
            </section>
            <aside class="column" id="sidebar">
                <div>
                    <h3>
                        Management @*<a class="toggleLink" href="#"></a>*@</h3>
                </div>
                <ul class="toggle sidebarul">
                    <li class="icn_new_article sidebarli">
                        @Html.ActionLink(ViewResource.ServerManagement, "ServerManagement", "JobManagement"
                                      , new
                                      {
                                          @target = "centerFr",
                                          @class = "menu databaseNavi"
                                      })
                    </li>
                    <li class="icn_edit_article sidebarli">
                        @Html.ActionLink(ViewResource.ScheduleManagement, "ScheduleManagement", "JobManagement"
                         , new
                         {
                             @target = "centerFr",
                             @class = "menu scheduleNavi"
                         })
                    </li>
                    <li class="icn_categories sidebarli">
                        @Html.ActionLink(ViewResource.JobManagement, "JobManagement", "JobManagement"
                                   , new
                                   {
                                       @target = "centerFr",
                                       @class = "menu jobNavi"
                                   })
                    </li>
                    <li class="icn_tags sidebarli">
                        @Html.ActionLink(ViewResource.Job_Log_Management, "JobLogManagement", "JobManagement"
                                   , new
                                   {
                                       @target = "centerFr",
                                       @class = "menu JobLogNavi"
                                   })
                    </li>
                </ul>
                <h3>
                    Database Servers @*<a class="toggleLink" href="#"></a>*@</h3>
                <ul class="treeview" style="overflow-y: auto; height: 620px; margin-left: 10px;"
                    id="navigation">
                    @{
                        var classClose = string.Empty;
                        foreach (ServerElement server in Model)
                        {
                        <li id="phtml_1" class="closed"><span class="serverformat @server.ServerIp.Replace(".", "_") removedErrorIcon" id="server_@server.ServerIp.Replace(".", "_")">@server.ServerIp</span>
                            @*<span class="@server.ServerIp.Replace(".", "_") removedErrorIcon">
                        </span>*@
                            <ul>
                                <li id="phtml_2" class="subitemmanage">
                                    @Html.ActionLink(ViewResource.Monitor, "ServerDetail"
                             , new { serverIp = server.ServerIp }
                                        , new
                                        {
                                            @class = "navChild serverlog",
                                            @target = "centerFr"
                                        })
                                </li>
                                <li id="phtml_2" class="subitemmanage">
                                    @Html.ActionLink(ViewResource.SqlServerLog, "ServerLogManagement"
                                , new { server = server.ServerIp }
                                        , new
                                        {
                                            @class = "navChild serverlog",
                                            @target = "centerFr"
                                        })
                                </li>
                                <li id="phtml_3">
                                    @Html.ActionLink(ViewResource.SqlAgentLog, "AgentLogManagement",
                                                     new { server = server.ServerIp },
                                                     new
                                                        {
                                                            @class = "navChild agentlog",
                                                            @target = "centerFr"
                                                        })
                                    <span class="@server.ServerIp.Replace(".", "_")@((int)NotifyType.AgentLog) removedErrorIcon">
                                    </span></li>
                                <li id="phtml_4">
                                    @Html.ActionLink(ViewResource.Schedule, "ScheduleManagement",
                         new { server = server.ServerIp },
                         new
                            {
                                @class = "navChild shcedule",
                                @target = "centerFr"
                            })
                                </li>
                                <li id="phtml_5">
                                    @Html.ActionLink(ViewResource.Jobs, "JobManagement",
                          new { server = server.ServerIp },
                          new
                             {
                                 @class = "navChild job",
                                 @target = "centerFr"
                             })
                                    @*<span class="@server.ServerIp.Replace(".", "_")@((int)NotifyType.Job) removedErrorIcon">
                                    </span>*@</li>
                                <li id="phtml_6">
                                    @Html.ActionLink(ViewResource.JobLog, "JobLogManagement",
                          new { server = server.ServerIp },
                          new
                             {
                                 @class = "navChild joblog",
                                 @target = "centerFr"
                             })
                                    <span class="@server.ServerIp.Replace(".", "_")@((int)NotifyType.Job) removedErrorIcon" serverip="@server.ServerIp.Replace(".", "_")">
                                    </span></li>
                            </ul>
                        </li>
                        }
                    }
                </ul>
            </aside>
        </div>
    </section>
</body>
</html>
@Html.Hidden("NapAdminRoot", Url.Content("~/"))
<script src="~/scripts/lib/jquery-ui-1.8.23.min.js" type="text/javascript"></script>
<script src="~/scripts/lib/jquery.validate.min.js" type="text/javascript"></script>
<script src="~/scripts/lib/jquery.validate.unobtrusive.min.js" type="text/javascript"></script>
<script src="~/scripts/lib/tipsy/tipsy-1.0.0.min.js" type="text/javascript"></script>
<script src="~/scripts/lib/msgbox/msgbox-0.0.1.min.js" type="text/javascript"></script>
<script src="~/scripts/Maintenance.js" type="text/javascript"></script>
<script src="~/scripts/_Layout.js" type="text/javascript"></script>
<link href="~/scripts/lib/chosen/chosen.css" rel="stylesheet" type="text/css" />
<script src="~/scripts/lib/chosen/chosen.jquery.js" type="text/javascript"></script>
