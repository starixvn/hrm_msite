@using Fanex.Maintenance.Core.Configurations
<!DOCTYPE html>
<!--[if IEMobile 7]><html class="no-js iem7 oldie"><![endif]-->
<!--[if (IE 7)&!(IEMobile)]><html class="no-js ie7 oldie" lang="en"><![endif]-->
<!--[if (IE 8)&!(IEMobile)]><html class="no-js ie8 oldie" lang="en"><![endif]-->
<!--[if (IE 9)&!(IEMobile)]><html class="no-js ie9" lang="en"><![endif]-->
<!--[if (gt IE 9)|(gt IEMobile 7)]><!-->
<html lang="en" class="linen">
<!--<![endif]-->
<head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8" />
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <title>@ViewBag.Title</title>
    <meta http-equiv="cleartype" content="on" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link href="~/themes/reset.css" rel="stylesheet" type="text/css" />
    <link href="~/themes/fonts.css" rel="stylesheet" type="text/css" />
    <link href="~/themes/jquery-ui/smoothness/jquery-ui-1.8.23.min.css" rel="stylesheet"
        type="text/css" />
    <link href="~/themes/assets/css/prettify.css" rel="stylesheet" type="text/css" />
    <link href="~/themes/assets/css/site.css" rel="stylesheet" type="text/css" />
    <link href="~/scripts/lib/tipsy/tipsy-1.0.0.min.css" rel="stylesheet" type="text/css" />
    <link href="~/scripts/lib/msgbox/msgbox-0.0.1.min.css" rel="stylesheet" type="text/css" />
    <script src="~/scripts/lib/jquery-1.8.0.min.js" type="text/javascript"></script>
    <script src="~/scripts/lib/modernizr-2.6.1.js" type="text/javascript"></script>
    <script src="~/themes/assets/js/prettify.min.js" type="text/javascript"></script>
    <script src="~/themes/assets/js/underscore.min.js" type="text/javascript"></script>
    <script src="~/scripts/lib/fxHeader_0.6.js" type="text/javascript"></script>
    <link href="~/themes/job/job/manage.less" rel="stylesheet" type="text/css" />
    <link href="~/scripts/Plugin/jquery.treeview/jquery.treeview.css" rel="stylesheet"
        type="text/css" />
    <style type="text/css">
        .imgcollapse
        {
            float: right;
            margin-right: 10px;
            margin-top: 5px;
            cursor: pointer;
        }
    </style>
    <script src="~/scripts/Plugin/jquery.treeview/jquery.treeview.js" type="text/javascript"></script>
    <script src="~/scripts/lib/jquery.signalR-0.5.3.js" type="text/javascript"></script>
    <script src="~/scripts/lib/jquery.qtip-1.0.0-rc3.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/signalr/hubs"></script>
    <script type="text/javascript">
        // Proxy created on the fly
        var notitficationHub = $.connection.notificationHub;

        // Declare a function on the chat hub so the server can invoke it
        notitficationHub.addMessage = function (message) {
            alert(message);
        };

        notitficationHub.gotMessage = function (notifyInfoes) {
            for (var i = 0; i < notifyInfoes.length; i++) {
                var notifyInfo = notifyInfoes[i];
                var linkErrorPage = "";
                if (notifyInfo.Type == 2) {
                    linkErrorPage = "JobManagement/JobLogManagement?server=" + notifyInfo.ServerIp.replaceAll('_', '.') + "&job=" + notifyInfo.JobName + "&top=1";
                }
                else {
                    linkErrorPage = "JobManagement/AgentLogManagement?server=" + server.replaceAll('_', '.') + "&top=1";
                }

                var message = notifyInfo.Type == 1 ? "Sql Agent Error" : "Job Error";
                message += "<br/>" + notifyInfo.Message;
                $('span.' + notifyInfo.ServerIp).addClass("notifyError");
                $('span.' + notifyInfo.ServerIp + notifyInfo.Type).addClass("notifyError").attr("linkerrorpage", linkErrorPage);
                $('span.' + notifyInfo.ServerIp + ',' + 'span.' + notifyInfo.ServerIp + notifyInfo.Type).qtip({
                    content: message,
                    position:
                {
                    corner: {
                        tooltip: "topRight", // Use the corner...
                        target: "bottomRight" // ...and opposite corner
                    }
                },
                    hide: {
                        fixed: true // Make it fixed so it can be hovered over
                    },
                    style: {
                        border: {
                            width: 5,
                            radius: 10
                        },
                        width: 150,
                        padding: 10,
                        textAlign: 'center',
                        tip: true, // Give it a speech bubble tip with automatic corner detection
                        name: 'dark' // Style it according to the preset 'cream' style
                    }
                })
            }
        }

        $(function () {
            $.connection.hub.start(function () {
            });

            $('.removedErrorIcon').click(function () {
                $(this).removeClass("notifyError");
                $(this).parent().parent().prev().removeClass("notifyError");
                parent.$("#centerFr").attr("src", $(this).attr("linkerrorpage"));
            });

            $('.agentlog').click(function () {
                $(this).next().removeClass("notifyError");
                $(this).parent().parent().prev().removeClass("notifyError");

            });

            $('.job').click(function () {
                $(this).next().removeClass("notifyError");
                $(this).parent().parent().prev().removeClass("notifyError");
            });
            $("#navigation").treeview({
                animated: "fast"
            });

            $('.rootServer').live('click', function () {
                var liChildren = $(this).parent().find("ul");
                liChildren.toggle("fast");
            });

            $('.menu').live('click', function () {
                $('.menu').removeClass("selected");
                $('.navChild').removeClass("selected");
                $(this).addClass("selected");
            });

            $('.navChild').live('click', function () {
                $('.navChild').removeClass("selected");
                $('.menu').removeClass("selected");
                $(this).addClass("selected");
            });

            $('img.imgcollapse').click(function () {
                parent.$('#centerFr').contents().find('img.navigater').show();
                parent.$('div.leftcontent').css("width", "0%");
                parent.$('div.rightcontent').css("width", "100%");
                parent.$("#collapsepanel").val("1");
            });
        });
    </script>
</head>
<body>
    <section id="body">
        <div class="content">
<section id="secondary_bar">
         <img class="imgcollapse" src="~/themes/job/images/forward-back.png" />
		<div class="user">
			<p>Job Management</p>
			<!-- <a class="logout_user" href="#" title="Logout">Logout</a> -->
		</div>
</section>
<aside class="column" id="sidebar">
		<div><h3>Content @*<a class="toggleLink" href="#"></a>*@</h3>
        </div>
		<ul class="toggle sidebarul">
			<li class="icn_new_article sidebarli">
                @Html.ActionLink(ViewResource.ServerManagement, "ServerManagement", "JobManagement"
                                      , new
                                      {
                                          @target = "centerFr",
                                          @class = "menu"
                                      })
            </li>
			<li class="icn_edit_article sidebarli">
                @Html.ActionLink(ViewResource.ScheduleManagement, "ScheduleManagement", "JobManagement"
                         , new
                         {
                             @target = "centerFr",
                             @class = "menu"
                         })
            </li>
			<li class="icn_categories sidebarli">
                @Html.ActionLink(ViewResource.JobManagement, "JobManagement", "JobManagement"
                                   , new
                                   {
                                       @target = "centerFr",
                                       @class = "menu"
                                   })
                </li>
		</ul>
       	<h3>Database Servers @*<a class="toggleLink" href="#"></a>*@</h3>
        <ul class="treeview" style="overflow-y:auto;height:650px; margin-left:10px;" id="navigation">
        @{
            var classClose = string.Empty;
            foreach (ServerElement server in Model)
            {
		        <li id="phtml_1" class="closed">
                <span class="serverformat">@server.ServerIp</span>
                <span class="@server.ServerIp.Replace(".", "_") removedErrorIcon"></span>
			        <ul>
				        <li id="phtml_2" class="subitemmanage">
					        @Html.ActionLink(ViewResource.SqlServerLog, "ServerLogManagement"
                                , new { server = server.ServerIp }
                                        , new
                                        {
                                            @class = "navChild serverlog",
                                            @target = "centerFr"
                                        })

				        </li>
				        <li id="phtml_3">
					        @Html.ActionLink(ViewResource.SqlAgentLog, "AgentLogManagement",
                                                     new { server = server.ServerIp },
                                                     new
                                                        {
                                                            @class = "navChild agentlog",
                                                            @target = "centerFr"
                                                        })
                                                         <span class="@server.ServerIp.Replace(".", "_")@((int)NotifyType.AgentLog) removedErrorIcon"></span>
				        </li>
                        <li id="phtml_4">
                         @Html.ActionLink(ViewResource.Schedule, "ScheduleManagement",
                         new { server = server.ServerIp },
                         new
                            {
                                @class = "navChild shcedule",
                                @target = "centerFr"
                            })
                        </li>
                        <li id="phtml_5">
                          @Html.ActionLink(ViewResource.Jobs, "JobManagement",
                          new { server = server.ServerIp },
                          new
                             {
                                 @class = "navChild job",
                                 @target = "centerFr"
                             })
                                 <span class="@server.ServerIp.Replace(".", "_")@((int)NotifyType.Job) removedErrorIcon"></span>
                        </li>
			        </ul>
		        </li>
            }
        }
  </ul>
</aside>
</div>
</section>
</body>
</html>
@Html.Hidden("NapAdminRoot", Url.Content("~/"))
