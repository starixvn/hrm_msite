@{
    ViewBag.Title = "Server Detail";
    Layout = "~/Views/Shared/_SqlJobManagementLayout.cshtml";
    var serverFullInfo = (ServerFullInfo)ViewBag.ServerFullInfo;
}
@section Head {
    <link href="~/themes/job/server/detail.less" rel="stylesheet" type="text/css" />
    <script src="~/scripts/Plugin/highchart/highcharts.js" type="text/javascript"></script>
    <script src="~/scripts/Plugin/highchart/exporting.js" type="text/javascript"></script>
    <script src="~/scripts/lib/jquery.signalR-0.5.3.js" type="text/javascript"></script>
    <script src="~/scripts/Job/ServerDetail.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/signalr/hubs"></script>
    <script type="text/javascript">
        var serverIp = '@ViewBag.ServerIp';
    </script>
}
@section HeaderBar {
    <article class="breadcrumbs">
        <a href="index.html"></a>
        <div class="breadcrumb_divider">
        </div>
        <a class="current">Server Detail</a></article>
}
<section class="column" id="main">
    <div class="content">
        <div class="resourceinfo">
         <div class="form">
            <div class="form-row required">
                <div class="lbl-field">
                   Server: @ViewBag.ServerIp @*@Html.DropDownList("ListServer", (List<SelectListItem>)ViewBag.ListServer)   <span class="backlink">← Back To List</span>*@
                </div>
                    
            </div>
            <div class="form-row required">
                <div class="lbl-field">
                    Cpu: <span id="currentcpu">0</span> %, @serverFullInfo.NumberPhysicalCpu Cpu(s) Physical, @serverFullInfo.NumberLogicalCpu Cpu(s) Logical
                </div>
            </div>
            <div class="form-row required">
                <div class="lbl-field">
                    Memory: <span id="currentmemory">0</span> / @(Math.Round((double)serverFullInfo.TotalPhysicalMemory / 1024)) GB
                </div>
            </div>
        </div>
        
        <div id="slqCpuContainer">
        </div>
        <div id="memoryContainer">
        </div>
        </div>
        
    </div>
</section>
@section Foot {
    <script type="text/javascript">
        $(function () {
            NAP.loadingBox.show();
        });
    </script>
}
