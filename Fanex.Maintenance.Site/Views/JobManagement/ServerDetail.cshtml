@{
    ViewBag.Title = "Server Detail";
    Layout = "~/Views/Shared/_SqlJobManagementLayout.cshtml";
    var serverFullInfo = (ServerFullInfo)ViewBag.ServerFullInfo;
}
@section Head {
    <link href="~/themes/job/server/manage.less" rel="stylesheet" type="text/css" />
    <style type="text/css">
        #resourceInfoContainer
        {
            width: 99%;
            height: 75%;
        }
        #slqCpuContainer
        {
            float:left;  
            width: 100%; 
             height: 38%;
             margin-bottom: 10px;
        }
        
        #memoryContainer
        {
            float:left;   
            width: 100%;
            height: 38%;
        }
        .form
        {
             width: 95%;
            height:13%;
            margin-bottom: 10px;
        }
        .content
        {
            height: 800px;
            
        }
        .resourceinfo
        {
             height: 760px;
             width: 100%;
            overflow: auto;
        }
        .form .form-row .lbl-field
        {
            width:100%;
        }
        
    </style>
    <script src="~/scripts/Plugin/highchart/highcharts.js" type="text/javascript"></script>
    <script src="~/scripts/Plugin/highchart/exporting.js" type="text/javascript"></script>
    <script src="~/scripts/lib/jquery.signalR-0.5.3.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/signalr/hubs"></script>
    <script type="text/javascript">

        var ServerDetail = function ($) {
            return {
                Server: null,
                FirstTime: true,
                MaxMemory: 0,
                UpdateServerData: function (resourceInfo) {
                    if (ServerDetail.Server.ServerIp == resourceInfo.ServerIp) {
                        ServerDetail.Server = resourceInfo;
                    }
                },
                GetDataFromServerName: function (type) {
                    if (type == 1) {
                        return ServerDetail.Server.SqlCpuPercent;
                    }
                    else {
                        return ServerDetail.Server.MemoryUsage;
                    }
                },
                RenderChart: function (charid, type, title, ytitle, pointTitle) {
                    var pointColor = (type == 1 ? '#4572A7' : '#CCBB66');
                    return new Highcharts.Chart({
                        name: charid + type,
                        chart: {
                            renderTo: charid,
                            type: 'spline',
                            marginRight: 25,
                            events: {
                                load: function () {

                                    // set up the updating of the chart each second
                                    var series = this.series[0];
                                    setInterval(function () {
                                        var x = (new Date()).getTime() // current time
                                        y = ServerDetail.GetDataFromServerName(type); 
                                        if (type != 1) {
                                            y = Math.round(y * 100 / ServerDetail.Server.TotalMemory)
                                        }
                                        series.addPoint([x, y], true, true);
                                    }, 4000);
                                }
                            }
                        },
                        title: {
                            text: title
                        },
                        xAxis: {
                            type: 'datetime',
                            tickPixelInterval: 100
                        },
                        yAxis: {
                            title: {
                                text: ytitle
                            },
                            plotLines: [{
                                value: 0,
                                width: 1,
                                color: '#8011111'
                            }],
                            min: 0,
                            max: 100
                        },
                        tooltip: {
                            formatter: function () {
                                return '<b>' + this.series.name + '</b><br/>' +
                                Highcharts.dateFormat('%Y-%m-%d %H:%M:%S', this.x) + '<br/>' +
                                Highcharts.numberFormat(this.y, 2);
                            }
                        },
                        legend: {
                            enabled: false
                        },
                        exporting: {
                            enabled: false
                        },
                        series: [{
                            name: pointTitle,
                            color: pointColor,
                            data: (function () {
                                // generate an array of random data
                                var data = [],
                                time = (new Date()).getTime(),
                                i;
                                var yValue = ServerDetail.GetDataFromServerName(type);
                                if (type != 1) {
                                    yValue = Math.round(yValue * 100 / ServerDetail.Server.TotalMemory)
                                }
                                for (i = -10; i <= 0; i++) {
                                    data.push({
                                        x: time + i * 4000,
                                        y: yValue
                                    });
                                }
                                return data;
                            })()
                        }]
                    });
                }
            };
        } (jQuery);

        // Proxy created on the fly
        var serverInfoHub = $.connection.serverInfoHub;

        // Declare a function on the chat hub so the server can invoke it
        serverInfoHub.addMessage = function (message) {
            alert(message);
        };

        serverInfoHub.firstMessage = function (resourceInfoes) {
            $('#information').empty()
            for (var i = 0; i < resourceInfoes.length; i++) {
                if (resourceInfoes[i].ServerIp == serverIp) {
                    ServerDetail.Server = resourceInfoes[i];
                    var sqlCpuChart = ServerDetail.RenderChart("slqCpuContainer", 1, "Sql Server Cpu", "%", "Cpu Usage");
                    var memoryChart = ServerDetail.RenderChart("memoryContainer", 2, "Sql Server Memory Usage", "%", "Memory Usage");
                    break;
                }
            }
            ServerDetail.FirstTime = false;
            NAP.loadingBox.close();
        };

        serverInfoHub.gotMessage = function (resourceInfo) {
            if (!ServerDetail.FirstTime) {
                ServerDetail.UpdateServerData(resourceInfo);
            }
        };
        var serverIp = '@ViewBag.ServerIp';
    </script>
}
@section HeaderBar {
    <article class="breadcrumbs">
        <a href="index.html"></a>
        <div class="breadcrumb_divider">
        </div>
        <a class="current">Server Detail</a></article>
}
<section class="column" id="main">
    <div class="content">
        <div class="resourceinfo">
         <div class="form">
            <div class="form-row required">
                <div class="lbl-field">
                   Server @ViewBag.ServerIp
                </div>
             @*   <div class="edit-field">
                    <label>@ViewBag.ServerIp</label>
                </div>*@
            </div>
            <div class="form-row required">
                <div class="lbl-field">
                    Cpu: @serverFullInfo.NumberPhysicalCpu Cpu(s) Physical, @serverFullInfo.NumberLogicalCpu Cpu(s) Logical
                </div>
               @* <div class="edit-field">
                    <label></label>
                </div>*@
            </div>
            <div class="form-row required">
                <div class="lbl-field">
                    Memory: @(Math.Round((double)serverFullInfo.TotalPhysicalMemory / 1024)) GB
                </div>
               @* <div class="edit-field">
                    <label>@serverFullInfo.TotalPhysicalMemory GB</label>
                </div>*@
            </div>
        </div>
        
            <div id="slqCpuContainer">
            </div>
            <div id="memoryContainer">
            </div>
        </div>
        
    </div>
</section>
@section Foot {
    <script type="text/javascript">
        $(function () {
            NAP.loadingBox.show();
            Highcharts.setOptions({
                global: {
                    useUTC: false
                }
            });

            $.connection.hub.start(function () {
                serverInfoHub.getListServerInfoFirstTime();
            });
        });
    </script>
}
