@model Fanex.Maintenance.Criteria.Job.GetSqlServerLogCriteria
@{
    ViewBag.Title = ViewResource.SqlAgentLog;
    Layout = "~/Views/Shared/_SqlJobManagementLayout.cshtml";
    var sqlServerLogs = ViewBag.SqlServerLogs != null ? (IEnumerable<SqlServerLog>)ViewBag.SqlServerLogs : new List<SqlServerLog>();
}
@section Head {
    <link href="~/themes/job/job/manage.less" rel="stylesheet" type="text/css" />
    <style type="text/css">
        #filter-bar .filter-form .lbl-field
        {
            width: 50px;
        }
        .module
        {
            margin-top: 90px;
        }
        #filter-bar
        {
            margin-bottom: 5px;
            margin-left: -12px;
        }
        /*
         .marginfilter
        {
            margin-left: 15px;
            margin-right: 15px;
        }
         .firstmarginfilter
        {
            margin-right: 15px;
        }
        */
        .filter-form
        {
            margin-top: 15px;
        }
        
        img.ui-datepicker-trigger, img.tempcalendarimg
        {
            margin-top: -1px;
        }
    </style>
}
@section HeaderBar {
    <article class="breadcrumbs">
        <a href="index.html">@Model.Server</a>
        <div class="breadcrumb_divider">
        </div>
        <a class="current">@ViewResource.SqlAgentLog</a></article>
}
<section class="column" id="main">
    <div class="content">
        @using (Html.BeginForm())
        { 
            <section id="filter-bar">
                <div class="filter-form firstmarginfilter">
                    <div class="lbl-field ">
                        @Html.LabelFor(m => m.Server)
                    </div>
                    <div class="edit-field ">
                        @Html.DropDownListFor(m => m.Server, (List<SelectListItem>)ViewBag.ListServer, "All")
                    </div>
                </div>
                <div class="filter-form marginfilter">
                    <div class="lbl-field ">
                        @ViewResource.Status
                    </div>
                    <div class="edit-field ">
                        @Html.DropDownListFor(m => m.ErrorLevel,
                    new List<SelectListItem> { 
                        new SelectListItem{ Text=ViewResource.Error,Value=((int)ErrorType.Error).ToString()}, 
                        new SelectListItem{ Text=ViewResource.Warning,Value=((int)ErrorType.Warning).ToString()},   
                        new SelectListItem{ Text=ViewResource.Information,Value=((int)ErrorType.Infomation).ToString()}                      
                    }
                , "All")
                    </div>
                </div>
                <div class="filter-form marginfilter">
                    <div class="lbl-field">
                        @Html.LabelFor(m => m.From)
                    </div>
                    <div class="edit-field" style="position: relative;">
                        @Html.TextBoxFor(m => m.From)
                    </div>
                </div>
                <div class="filter-form marginfilter">
                    <div class="lbl-field">
                        @Html.LabelFor(m => m.To)
                    </div>
                    <div class="edit-field" style="position: relative;">
                        @Html.TextBoxFor(m => m.To)
                    </div>
                </div>
                @Html.HiddenFor(m => m.PageIndex)
                @Html.HiddenFor(m => m.PageSize)
                <div class="filter-form" style="margin-left: 50px;">
                    <div class="submit">
                        <input id="submitbutton" onclick="SqlServerLogManagement.UpdatePaging();" type="submit"
                            value="Submit" />
                    </div>
                </div>
            </section>
        }
        <article class="module width_full">
            <div class="pagesize">
                Page size :
                @Html.DropDownList("size", (List<SelectListItem>)ViewBag.PageSize, new { id = "PageSizeSelect", onChange = "SqlServerLogManagement.OnChangePageSize();" })
            </div>
            <table class="tablesorter" id="dataTable" style="width: 99%">
                <thead>
                    <tr>
                        <th class="width-30">
                            #
                        </th>
                        <th class="width-100">
                            @ViewResource.Server
                        </th>
                        <th>
                            @ViewResource.Status
                        </th>
                        <th class="width-140">
                            @ViewResource.Date
                        </th>
                        <th>
                            @ViewResource.Message
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int i = (int)Model.PageIndex * (int)Model.PageSize;
                        foreach (var sqlServerLog in sqlServerLogs)
                        {
                            string rowCss = i % 2 == 0 ? string.Empty : "class=\"alt\"";
                            i++;
                        <tr @Html.Raw(rowCss)>
                            <td class="align-center">
                                @(i)
                            </td>
                            <td class="align-center">
                                @sqlServerLog.ServerIp
                            </td>
                            <td class="align-center">
                                @switch (sqlServerLog.ErrorLevel)
                                {
                                    case (int)ErrorType.Error:
                                    <img src="~/themes/job/img/error.png" />
                                        break;
                                    case (int)ErrorType.Warning:
                                    <img src="~/themes/job/img/warning.png" />
                                        break;
                                    case (int)ErrorType.Infomation:
                                    <img src="~/themes/job/img/tick.png" /> 
                                        break;
                                }
                            </td>
                            <td class="align-center">
                                @sqlServerLog.LogDate.ToFullDateString()
                            </td>
                            <td style="padding-left: 3px">
                                @sqlServerLog.LogMessage
                            </td>
                        </tr>
                        }
                        if (sqlServerLogs.Count() == 0)
                        {
                        <tr>
                            <td class="align-center" colspan="10">
                                @ViewResource.NoInformationAvailable
                            </td>
                        </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    @if (Model.PageIndex == 0 && sqlServerLogs.Count() == 0)
                    {
                    }
                    else
                    {
                        <tr>
                            <td class="align-right tdpaging" colspan="10">
                                <div class="pagingcontainer">
                                    <a href="#" class="pagiPre pagingitem" onclick="SqlServerLogManagement.OnNextPage(-1);">
                                    ← Prev</a> <a href="#" class="pagiNext pagingitem" onclick="SqlServerLogManagement.OnNextPage(1);">
                                       Next →</a>
                                </div>
                                
                            </td>
                        </tr>
                    }
                </tfoot>
            </table>
        </article>
    </div>
</section>
<input type="hidden" id="countData" value="@(sqlServerLogs.Count())" />
@Html.Hidden("dateFrom", (string)ViewBag.DateFrom)
@Html.Hidden("dateTo", (string)ViewBag.DateTo)
@Html.Hidden("imagePath", (string)@Url.Content("~/images/calendar.gif"))
@Html.Hidden("top", (string)ViewBag.Top.ToString())
@section Foot {
    <script src="~/scripts/Job/SqlServerLogManagement.js" type="text/javascript"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            var top = $('#top').val();
            if (top == 1) {

            }
        });
    </script>
}
