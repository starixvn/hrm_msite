@model Fanex.Maintenance.Criteria.Job.GetSqlServerLogCriteria
@{
    ViewBag.Title = "Sql Server Log Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sqlServerLogs = ViewBag.SqlServerLogs != null ? (IEnumerable<SqlServerLog>)ViewBag.SqlServerLogs : new List<SqlServerLog>();
}
@section Head {
    <link href="~/themes/job/job/manage.less" rel="stylesheet" type="text/css" />
}
<section id="secondary_bar">
		<div class="user">
			<p>SQL Job Management</p>
			<!-- <a class="logout_user" href="#" title="Logout">Logout</a> -->
		</div>
		<div class="breadcrumbs_container">
			<article class="breadcrumbs"><a href="index.html">Website Admin</a> <div class="breadcrumb_divider"></div> <a class="current">Dashboard</a></article>
		</div>

</section>
@Html.Action("LeftMenuPage", "JobManagement")
<section class="column" id="main">
			<div class="content">
@using (Html.BeginForm())
{ 
    <section id="filter-bar">      
		<div class="filter-form">	
            <div class="lbl-field width-auto">
			    @Html.LabelFor(m => m.Server)
		    </div>   
            <div class="edit-field width-auto">	
                @Html.DropDownListFor(m => m.Server, (List<SelectListItem>)ViewBag.ListServer, "All")			                
            </div>
        </div>        
        <div class="filter-form">	
            <div class="lbl-field width-auto">
			    @Html.LabelFor(m => m.From)
		    </div>   
            <div class="edit-field width-auto">	
                @Html.TextBoxFor(m => m.From)                
            </div>
        </div>  
         <div class="filter-form">	
            <div class="lbl-field width-auto">
			    @Html.LabelFor(m => m.To)
		    </div>   
            <div class="edit-field width-auto">	
                @Html.TextBoxFor(m => m.To)                
            </div>
        </div>     
        @Html.HiddenFor(m => m.PageIndex)
        @Html.HiddenFor(m => m.PageSize)
        <div class="filter-form">	             
            <div class="submit">
		        <input id="submitbutton" type="submit" value="Submit" /> 
            </div>    
        </div>             	       		   
    </section>
}
 
        
<article class="module width_full">
<div class="pagesize">
        Page Size :
        @Html.DropDownList("size", (List<SelectListItem>)ViewBag.PageSize, new { id = "PageSizeSelect", onChange = "SqlServerLogManagement.OnChangePageSize();" })
    </div>
<table class="tablesorter">
    <thead>
        <tr>
            <th>
                #
            </th>
             <th>
                @ViewResource.Server
            </th>
            <th>
                @ViewResource.Date
            </th>
            <th>
                @ViewResource.Message
            </th>
           
        </tr>
    </thead>
    <tbody>
        @{
            int i = (int)Model.PageIndex * (int)Model.PageSize;
            foreach (var sqlServerLog in sqlServerLogs)
            {
                string rowCss = i % 2 == 0 ? string.Empty : "class=\"alt\"";
                i++;
            <tr @Html.Raw(rowCss)>
                <td class="align-center">
                    @(i)
                </td>
                 <td class="align-center">
                    @sqlServerLog.ServerIp
                </td>
                <td class="align-center" style="width: 110px;">
                    @sqlServerLog.LogDate.ToFullDateString()
                </td>
                <td>
                    @sqlServerLog.LogMessage
                </td>
               
            </tr>
            }
            if (sqlServerLogs.Count() == 0)
            {
                <tr>
                    <td class="align-center" colspan="10">
                    @ViewResource.NoInformationAvailable
                    </td>
                </tr>
            }
        }

    </tbody>
      <tfoot>
  
                <tr>
                    <td class="align-center" colspan="10">
                        <a href="#" class="pagiPre" style="margin-right: 50px;" onclick="SqlServerLogManagement.OnNextPage(-1);" ><< Pre</a> 
                        <a href="#" class="pagiNext" onclick="SqlServerLogManagement.OnNextPage(1);">Next >></a>
                    </td>
                </tr>
   
        </tfoot>
</table>
</article>
</div>
</div>
@Html.Hidden("dateFrom", (string)ViewBag.DateFrom)
@Html.Hidden("dateTo", (string)ViewBag.DateTo)
@Html.Hidden("imagePath", (string)@Url.Content("~/images/calendar.gif"))
@section Foot {
     <script src="~/scripts/Job/SqlServerLogManagement.js" type="text/javascript"></script>
}
