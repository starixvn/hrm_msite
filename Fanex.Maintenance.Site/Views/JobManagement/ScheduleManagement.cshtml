@using Fanex.Maintenance.Criteria.Job
@using Fanex.Maintenance.Entity.Domain
@model GetAllScheduleCriteria
@{
    ViewBag.Title = "Schedule Management";
    Layout = "~/Views/Shared/_SqlJobManagementLayout.cshtml";
    var schedules = ViewBag.ListSchedule != null ? (IEnumerable<ScheduleDetail>)ViewBag.ListSchedule : new List<ScheduleDetail>();
    
}
@section Head {
    <link href="~/themes/job/job/manage.less" rel="stylesheet" type="text/css" />
}
<section id="secondary_bar">	
		<div class="breadcrumbs_container">
			<article class="breadcrumbs">
            <a href="index.html">@Model.Server</a>
             <div class="breadcrumb_divider"></div>
              <a class="current">@ViewResource.ScheduleManagement</a>
              </article>
		</div>

</section>
<section class="column" id="main">	
		<div class="content">
@using (Html.BeginForm())
{ 
    <section id="filter-bar">    
        <div class="filter-form">	
                <div class="lbl-field">
			        @Html.LabelFor(m => m.Server)
		        </div>   
                <div class="edit-field">	
                    @Html.DropDownListFor(m => m.Server, (List<SelectListItem>)ViewBag.ListServer, "All")			                
                </div>
        </div>   
         <div class="filter-form">	
            <div class="lbl-field">
			    @ViewResource.ScheduleName
		    </div>   
            <div class="edit-field width-auto">	
                @Html.TextBoxFor(m => m.Schedule_Name)                
            </div>
        </div>     		     
        <div class="filter-form">	                              
            <div class="lbl-field ">
			    @Html.LabelFor(m => m.FreqType)
		    </div>
            <div class="edit-field">				                
                @Html.DropDownListFor(m => m.FreqType,
                    new List<SelectListItem> { 
                        new SelectListItem{ Text=ViewResource.OneTime,Value=((int)FrequentTime.OneTimeOnly).ToString()},                        
                        new SelectListItem{ Text=ViewResource.Daily,Value=((int)FrequentTime.Daily).ToString()},                        
                        new SelectListItem{ Text=ViewResource.Weekly,Value=((int)FrequentTime.Weekly).ToString()},                        
                        new SelectListItem{ Text=ViewResource.Monthly,Value=((int)FrequentTime.Monthly).ToString()},                        
                        new SelectListItem{ Text=ViewResource.MonthlyRelative,Value=((int)FrequentTime.MonlyRelative).ToString()},                        
                        new SelectListItem{ Text=ViewResource.SqlAgentStarts,Value=((int)FrequentTime.SqlAgentStart).ToString()},                        
                        new SelectListItem{ Text=ViewResource.ComputerIdle,Value=((int)FrequentTime.ComputerIdle).ToString()}
                    }
                , "All")
		    </div>			  
        </div> 
          <div class="filter-form">	                              
            <div class="lbl-field ">
			    @Html.LabelFor(m => m.FreqSubType)
		    </div>
            <div class="edit-field">				                
                @Html.DropDownListFor(m => m.FreqSubType,
                    new List<SelectListItem> { 
                        new SelectListItem{ Text=ViewResource.SpecifedTime,Value=((int)FrequentSubTime.SpecificTime).ToString()}, 
                        new SelectListItem{ Text=ViewResource.Seconds,Value=((int)FrequentSubTime.Seconds).ToString()}, 
                        new SelectListItem{ Text=ViewResource.Minutes,Value=((int)FrequentSubTime.Minutes).ToString()}, 
                        new SelectListItem{ Text=ViewResource.Hours,Value=((int)FrequentSubTime.Hours).ToString()}                       
                    }
                , "All")
		    </div>			  
        </div> 
        <div class="filter-form">	
            <div class="lbl-field ">
			    @ViewResource.Date_Type
		    </div>
            <div class="edit-field">				                
                @Html.DropDownListFor(m => m.SearchDateType,
                    new List<SelectListItem> { 
                        new SelectListItem{ Text=ViewResource.ActiveStartDate,Value=((int)SearchDate.StartDate).ToString()},
                        new SelectListItem{ Text=ViewResource.ActiveEndDate,Value=((int)SearchDate.EndDate).ToString()}
                    }
                , "All")
		    </div>					    
        </div>  
        <div class="filter-form">	
            <div class="lbl-field">
			    @Html.LabelFor(m => m.From)
		    </div>   
            <div class="edit-field width-auto">	
                @Html.TextBoxFor(m => m.From)                
            </div>
        </div>  
         <div class="filter-form">	
            <div class="lbl-field">
			    @Html.LabelFor(m => m.To)
		    </div>   
            <div class="edit-field width-auto">	
                @Html.TextBoxFor(m => m.To)                
            </div>
        </div>     
        <div class="filter-form">
        <div class="lbl-field"> </div>	   
            <div class="submit">
		        <input id="submitbutton" type="submit" value="Submit" /> 
            </div>    
        </div>             	       		   
    </section>
}
<article class="module width_full" style="overflow: auto;">
<table class="tablesorter">
    <thead>
        <tr>
            <th>
                #
            </th>
             <th>
                @ViewResource.Server
            </th>
            <th class="width-140">
                @ViewResource.ScheduleName
            </th>
            <th class="width-200">
                @ViewResource.ScheduleFreq
            </th>
            <th class="width-200">
                @ViewResource.ScheduleFreqSub
            </th>
            <th>
                @ViewResource.ScheduleAcStartDate
            </th>
            <th>
                @ViewResource.ScheduleAcEndDate
            </th>
            <th>
                @ViewResource.Job
            </th>
            <th>
                @ViewResource.Enabled
            </th>
           
            <th>
                @ViewResource.Edit
            </th>
        </tr>
    </thead>
    <tbody class="align-center">
        @{
            int i = 0;
            foreach (var schedule in schedules)
            {
                string rowCss = i % 2 == 0 ? string.Empty : "class=\"alt\"";
                i++;
            <tr @Html.Raw(rowCss)>
                <td class="align-center">
                    @(i)
                </td>
                 <td>
                    @schedule.ServerIp
                </td>
                <td class="width-140">
                    @schedule.Name
                </td>
                <td class="width-180">
                    @schedule.FreqIntervalCombine
                </td>
                <td class="width-180">
                    @schedule.FreqSubIntervalCombine
                </td>
                <td class="width-120">
                    @schedule.ActiveStartDate.ToFullDateWithTimeAdded(schedule.ActiveStartTime)
                </td>
                <td class="width-100">
                    @if (schedule.ActiveEndDate.Equals(DateTime.MaxValue))
                    {
                        @ViewResource.N_A
                    }
                    else
                    {
                        @schedule.ActiveEndDate.ToDateString()                    
                    }                    
                </td>
                <td>
                    @Html.ActionLink(schedule.JobCount.ToString(), "JobManagement", "JobManagement",
                        new
                        {
                            server = schedule.ServerIp,
                            schedule = schedule.Name
                        }, null)
                </td>
                <td>
                 @if (schedule.Enable == 1)
                 {
                        <img src="~/themes/job/img/blank.png" alt="" class="ico-tick" />
                 }
                </td>
               
                <td>
                <div class="action-wrp">
                    <a href="#" class="btn-edit">Action</a>
                    </div>
                </td>
            </tr>
            }
            if (i.Equals(0))
            {
                <tr>
                    <td class="align-center" colspan="10">
                    @ViewResource.NoInformationAvailable
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
</article>
</div>
</section>
@Html.Hidden("dateFrom", (string)ViewBag.DateFrom)
@Html.Hidden("dateTo", (string)ViewBag.DateTo)
@Html.Hidden("imagePath", (string)@Url.Content("~/images/calendar.gif"))
@section Foot {
    <script src="~/scripts/Job/ScheduleManagement.js" type="text/javascript"></script>
}
