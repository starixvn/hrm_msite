@using Fanex.Maintenance.Criteria.Job
@model GetListJobCriteria
@{
    ViewBag.Title = ViewResource.JobManagement;
    Layout = "~/Views/Shared/_SqlJobManagementLayout.cshtml";
    var lisJob = ViewBag.ListJob != null ? (List<JobSchedule>)ViewBag.ListJob : new List<JobSchedule>();
}
@section Head {
    <link href="~/themes/job/job/jobmanage.less" rel="stylesheet" type="text/css" />
    <script src="~/scripts/lib/jsrender.js" type="text/javascript"></script>
    <script type="text/x-jsrender" id="templateSchedule">
        <option value="{{:Id}}">{{:Name}}</option>
    </script>
}
@section HeaderBar {
    <article class="breadcrumbs">
        <a href="#">@Model.Server</a>
        <div class="breadcrumb_divider">
        </div>
        <a class="current">@ViewResource.JobManagement</a>
    </article>
}
<section class="column" id="main">
    <div class="content">
        @using (Html.BeginForm())
        { 
            <section id="filter-bar">
                <div class="filter-form">
                    <div class="lbl-field">
                        @Html.LabelFor(m => m.Job_Name)
                    </div>
                    <div class="edit-field">
                        @Html.TextBoxFor(m => m.Job_Name)
                    </div>
                </div>
                <div class="filter-form">
                    <div class="lbl-field">
                        @Html.LabelFor(m => m.Server)
                    </div>
                    <div class="edit-field">
                        @Html.DropDownListFor(m => m.Server
                    , (List<SelectListItem>)ViewBag.ListServer
                    , "All"
                    , new { @class = "chosen" })
                    </div>
                </div>
                <div class="filter-form">
                    <div class="lbl-field">
                        @Html.LabelFor(m => m.ScheduleId)
                    </div>
                    <div class="edit-field">
                        @Html.DropDownListFor(m => m.ScheduleId
                , (List<SelectListItem>)ViewBag.ListSchedule
                , "All"
                , new { @class = "chosen" })
                    </div>
                </div>
                <div class="filter-form">
                    <div class="lbl-field">
                        <label for="Execution_Status">
                            Exec Status</label>
                    </div>
                    <div class="edit-field">
                        @Html.DropDownListFor(m => m.Execution_Status,
                    new List<SelectListItem> { 
                        new SelectListItem{ Text=ViewResource.Obsolete,Value=((int)ExecutionStatus.Obsolete).ToString()},                        
                        new SelectListItem{ Text=ViewResource.Executing,Value=((int)ExecutionStatus.Executing).ToString()},                        
                        new SelectListItem{ Text=ViewResource.Waiting_For_Thread,Value=((int)ExecutionStatus.WaitingFoThread).ToString()},                        
                        new SelectListItem{ Text=ViewResource.Between_Retries,Value=((int)ExecutionStatus.BetweenRtries).ToString()},                        
                        new SelectListItem{ Text=ViewResource.Idle,Value=((int)ExecutionStatus.Idle).ToString()},                        
                        new SelectListItem{ Text=ViewResource.Suspended,Value=((int)ExecutionStatus.Suspended).ToString()},                        
                        new SelectListItem{ Text=ViewResource.Performing_Completion_Actions,Value=((int)ExecutionStatus.PerformingCompletionActions).ToString()}
                    }
                , "All")
                    </div>
                </div>
                <div class="filter-form">
                    <div class="lbl-field">
                        @Html.LabelFor(m => m.Enabled)
                    </div>
                    <div class="edit-field">
                        @Html.DropDownListFor(m => m.Enabled,
                    new List<SelectListItem> { 
                        new SelectListItem{ Text=ViewResource.Enabled,Value=((int)Status.Enabled).ToString()},
                        new SelectListItem{ Text=ViewResource.Disabled,Value=((int)Status.Disabled).ToString()}
                    }
                , "All")
                    </div>
                </div>
                <div class="filter-form">
                    <div class="lbl-field">
                    </div>
                    <div class="submit">
                        <input type="submit" value="Submit" />
                    </div>
                </div>
            </section>
        }
        <article class="module width_full">
            <table class="tablesorter" id="dataTable" style="width: 99%">
                <thead>
                    <tr>
                        <th class="align-center width-30">
                            #
                        </th>
                        <th>
                            @ViewResource.Job
                        </th>
                        <th class="width-100">
                            @ViewResource.Server
                        </th>
                        <th>
                            @ViewResource.Executing
                        </th>
                        <th class="width-140">
                            @ViewResource.Last_Run_Date
                        </th>
                        <th class="width-140">
                            @ViewResource.Next_Run_Date
                        </th>
                        <th>
                            @ViewResource.Enabled
                        </th>
                        <th>
                            @ViewResource.Action
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int i = 0;
                        foreach (var item in lisJob)
                        {
                            string rowCss = i % 2 == 0 ? string.Empty : "class=\"alt\"";
                            string trId = item.ServerIp.Replace('.', '_') + "_" + item.Job.Name.Replace('.', '_');
                            string startJobId = "startJob_" + trId;
                            string stopJobId = "stopJob_" + trId;


                            i++;
                        <tr @Html.Raw(rowCss) id="@trId">
                            <td class="align-center">
                                @(i)
                            </td>
                            <td style="padding-left: 3px">
                                @item.Job.Name
                            </td>
                            <td class="align-center">
                                @item.ServerIp
                            </td>
                            <td class="align-center executestatus">
                                @item.ExecuteStatus.ToExecutionString()
                            </td>
                            <td class="align-center lastrundate">
                                @if (item.LastRunDate != 0)
                                {
                                    @Html.Raw(item.LastRunDate.ToFullDateString(item.LastRunTime))
                                }
                                else
                                {
                                    @ViewResource.N_A
                                }
                            </td>
                            <td class="align-center nextrundate">
                                @if (item.NextRunDate != 0)
                                {
                                    @Html.Raw(item.NextRunDate.ToFullDateString(item.NextRunTime))
                                }
                                else
                                {
                                    @ViewResource.N_A
                                }
                            </td>
                            <td class="align-center">
                                @if (item.Job.Enable == 1)
                                {
                                    <img src="~/themes/job/img/blank.png" alt="" class="ico-tick" />
                                }
                            </td>
                            <td class="align-center">
                                <div class="action-wrp">
                                    <span class="btn-action">Action</span>
                                    <div class="relative">
                                        <ul class="actions" style="visibility: hidden; opacity: 0;">
                                            <li>@Html.ActionLink("View log " + item.Job.Name, "JobLogManagement"
                                        , new { job = item.Job.Name, server = item.ServerIp }
                         , new { @class = "dd-viewlog" })</li>
                                            <li>@Html.ActionLink("View step " + item.Job.Name, "StepManagement"
                                        , new { job = item.Job.Name, server = item.ServerIp }
                                        , new { @class = "dd-step" })
                                            </li>
                                            <li><a href="#" class="dd-play @startJobId" onclick="JobManagementPage.StartJob('@item.ServerIp','@item.Job.Name');">
                                                Start Job</a></li>
                                            <li><a href="#" class="dd-stop @stopJobId" onclick="JobManagementPage.StopJob('@item.ServerIp','@item.Job.Name');">
                                                Stop Job</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        }
                        if (i.Equals(0))
                        {
                        <tr>
                            <td class="align-center" colspan="10">
                                @ViewResource.NoInformationAvailable
                            </td>
                        </tr>
                        }
                    }
                </tbody>
            </table>
        </article>
    </div>
</section>
@section Foot {
    <script src="~/scripts/Job/JobManagementPage.js" type="text/javascript"></script>
}
