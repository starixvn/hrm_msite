@{
    ViewBag.Title = "User Online Chart";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head{
  <link href="~/themes/job/user/manage.less" rel="stylesheet" type="text/css"></link>
    <script src="~/scripts/DatabaseReport/RefreshTime.js" type="text/javascript"></script>
    <script src="~/scripts/lib/jscharts.js" type="text/javascript"></script>
    <script src="~/scripts/DatabaseReport/Chart.js" type="text/javascript"></script>
    <script src="~/scripts/lib/Common.js" type="text/javascript"></script>
    <script type="text/javascript">
        window.onload = function () {
            setInterval("CountDown(false)", 1000);
        };
    </script>
}
@section Headline {
    <h1>
        <span class="title">@ViewBag.Title</span>
    </h1>
}
<div>
    <div class="pagesize">
        Show:
        <select id="pageSize" onchange="ShowChart();">
            <option value="10">10</option>
            <option value="20">20</option>
            <option value="30" selected="selected">30</option>
            <option value="40">40</option>
            <option value="50">50</option>
        </select>
        <div id="refreshtime" onclick="ShowTime(true);">
        </div>
        <div id="optime" style="float: right; display: none;">
            <select id="seltime" onchange="ShowTime(false);">
                <option value="60">1 mins</option>
                <option value="300">5 mins</option>
                <option value="600">10 mins</option>
                <option value="900">15 mins</option>
                <option value="1200">20 mins</option>
                <option value="1500">30 mins</option>
            </select>
        </div>
        <div id="dvtime" onclick="RefreshChart();" style="cursor: pointer;">
            10:59</div>
    </div>
</div>
<div class="header_01">
    <span style="width: 500px; text-align: center;">
        <input id="chksuper" type="checkbox" checked="checked" onchange="ShowChart();" />
        <span style="color: #EC7A00">Super</span>
        <input id="chkmaster" type="checkbox" checked="checked" onchange="ShowChart();" />
        <span style="color: #FCD200">Master</span>
        <input id="chkagent" type="checkbox" checked="checked" onchange="ShowChart();" />
        <span style="color: #81C714">Agent</span>
        <input id="chkaccounting" type="checkbox" checked="checked" onchange="ShowChart();" />
        <span style="color: #60B6F0">Accounting</span>
        <input checked id="chkaffiliate" type="checkbox" onchange="ShowChart();" />
        <span style="color: #9CCEF0">Affiliate</span> </span>
</div>
<hr />
<div id="dvChart">
    Data not available !
</div>
