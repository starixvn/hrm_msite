@{
    ViewBag.Title = "UserOnlineDaily";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head
{
   <link href="~/themes/job/user/manage.less" rel="stylesheet" type="text/css"></link>
}
@section Headline {
    <h1>
        <span class="title">@ViewBag.Title</span>
    </h1>
}
@using (Html.BeginForm())
{ 
    <section id="filter-bar">  
			<div class="filter-form">	                       
            <div class="lbl-field width-auto">
				@Html.Label("Date")
			</div>
            <div class="edit-field">				                
                @Html.TextBox("Date", (string)ViewBag.DateNow, new { @style = "width:90px;margin-right:5px;" })
			</div>					                                              
            <div class="submit">
					<input type="submit" value="Submit" />                  
		    </div>                                           
			</div>            
       
    </section>      
}
<table class="grid">
    <tr>
        <th rowspan="2">
            Time Range
        </th>
        <th rowspan="2">
            Local Time Range
        </th>
        <th colspan="3">
            Agency
        </th>
        <th colspan="3">
            Wap
        </th>
        <th rowspan="2">
            Accounting
        </th>
        <th rowspan="2">
            Affiliate
        </th>
        <th rowspan="2">
            Affiliate Admin
        </th>
    </tr>
    <tr>
        <th>
            Super
        </th>
        <th>
            Master
        </th>
        <th>
            Agent
        </th>
        <th>
            Super
        </th>
        <th>
            Master
        </th>
        <th>
            Agent
        </th>
    </tr>
    @Html.Raw(ViewBag.UserDailyData)
</table>
@section Foot {
    <script type="text/javascript">

        $(function () {

            $("#Date").datepicker({
                showOn: "button",
                buttonImage: location.protocol + "//" + location.host + "/images/calendar.gif",
                buttonImageOnly: true,
                dateFormat: "dd/mm/yy"
            });

        });        
    </script>
}
