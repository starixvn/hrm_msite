<h2>My timesheet</h2>
<form action="/report/timesheet" method="get">    <div class="container_24">
        <div class="grid_1 gridlabel">
            Month
        </div>
        <div class="grid_4">            
            <input id="Year" name="Year" value="2012" type="hidden">
            <input id="Month" name="Month" value="10" type="hidden">
            <input data-val="true" data-val-number="The field Emp must be a number." id="EmpId" name="EmpId" value="212" type="hidden">
        </div>
        <div class="grid_3 gridlabel">
            <label for="Type">Request type</label>
        </div>
        <div class="grid_4 pull_1">

            <select data-val="true" data-val-number="The field Request type must be a number." data-val-required="The Request type field is required." id="Type" name="Type"><option selected="selected" value="0">All</option>
<option value="1">Checkin</option>
<option value="2">Checkout</option>
<option value="3">Late in</option>
<option value="4">Early out</option>
<option value="5">Not working</option>
</select>
            <span class="field-validation-valid" data-valmsg-for="Type" data-valmsg-replace="true"></span>
        </div>
        <div class="grid_3 pull_1">
            <input class="" origin-value="Submit" id="view" value="Submit" name="View" type="submit">
        </div>
        <div class="clear"></div>
    </div>
</form><div class="clear"></div>   

