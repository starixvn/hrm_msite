                    <div class="js-menu separator-menu">                            
                    </div>
                </div>
        </section>
    <section id="headline">
            <h1>
                <span class="title">Job Management</span>                
                <a href="/SqlJobManagement/JobManagement" class="lnk">+ Create Job</a>
            </h1>
    	</section>
    <section id="body">
		<div class="content">			
    <form>    
<section id="filter-bar">    
         <div class="filter-form">	
            <div class="lbl-field">
			    <label for="Job_Name">Job</label>
		    </div>   
            <div class="edit-field width-auto">	
                <input type="text" value="" name="Job_Name" id="Job_Name">                
            </div>
        </div>     
		<div class="filter-form">	
            <div class="lbl-field">
			    <label for="Server">Server</label>
		    </div>   
            <div class="edit-field">	
                <select name="Server" id="Server"><option value="">All</option>
<option value="CP0069-RICKY">10.19.10.12</option>
<option value="CP00003-EDWARD">10.19.10.71</option>
</select>			                
            </div>
        </div>        
        <div class="filter-form">	
            <div class="lbl-field ">
			    <label for="Enabled">Status</label>
		    </div>
            <div class="edit-field">				                
                <select name="Enabled" id="Enabled" data-val-number="The field Status must be a number." data-val="true"><option value="">All</option>
<option value="1">Enabled</option>
<option value="0">Disabled</option>
</select>
		    </div>					    
        </div> 
        <div class="filter-form">	                              
             <div class="lbl-field ">
			    <label for="Execution_Status">Execution Status</label>
		    </div>
            <div class="edit-field">				                
                <select name="Execution_Status" id="Execution_Status" data-val-number="The field Execution Status must be a number." data-val="true"><option value="">All</option>
<option value="0">Obsolete</option>
<option value="1">Executing</option>
<option value="2">Waiting for thread</option>
<option value="3">Between retries</option>
<option value="4">Idle</option>
<option value="5">Suspended</option>
<option value="6">Performing completion actions</option>
</select>
		    </div>			  
        </div> 
        <div class="filter-form">	
            <div class="lbl-field ">
			    <label for="DateType">Date Type</label>
		    </div>
            <div class="edit-field">				                
                <select name="DateType" id="DateType" data-val-number="The field Date Type must be a number." data-val="true"><option value="">All</option>
<option value="0">Last Run Date</option>
<option value="1">Next Run Date</option>
</select>
		    </div>					    
        </div>  
        <div class="filter-form">	
            <div class="lbl-field">
			    <label for="From">From</label>
		    </div>   
            <div class="edit-field width-auto">	
                <input type="text" value="" name="From" id="From" data-val-date="The field From must be a date." data-val="true" class="hasDatepicker" disabled="disabled"><img class="ui-datepicker-trigger" src="/images/calendar.gif" alt="..." title="..." style="display: none;">                
            </div>
        </div>  
         <div class="filter-form">	
            <div class="lbl-field">
			    <label for="To">To</label>
		    </div>   
            <div class="edit-field width-auto">	
                <input type="text" value="" name="To" id="To" data-val-date="The field To must be a date." data-val="true" class="hasDatepicker" disabled="disabled"><img class="ui-datepicker-trigger" src="/images/calendar.gif" alt="..." title="..." style="display: none;">                
            </div>
        </div>     
        <div class="filter-form">	
         <div class="lbl-field">
         </div>   
            <div class="submit">
		        <input type="submit" value="Submit"> 
            </div>    
        </div>             		   
    </section>
