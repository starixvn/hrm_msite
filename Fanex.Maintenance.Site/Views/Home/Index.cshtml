            <div class="lbl-field width-auto">
			    <label for="Server">Server</label>
		    </div>   
            <div class="edit-field width-auto">	
                <select name="Server" id="Server"><option value="">All</option>
<option value="10.19.10.12">10.19.10.12</option>
<option value="10.19.10.71">10.19.10.71</option>
<option value="10.18.200.214">10.18.200.214</option>
<option value="10.18.200.206">10.18.200.206</option>
<option value="10.18.200.213">10.18.200.213</option>
<option value="10.18.200.215">10.18.200.215</option>
</select>			                
            </div>
        </div>     
        <div class="filter-form">	
            <div class="lbl-field width-auto">
			    <label for="Schedule">Schedule</label>
		    </div>   
            <div class="edit-field width-auto">	
                <select name="Schedule" id="Schedule" disabled="disabled"><option value="">All</option>
<option value="DemoSchedule">DemoSchedule</option>
<option value="Demo New Schedule">Demo New Schedule</option>
<option value="time">time</option>
</select>			                
            </div>
        </div>        
        <div class="filter-form">	
            <div class="lbl-field width-auto">
			    <label for="Enabled">Status</label>
		    </div>
            <div class="edit-field width-auto">				                
                <select name="Enabled" id="Enabled" data-val-number="The field Status must be a number." data-val="true"><option value="">All</option>
<option value="1">Enabled</option>
<option value="0">Disabled</option>
</select>
		    </div>					    
        </div> 
        <div class="filter-form">	                              
             <div class="lbl-field width-auto">
			    <label for="Execution_Status">Execution</label>
		    </div>
            <div class="edit-field width-auto">				                
                <select name="Execution_Status" id="Execution_Status" data-val-number="The field Execution must be a number." data-val="true"><option value="">All</option>
<option value="0">Obsolete</option>
<option value="1">Executing</option>
<option value="2">Waiting for thread</option>
<option value="3">Between retries</option>
<option value="4">Idle</option>
<option value="5">Suspended</option>
<option value="6">Performing completion actions</option>
</select>
		    </div>			  
        </div>             
        <div class="filter-form">            	         
            <div class="submit">
		            <input type="submit" value="Submit">                        
            </div>
        </div>             		   
    </section>
