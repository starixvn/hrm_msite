@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    ViewBag.Title = string.Format("{0}", "Home");
}
@section Head{
    <link href="~/themes/job/job/manage.less" rel="stylesheet" type="text/css" />
}
<section id="secondary_bar">
		<div class="user">
