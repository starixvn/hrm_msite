<!DOCTYPE html>
<!--[if IEMobile 7]><html class="no-js iem7 oldie"><![endif]-->
<!--[if (IE 7)&!(IEMobile)]><html class="no-js ie7 oldie" lang="en"><![endif]-->
<!--[if (IE 8)&!(IEMobile)]><html class="no-js ie8 oldie" lang="en"><![endif]-->
<!--[if (IE 9)&!(IEMobile)]><html class="no-js ie9" lang="en"><![endif]-->
<!--[if (gt IE 9)|(gt IEMobile 7)]><!-->
<html lang="en" class="linen">
<!--<![endif]-->
<head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8" />
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <title>@ViewBag.Title</title>
    <meta http-equiv="cleartype" content="on" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link href="~/themes/reset.css" rel="stylesheet" type="text/css" />
    <link href="~/themes/fonts.css" rel="stylesheet" type="text/css" />
    <link href="~/scripts/Plugin/jquery-ui-1.9.1.custom/css/custom-theme/jquery-ui-1.9.1.custom.min.css"
        rel="stylesheet" type="text/css" />
    <link href="~/themes/assets/css/prettify.css" rel="stylesheet" type="text/css" />
    <link href="~/themes/assets/css/site.css" rel="stylesheet" type="text/css" />
    <link href="~/scripts/lib/tipsy/tipsy-1.0.0.min.css" rel="stylesheet" type="text/css" />
    <link href="~/scripts/lib/msgbox/msgbox-0.0.1.min.css" rel="stylesheet" type="text/css" />
    <style type="text/css">
        .navigater
        {
            background: url("../themes/job/images/forward.png") no-repeat transparent;
            float: left;
            margin-right: 5px;
            cursor: pointer;
            background-position: 0px 0px;
            display: none;
            width: 30px;
            height: 25px;
            font-size: 0;
        }
        
        a.navigater:hover
        {
            background-position: 0px -35px;
        }
    </style>
    <script src="~/scripts/lib/jquery-1.8.0.min.js" type="text/javascript"></script>
    <script src="~/scripts/lib/modernizr-2.6.1.js" type="text/javascript"></script>
    <script src="~/themes/assets/js/prettify.min.js" type="text/javascript"></script>
    <script src="~/themes/assets/js/underscore.min.js" type="text/javascript"></script>
    <script src="~/scripts/lib/fxHeader_0.6.js" type="text/javascript"></script>
    @if (ViewBag.ViewFlags != null && ViewBag.ViewFlags.IsReCheckin)
    { 
        <script src="~/Areas/UserLogin/scripts/ReCheckIn.js" type="text/javascript"></script>
    }
    @RenderSection("Head", false)
</head>
<body style="overflow: hidden;">
    <section id="headline">
        @RenderSection("Headline", false)
    </section>
    @RenderSection("FilterBar", false)
    <section id="body">
        <div class="content">
            <section id="secondary_bar">
                <div class="breadcrumbs_container">
                    <a href="#" class="navigater"></a>
                    @RenderSection("HeaderBar", false)
                </div>
            </section>
            @RenderBody()
        </div>
    </section>
    <div id="dialog-message">
    </div>
    <div id="dialog-popup">
    </div>
</body>
</html>
@Html.Hidden("NapAdminRoot", Url.Content("~/"))
<script src="~/scripts/lib/jquery-ui-1.8.23.min.js" type="text/javascript"></script>
<script src="~/scripts/lib/jquery.validate.min.js" type="text/javascript"></script>
<script src="~/scripts/lib/jquery.validate.unobtrusive.min.js" type="text/javascript"></script>
<script src="~/scripts/lib/tipsy/tipsy-1.0.0.min.js" type="text/javascript"></script>
<script src="~/scripts/lib/msgbox/msgbox-0.0.1.min.js" type="text/javascript"></script>
<script src="~/scripts/Maintenance.js" type="text/javascript"></script>
<script src="~/scripts/_Layout.js" type="text/javascript"></script>
<link href="~/scripts/lib/chosen/chosen.css" rel="stylesheet" type="text/css" />
<script src="~/scripts/lib/chosen/chosen.jquery.js" type="text/javascript"></script>
<script type="text/javascript">
    $(function () {
        if (parent.$('#collapsepanel').val() == "1") {
            $('a.navigater').show();
        }
        $('a.navigater').click(function () {
            $('a.navigater').hide();
            parent.$('div.leftcontent').css("width", "18%");
            parent.$('div.rightcontent').css("width", "82%");
            parent.$('#collapsepanel').val("0");
        });
        try {
            parent.NAP.loadingBox.close();
        }
        catch (e) {
        }
        $('form').live("submit", function () {
            parent.NAP.loadingBox.show();
        });
    });
</script>
@RenderSection("Foot", false)
