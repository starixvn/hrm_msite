<!DOCTYPE html>
<!--[if IEMobile 7]><html class="no-js iem7 oldie"><![endif]-->
<!--[if (IE 7)&!(IEMobile)]><html class="no-js ie7 oldie" lang="en"><![endif]-->
<!--[if (IE 8)&!(IEMobile)]><html class="no-js ie8 oldie" lang="en"><![endif]-->
<!--[if (IE 9)&!(IEMobile)]><html class="no-js ie9" lang="en"><![endif]-->
<!--[if (gt IE 9)|(gt IEMobile 7)]><!-->
<html lang="en" class="linen">
<!--<![endif]-->
<head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8" />
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <title>@ViewBag.Title</title>
    <meta http-equiv="cleartype" content="on" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    @Styles.Render("~/css/common")
    @RenderSection("Head", false)
</head>
<body>
    <header>
        <div class="logo">
            <a href="~/?ref=logo">mSite</a>
        </div>
        <nav>
            <ul class="menu">
                <li class="first"><a href="~/?ref=logo">Home</a></li>
                <li class="has-kids"><a href="javascript:void(0);">@ViewResource.AppLogs</a>
                    <ul>
                        <li>@Html.ActionLink(ViewResource.AppLogs_ViewLog, string.Empty, "Log")</li>
                        <li>@Html.ActionLink(ViewResource.AppLogs_MangeMachines, string.Empty, "Machine")</li>
                    </ul>
                </li>
                <li class="has-kids"><a href="javascript:;">Mail Service</a>
                    <ul>
                        <li>@Html.ActionLink(@ViewResource.Mail_List, "MailList", "Mail")</li>
                        <li>@Html.ActionLink(@ViewResource.Mail_Setting, "MailSetting", "Mail")</li>
                        <li>@Html.ActionLink(@ViewResource.Mail_Config, "MailConfig", "Mail")</li>
                        <li>@Html.ActionLink("Mail Function", "MailFunction", "Mail")</li>
                    </ul>
                </li>
                <li class="has-kids"><a href="javascript:;">Database Report</a>
                    <ul>
                        <li>@Html.ActionLink("Data Integrity", "DataIntegrity", "DatabaseReport")</li>
                    </ul>
                </li>
                <li class="has-kids"><a href="javascript:;">Licensee Setting</a>
                    <ul>
                        <li>@Html.ActionLink("Lrf Domain", "LrfDomain", "LicenseeSetting")</li>
                    </ul>
                </li>
                <li class="first"><a href="javascript:;">Connection String</a>
                    <ul>
                        <li>@Html.ActionLink(ViewResource.Site, "Site", "ConnectionString")</li>
                        <li>@Html.ActionLink(ViewResource.DatabaseServer, "DatabaseServer", "ConnectionString")</li>
                        <li>@Html.ActionLink(ViewResource.Database, "Database", "ConnectionString")</li>
                        <li>@Html.ActionLink("Connection", "Connection", "ConnectionString")</li>
                        <li>@Html.ActionLink("Switch Connection", "SwitchConnection", "ConnectionString")</li>
                        <li>@Html.ActionLink("View log", "Log", "ConnectionString")</li>
                    </ul>
                </li>
            </ul>
        </nav>
        <div class="user-info">
            <div class="greeting">
                <h2>
                    Howdy, @HttpContext.Current.User.Identity.Name</h2>
                <ul>
                    <li>@Html.ActionLink("Sign Out", "LogOut", "Login", new { Area = "UserLogin" }, new { })</li>
                </ul>
            </div>
        </div>
    </header>
    <section id="headline">
        @RenderSection("Headline", false)
    </section>
    @RenderSection("FilterBar", false)
    <section id="body">
        <div class="content">
            @RenderSection("LeftMenu", false)
            @RenderBody()
        </div>
    </section>
    @*<footer>
		<div class="content">
			<p>&copy; @DateTime.Now.Year Nexcel Solutions. All Rights Reserved.</p>
		</div>
	</footer>*@
    <div id="dialog-message">
    </div>
    <div id="dialog-popup">
    </div>
</body>
</html>
@Html.Hidden("NapAdminRoot", Url.Content("~/"))
@Scripts.Render("~/scripts/common")
@if (ViewBag.ViewFlags != null && ViewBag.ViewFlags.IsReCheckin)
{
    @Scripts.Render("~/scripts/recheckin")
}
@RenderSection("Foot", false)
@RenderSection("scripts", false)
