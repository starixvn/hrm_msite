@using Fanex.Maintenance.Criteria.Job
@model GetListJobCriteria
@{
    ViewBag.Title = "Job Management";
    Layout = "~/Views/Shared/_SqlJobManagementLayout.cshtml";
    var lisJob = ViewBag.ListJob != null ? (List<JobSchedule>)ViewBag.ListJob : new List<JobSchedule>();
}
@section Head {
    <link href="~/themes/job/user/manage.less" rel="stylesheet" type="text/css" />
    <script src="~/scripts/Job/JobManagementPage.js" type="text/javascript"></script>
}
@section Headline {
    <h1>
        <span class="title">@ViewBag.Title</span>
        @Html.ActionLink("+ " + ViewResource.Create_Job, "JobManagementPage", "SqlJobManagement", null, new { @class = "lnk" })
    </h1>
}
@using (Html.BeginForm())
{ 
    <section id="filter-bar">    
         <div class="filter-form">	
            <div class="lbl-field">
			    @Html.LabelFor(m => m.Job_Name)
		    </div>   
            <div class="edit-field width-auto">	
                @Html.TextBoxFor(m => m.Job_Name)                
            </div>
        </div>     
		<div class="filter-form">	
            <div class="lbl-field">
			    @Html.LabelFor(m => m.Server)
		    </div>   
            <div class="edit-field">	
                @Html.DropDownListFor(m => m.Server, (List<SelectListItem>)ViewBag.ListServer, "All")			                
            </div>
        </div>        
        <div class="filter-form">	
            <div class="lbl-field ">
			    @Html.LabelFor(m => m.Enabled)
		    </div>
            <div class="edit-field">				                
                @Html.DropDownListFor(m => m.Enabled,
                    new List<SelectListItem> { 
                        new SelectListItem{ Text=ViewResource.Enabled,Value=((int)Constans.Status.Enabled).ToString()},
                        new SelectListItem{ Text=ViewResource.Disabled,Value=((int)Constans.Status.Disabled).ToString()}
                    }
                , "All")
		    </div>					    
        </div> 
        <div class="filter-form">	                              
             <div class="lbl-field ">
			    @Html.LabelFor(m => m.Execution_Status)
		    </div>
            <div class="edit-field">				                
                @Html.DropDownListFor(m => m.Execution_Status,
                    new List<SelectListItem> { 
                        new SelectListItem{ Text=ViewResource.Obsolete,Value=((int)Constans.ExecutionStatus.Obsolete).ToString()},                        
                        new SelectListItem{ Text=ViewResource.Executing,Value=((int)Constans.ExecutionStatus.Executing).ToString()},                        
                        new SelectListItem{ Text=ViewResource.Waiting_For_Thread,Value=((int)Constans.ExecutionStatus.WaitingFoThread).ToString()},                        
                        new SelectListItem{ Text=ViewResource.Between_Retries,Value=((int)Constans.ExecutionStatus.BetweenRtries).ToString()},                        
                        new SelectListItem{ Text=ViewResource.Idle,Value=((int)Constans.ExecutionStatus.Idle).ToString()},                        
                        new SelectListItem{ Text=ViewResource.Suspended,Value=((int)Constans.ExecutionStatus.Suspended).ToString()},                        
                        new SelectListItem{ Text=ViewResource.Performing_Completion_Actions,Value=((int)Constans.ExecutionStatus.PerformingCompletionActions).ToString()}
                    }
                , "All")
		    </div>			  
        </div> 
        <div class="filter-form">	
            <div class="lbl-field ">
			    @Html.LabelFor(m => m.DateType)
		    </div>
            <div class="edit-field">				                
                @Html.DropDownListFor(m => m.DateType,
                    new List<SelectListItem> { 
                        new SelectListItem{ Text=ViewResource.Last_Run_Date,Value=((int)Constans.DateType.Last).ToString()},
                        new SelectListItem{ Text=ViewResource.Next_Run_Date,Value=((int)Constans.DateType.Next).ToString()}
                    }
                , "All")
		    </div>					    
        </div>  
        <div class="filter-form">	
            <div class="lbl-field">
			    @Html.LabelFor(m => m.From)
		    </div>   
            <div class="edit-field width-auto">	
                @Html.TextBoxFor(m => m.From)                
            </div>
        </div>  
         <div class="filter-form">	
            <div class="lbl-field">
			    @Html.LabelFor(m => m.To)
		    </div>   
            <div class="edit-field width-auto">	
                @Html.TextBoxFor(m => m.To)                
            </div>
        </div>     
        <div class="filter-form">	
         <div class="lbl-field">
         </div>   
            <div class="submit">
		        <input type="submit" value="Submit" /> 
            </div>    
        </div>             		   
    </section>
}
<table class="grid">
    <thead>
        <tr>
            <th>
                #
            </th>
            <th>
                @ViewResource.Job
            </th>
            <th>
                @ViewResource.Date_Modified
            </th>
            <th>
                @ViewResource.Last_Run_Date
            </th>
            <th>
                @ViewResource.Next_Run_Date
            </th>
            <th>
                @ViewResource.Current_Execution_Status
            </th>
            <th>
                @ViewResource.Server
            </th>
            <th>
                @ViewResource.Enabled
            </th>
            <th>
                @ViewResource.Action
            </th>
        </tr>
    </thead>
    <tbody>
        @{
            int i = 0;
            foreach (var item in lisJob)
            {
                string rowCss = i % 2 == 0 ? string.Empty : "class=\"alt\"";
                i++;
            <tr @Html.Raw(rowCss)>
                <td class="align-center">
                    @(i)
                </td>
                <td>
                    @item.Job.Name
                </td>
                <td>
                    @item.Job.DateModified
                </td>
                <td>
                    @item.LastRunDate
                </td>
                <td>
                    @item.NextRunDate
                </td>
                <td class="align-center">
                    @item.ExecuteStatus
                </td>
                <td>
                    @item.Job.OrinatingServer.Name
                </td>
                <td class="align-center">
                    @item.Job.Enable
                </td>
                <td class="align-center">
                    <div class="action-wrp">
                        <span class="btn-action">Action</span>
                        <div class="relative">
                            <ul class="actions" style="visibility: hidden; opacity: 0;">
                                <li><a href="#" class="dd-edit">Edit '@item.Job.Name' Details</a> </li>
                                <li><a href="#" class="dd-site">View log '@item.Job.Name'</a></li>
                                <li>@Html.ActionLink("View step" + item.Job.Name, "StepManagement"
                                        , new { job = item.Job.Name, server = item.Job.OrinatingServer.Name }
                                        , new { @class = "dd-edit" })
                                </li>
                                <li><a href="#" class="dd-site">View schedule '@item.Job.Name'</a></li>
                                <li><a href="#" class="dd-site">Run</a></li>
                                <li><a href="#" class="dd-site">Copy to</a></li>
                            </ul>
                        </div>
                    </div>
                </td>
            </tr>
            }
        }
    </tbody>
</table>
@Html.Hidden("dateFrom", (string)ViewBag.DateFrom)
@Html.Hidden("dateTo", (string)ViewBag.DateTo)
@Html.Hidden("imagePath", (string)@Url.Content("~/images/calendar.gif"))
@section Foot {
    <script type="text/javascript">
        $(function () {
        });        
    </script>
}
