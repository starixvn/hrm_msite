@using Fanex.Maintenance.Criteria.Job
@model GetListJobCriteria
@{
    ViewBag.Title = "Job Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var lisJob = ViewBag.ListJob != null ? (List<JobSchedule>)ViewBag.ListJob : new List<JobSchedule>();
}
@section Head {
    <link href="~/themes/job/user/manage.less" rel="stylesheet" type="text/css" />
    <link href="~/themes/nexhrm/Styles/site.css" rel="stylesheet" type="text/css" />
    <link href="~/themes/nexhrm/Styles/style.css" rel="stylesheet" type="text/css" />
    <script src="~/scripts/lib/jsrender.js" type="text/javascript"></script>
    <script type="text/x-jsrender" id="templateSchedule">
        <option value="{{:Name}}">{{:Name}}</option>
    </script>
}
@section LeftMenu{
    @Html.Action("LeftMenuPage", "SqlJobManagement")
}
<div class="content_wrap">
    <section id="section_breadcrumb">
                <div class="separator js-separator">
                    <div class="js-view-title separator-view-title" id="view_title">                           
                    </div>
                    <div class="js-menu separator-menu">                            
                    </div>
                </div>
        </section>
    <section id="headline">
            <h1>
        <span class="title">@ViewBag.Title</span>
        @Html.ActionLink("+ " + ViewResource.Create_Job, "JobManagement", "SqlJobManagement", null, new { @class = "lnk" })
    </h1>
    	</section>
    <section id="body">
		<div class="content">		
@using (Html.BeginForm())
{ 
    <section id="filter-bar">    
         <div class="filter-form">	
            <div class="lbl-field width-auto">
			    @Html.LabelFor(m => m.Job_Name)
		    </div>   
            <div class="edit-field width-auto">	
                @Html.TextBoxFor(m => m.Job_Name)                
            </div>
        </div>     
		<div class="filter-form">	
            <div class="lbl-field width-auto">
			    @Html.LabelFor(m => m.Server)
		    </div>   
            <div class="edit-field width-auto">	
                @Html.DropDownListFor(m => m.Server, (List<SelectListItem>)ViewBag.ListServer, "All")			                
            </div>
        </div>     
        <div class="filter-form">	
            <div class="lbl-field width-auto">
			    @Html.LabelFor(m => m.Schedule)
		    </div>   
            <div class="edit-field width-auto">	
                @Html.DropDownListFor(m => m.Schedule, (List<SelectListItem>)ViewBag.ListSchedule, "All")			                
            </div>
        </div>        
        <div class="filter-form">	
            <div class="lbl-field width-auto">
			    @Html.LabelFor(m => m.Enabled)
		    </div>
            <div class="edit-field width-auto">				                
                @Html.DropDownListFor(m => m.Enabled,
                    new List<SelectListItem> { 
                        new SelectListItem{ Text=ViewResource.Enabled,Value=((int)Status.Enabled).ToString()},
                        new SelectListItem{ Text=ViewResource.Disabled,Value=((int)Status.Disabled).ToString()}
                    }
                , "All")
		    </div>					    
        </div> 
        <div class="filter-form">	                              
             <div class="lbl-field width-auto">
			    @Html.LabelFor(m => m.Execution_Status)
		    </div>
            <div class="edit-field width-auto">				                
                @Html.DropDownListFor(m => m.Execution_Status,
                    new List<SelectListItem> { 
                        new SelectListItem{ Text=ViewResource.Obsolete,Value=((int)ExecutionStatus.Obsolete).ToString()},                        
                        new SelectListItem{ Text=ViewResource.Executing,Value=((int)ExecutionStatus.Executing).ToString()},                        
                        new SelectListItem{ Text=ViewResource.Waiting_For_Thread,Value=((int)ExecutionStatus.WaitingFoThread).ToString()},                        
                        new SelectListItem{ Text=ViewResource.Between_Retries,Value=((int)ExecutionStatus.BetweenRtries).ToString()},                        
                        new SelectListItem{ Text=ViewResource.Idle,Value=((int)ExecutionStatus.Idle).ToString()},                        
                        new SelectListItem{ Text=ViewResource.Suspended,Value=((int)ExecutionStatus.Suspended).ToString()},                        
                        new SelectListItem{ Text=ViewResource.Performing_Completion_Actions,Value=((int)ExecutionStatus.PerformingCompletionActions).ToString()}
                    }
                , "All")
		    </div>			  
        </div>             
        <div class="filter-form">            	         
            <div class="submit">
		            <input type="submit" value="Submit" />                        
            </div>
        </div>             		   
    </section>
}
<table class="grid">
    <thead>
        <tr>
            <th>
                #
            </th>
            <th>
                @ViewResource.Job
            </th>
            <th>
                @ViewResource.Date_Modified
            </th>
            <th>
                @ViewResource.Last_Run_Date
            </th>
            <th>
                @ViewResource.Next_Run_Date
            </th>
            <th>
                @ViewResource.Current_Execution_Status
            </th>
            <th>
                @ViewResource.Server
            </th>
            <th>
                @ViewResource.Enabled
            </th>
            <th>
                @ViewResource.Action
            </th>
        </tr>
    </thead>
    <tbody>
        @{
            int i = 0;
            foreach (var item in lisJob)
            {
                string rowCss = i % 2 == 0 ? string.Empty : "class=\"alt\"";
                i++;
            <tr @Html.Raw(rowCss)>
                <td class="align-center">
                    @(i)
                </td>
                <td>
                    @item.Job.Name
                </td>
                <td>
                    @item.Job.DateModified.ToFullDateString()
                </td>
                <td>
                    @item.LastRunDate.ToFullDateString()
                </td>
                <td>
                    @item.NextRunDate.ToFullDateString()
                </td>
                <td class="align-center">
                    @item.ExecuteStatus.ToExecutionString()
                </td>
                <td>
                    @item.ServerIp
                </td>
                <td class="align-center">
                    @if (item.Job.Enable == 1)
                    {
                        <img src="~/themes/job/img/blank.png" alt="" class="ico-tick" />
                    }
                </td>
                <td class="align-center">
                    <div class="action-wrp">
                        <span class="btn-action">Action</span>
                        <div class="relative">
                            <ul class="actions" style="visibility: hidden; opacity: 0;">
                                <li><a href="#" class="dd-edit">Edit '@item.Job.Name' Details</a> </li>
                                 <li>@Html.ActionLink("View log" + item.Job.Name, "JobLogManagement"
                                        , new { job = item.Job.Name, server = item.ServerIp }
                                        , new { @class = "dd-edit" })
                                <li>@Html.ActionLink("View step" + item.Job.Name, "StepManagement"
                                        , new { job = item.Job.Name, server = item.ServerIp }
                                        , new { @class = "dd-edit" })
                                </li>
                                <li><a href="#" class="dd-site">View schedule '@item.Job.Name'</a></li>
                                <li><a href="#" class="dd-site">Run</a></li>
                                <li><a href="#" class="dd-site">Copy to</a></li>
                            </ul>
                        </div>
                    </div>
                </td>
            </tr>
            }
            if (i.Equals(0))
            {
                <tr>
                    <td class="align-center" colspan="10">
                    @ViewResource.NoInformationAvailable
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
</div>
</div>
@section Foot {
    <script src="~/scripts/Job/JobManagementPage.js" type="text/javascript"></script>
}
