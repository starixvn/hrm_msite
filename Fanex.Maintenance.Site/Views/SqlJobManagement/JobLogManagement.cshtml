@using Fanex.Maintenance.Criteria.Job
@model GetListJobCriteria
@{
    ViewBag.Title = Model.Job_Name;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var lisJobLog = ViewBag.ListLogJob != null ? (List<JobLog>)ViewBag.ListLogJob : new List<JobLog>();
}
@section Head {
    <link href="~/themes/job/user/manage.less" rel="stylesheet" type="text/css" />
    <script src="~/scripts/Job/JobLogManagement.js" type="text/javascript"></script>
    <link href="~/themes/nexhrm/Styles/site.css" rel="stylesheet" type="text/css" />
    <link href="~/themes/nexhrm/Styles/style.css" rel="stylesheet" type="text/css" />
}
@section LeftMenu{
    @Html.Action("LeftMenuPage", "SqlJobManagement")
}
<div class="content_wrap">
    <section id="section_breadcrumb">
                <div class="separator js-separator">
                    <div class="js-view-title separator-view-title" id="view_title">                           
                    </div>
                    <div class="js-menu separator-menu">                            
                    </div>
                </div>
        </section>
    <section id="headline">
            <h1>
        <span class="title"><span class="first">@ViewResource.Job_Log_Management
            /</span>
            @ViewBag.Title
        </span>
        @Html.ActionLink("← " + ViewResource.Back_To_List, "JobManagement", "SqlJobManagement", null, new { @class = "lnk" })
    </h1>
    	</section>
    <section id="body">
		<div class="content">	
@using (Html.BeginForm())
{ 
    @Html.HiddenFor(m => m.Server)    
    <section id="filter-bar">    
         <div class="filter-form">	
            <div class="lbl-field width-auto">
			    @Html.LabelFor(m => m.Job_Name)
		    </div>   
            <div class="edit-field width-auto">	
                @Html.DropDownListFor(m => m.Job_Name, (List<SelectListItem>)ViewBag.ListJob
             , new { @class = "chosen" })			                
            </div>
        </div>   
          <div class="filter-form">	                              
             <div class="lbl-field width-auto ">
			    @Html.LabelFor(m => m.Execution_Status)
		    </div>
            <div class="edit-field">				                
                @Html.DropDownListFor(m => m.Execution_Status,
                    new List<SelectListItem> { 
                        new SelectListItem{ Text=ViewResource.Success,Value=((int)StepRunStatus.Success).ToString()},                        
                        new SelectListItem{ Text=ViewResource.Fail,Value=((int)StepRunStatus.Fail).ToString()},                                              
                    }
                , "All"
                , new { @class = "chosen" })
		    </div>			  
        </div>   		                        
        <div class="filter-form">	
            <div class="lbl-field width-auto">
			    @Html.LabelFor(m => m.From)
		    </div>   
            <div class="edit-field width-auto">	                    
                 @Html.TextBox("From", ((DateTime)Model.To).ToString("MMMM dd, yyyy")
                 , new { @style = "width:90px;margin-right:5px;" }) 
            </div>
        </div>  
         <div class="filter-form">	
            <div class="lbl-field width-auto">
			    @Html.LabelFor(m => m.To)
		    </div>   
            <div class="edit-field width-auto">	                
                @Html.TextBox("To", ((DateTime)Model.To).ToString("MMMM dd, yyyy")
                , new { @style = "width:90px;margin-right:5px;" })
            </div>
        </div>     
        <div class="filter-form">	
         <div class="lbl-field">
         </div>   
            <div class="submit">
		        <input type="submit" value="Submit" /> 
            </div>    
        </div>             		   
    </section>
}
<table class="grid">
    <thead>
        <tr>
            <th>
                #
            </th>
            <th>
                @ViewResource.Status
            </th>
            <th>
                @ViewResource.Step_Id
            </th>
            <th>
                @ViewResource.Step_Name
            </th>
            <th>
                @ViewResource.Date
            </th>
            <th>
                @ViewResource.Message
            </th>
            <th>
                @ViewResource.Duration
            </th>
            <th>
                @ViewResource.Action
            </th>
        </tr>
    </thead>
    <tbody>
        @{
            int i = 0;
            foreach (var item in lisJobLog)
            {
                string rowCss = i % 2 == 0 ? string.Empty : "class=\"alt\"";
                i++;
            <tr @Html.Raw(rowCss)>
                <td class="align-center">
                    @(i)
                </td>
                <td>
                    @item.RunSatus
                </td>
                <td>
                    @item.Step.Id
                </td>
                <td>
                    @item.Step.Name
                </td>
                <td>
                    @item.RunDate
                </td>
                <td>
                    @item.Message
                </td>
                <td>
                    @item.RunDuration
                </td>
                <td class="align-center">
                    <div class="action-wrp">
                        <span class="btn-action">Action</span>
                        <div class="relative">
                            <ul class="actions" style="visibility: hidden; opacity: 0;">
                                <li><a href="#" class="dd-site">Run</a></li>
                                <li><a href="#" class="dd-site">Copy to</a></li>
                            </ul>
                        </div>
                    </div>
                </td>
            </tr>
            }
        }
    </tbody>
</table>
</div>
</div>
@Html.Hidden("imagePath", (string)@Url.Content("~/images/calendar.gif"))
@section Foot {
}
