@using Fanex.Maintenance.Core.Configurations
@model ServerCollection
<div class="column_wrap">
    <div class="column">
        <div class="nav_links">
            <div class="overview_section togglable_section" id="0">
                <div class="separator first">
                    <strong>Sql Job Management</strong>
                </div>
            </div>
            <div style="display: block;" class="navItem">
                <div id="sqljobmanagement_servermanagement_" class="el" data-hashovermenu="False">
                    <span class="xicon news"></span>
                    @Html.ActionLink(ViewResource.ServerManagement, "ServerManagement", "SqlJobManagement")
                </div>
                <div id="sqljobmanagement_schedulemanagementpage_" class="el" data-hashovermenu="True">
                    <span class="xicon clock3"></span>
                    @Html.ActionLink(ViewResource.ScheduleManagement, "ScheduleManagementPage", "SqlJobManagement")
                </div>
                <div id="sqljobmanagement_jobmanagement_" class="el selected" data-hashovermenu="False">
                    <span class="xicon calendar8"></span>
                    @Html.ActionLink(ViewResource.JobManagement, "JobManagement", "SqlJobManagement")
                </div>
            </div>
            @{                
                var classClose = string.Empty;
                foreach (ServerElement server in Model)
                {
                <div class="overview_section togglable_section" id="1">
                    <div class="separator">
                        <strong>Server :@server.ServerIp</strong>
                    </div>
                </div>
                <div style="display: block;" class="navItem">
                    <div id="employee_index" class="el" data-hashovermenu="False">
                        <span class="xicon users"></span><a href="#">@ViewResource.WindowsEventLog</a>
                    </div>
                    <div id="sqljobmanagement_sqlserverlogmanagement_@(server.ServerIp.Replace('.', '_'))" class="el" data-hashovermenu="False">
                        <span class="xicon calendar"></span>
                        @Html.ActionLink(ViewResource.SqlServerLog, "SqlServerLogManagement"
                            , new { server = server.ServerIp })
                    </div>
                    <div id="sqljobmanagement_sqlagentlogmanagement_@(server.ServerIp.Replace('.', '_'))" class="el" data-hashovermenu="False">
                        <span class="xicon user1"></span>
                        @Html.ActionLink(ViewResource.SqlAgentLog, "SqlAgentLogManagement"
                            , new { server = server.ServerIp })
                    </div>
                    <div id="sqljobmanagement_schedulemanagementpage_@(server.ServerIp.Replace('.', '_'))" class="el" data-hashovermenu="False">
                        <span class="xicon calendar1"></span>
                        @Html.ActionLink(ViewResource.Schedule, "ScheduleManagementPage"
                            , new { server = server.ServerIp })
                    </div>
                    <div id="sqljobmanagement_jobmanagement_@(server.ServerIp.Replace('.', '_'))" class="el" data-hashovermenu="False">
                        <span class="xicon calendar4"></span>
                        @Html.ActionLink(ViewResource.Jobs, "JobManagement"
                            , new { server = server.ServerIp })
                    </div>
                    <div id="report_totalworkinghours" class="el" data-hashovermenu="False">
                        <span class="xicon clock"></span><a href="#">@ViewResource.Alerts</a>
                    </div>
                    <div id="holiday_index" class="el" data-hashovermenu="False">
                        <span class="xicon holiday"></span><a href="#">@ViewResource.Operators</a>
                    </div>
                </div>
                }
            }
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {

        $('.el').removeClass('selected');

        var currentUrl = '@(ViewBag.Controller.ToString().ToLower() + "_" + ViewBag.Action.ToString().ToLower() + "_" + ViewBag.Server.ToString().Replace('.', '_'))';
        console.log(currentUrl);

        var selectNavItem = $("#" + currentUrl);
        if (selectNavItem != undefined) {
            selectNavItem.addClass("selected");
        }

        //show/hide navigation secion
        $("div.togglable_section").bind("click", function () {

            var currentSection = $(this);
            var divItems = currentSection.next("div.navItem");
            if (currentSection.hasClass("folded")) {
                currentSection.removeClass("folded");
                divItems.show(200);
            }
            else {

                currentSection.addClass("folded");
                divItems.hide(200);
            }
        });

        //add style for first item section
        $("div.togglable_section:first-child").children(":first").addClass("first");

        $('.el[data-hashovermenu=True], .el[data-hashovermenu=data-hashovermenu]').hover(
        function () {
            $(this).find('.hoveraction').fadeIn(400);
        }, function () {
            $(this).find('.hoveraction').hide();
        });
    });

    
</script>
