<script type="text/javascript">

    $(document).ready(function () {

        //When page loads...
        $(".tab_content").hide(); //Hide all content
        $("ul.tabs li:first").addClass("active").show(); //Activate first tab
        $(".tab_content:first").show(); //Show first tab content

        //On Click Event
        $("ul.tabs li").click(function () {

            $("ul.tabs li").removeClass("active"); //Remove any "active" class
            $(this).addClass("active"); //Add "active" class to selected tab
            $(".tab_content").hide(); //Hide all tab content

            var activeTab = $(this).find("a").attr("href"); //Find the href attribute value to identify the active tab + content
            $(activeTab).fadeIn(); //Fade in the active ID content
            return false;
        });

    });
    </script>
<script type="text/javascript">
    $(function () {
        $('.column').equalHeight();
    });
    </script>
@using Fanex.Maintenance.Core.Configurations
@model ServerCollection
<aside class="column" id="sidebar" style="height: 1711px;">
		<form class="quick_search">
			<input type="text" onfocus="if(!this._haschanged){this.value=''};this._haschanged=true;" value="Quick Search">
		</form>
		<hr>
		<h3>Content <a class="toggleLink" href="#"></a></h3>
		<ul class="toggle">
			<li class="icn_new_article">@Html.ActionLink(ViewResource.ServerManagement, "ServerManagement", "SqlJobManagement")</li>
			<li class="icn_edit_article"> @Html.ActionLink(ViewResource.ScheduleManagement, "ScheduleManagementPage", "SqlJobManagement")</li>
			<li class="icn_categories"> @Html.ActionLink(ViewResource.JobManagement, "JobManagement", "SqlJobManagement")</li>			
		</ul>	
       	<h3>Server <a class="toggleLink" href="#"></a></h3>
    @{                
        var classClose = string.Empty;
        foreach (ServerElement server in Model)
        {
        <div id="demo1" class="demo">
	    <ul>
		    <li id="phtml_1">
			    <a href="#">@server.ServerIp</a>
			    <ul>
				    <li id="phtml_2">
					    @Html.ActionLink(ViewResource.SqlServerLog, "SqlServerLogManagement"
                            , new { server = server.ServerIp })
				    </li>
				    <li id="phtml_3">
					    @Html.ActionLink(ViewResource.SqlAgentLog, "SqlAgentLogManagement"
                            , new { server = server.ServerIp })
				    </li>
                    <li id="phtml_4">
                     @Html.ActionLink(ViewResource.Schedule, "ScheduleManagementPage"
                            , new { server = server.ServerIp })
                    </li>
                    <li id="phtml_5">
                      @Html.ActionLink(ViewResource.Jobs, "JobManagement"
                            , new { server = server.ServerIp })
                    </li>
			    </ul>
		    </li>		
	    </ul>
        </div>
        }
    }
<script type="text/javascript" class="source">
    $(function () {
        $("#toggle_dots, #toggle_icons").click(function () {
            $("#demo1").jstree(this.value);
        });

        $(".demo").jstree({
            "themes": {
                "theme": "default",
                "dots": false,
                "icons": true
            },
            "plugins": ["themes", "html_data"]
        });
    });
</script>
</aside>
