@using Fanex.Maintenance.Criteria.Job
@model List<StepDetail>
@{
    ViewBag.Title = (string)ViewBag.JobName;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    <link href="~/themes/job/user/manage.less" rel="stylesheet" type="text/css" />
    <link href="~/themes/nexhrm/Styles/site.css" rel="stylesheet" type="text/css" />
    <link href="~/themes/nexhrm/Styles/style.css" rel="stylesheet" type="text/css" />
}
@section LeftMenu{
    @Html.Action("LeftMenuPage", "SqlJobManagement")
}
<div class="content_wrap">
    <section id="section_breadcrumb">
                <div class="separator js-separator">
                    <div class="js-view-title separator-view-title" id="view_title">                           
                    </div>
                    <div class="js-menu separator-menu">                            
                    </div>
                </div>
        </section>
    <section id="headline">
           <h1>
        <span class="title"><span class="first">@ViewResource.Step_Management
            /</span>
            @ViewBag.Title
        </span>
        @Html.ActionLink("← " + ViewResource.Back_To_List, "JobManagement", "SqlJobManagement", null, new { @class = "lnk" })
        @Html.ActionLink("+ " + ViewResource.Create_Step, "JobManagement", "SqlJobManagement", null, new { @class = "lnk" })
    </h1>
    	</section>
    <section id="body">
		<div class="content">	
<table class="grid">
    <thead>
        <tr>
            <th>
                @ViewResource.Step_Id
            </th>
            <th>
                @ViewResource.Step_Name
            </th>
            <th>
                @ViewResource.Database_Name
            </th>
            <th>
                @ViewResource.Last_Run_Date
            </th>
            <th>
                @ViewResource.On_Fail_Action
            </th>
            <th>
                @ViewResource.On_Success_Action
            </th>
            <th>
                @ViewResource.Last_Run_Outcome
            </th>
            <th>
                @ViewResource.Action
            </th>
        </tr>
    </thead>
    <tbody>
        @{
            int i = 0;
            foreach (var item in Model)
            {
                string rowCss = i % 2 == 0 ? string.Empty : "class=\"alt\"";
                i++;
            <tr @Html.Raw(rowCss)>
                <td class="align-center">
                    @item.Id
                </td>
                <td>
                    @item.Name
                </td>
                <td>
                    @item.DatabaseName
                </td>
                <td>
                    @item.LastRunDate
                </td>
                <td>
                    @item.OnFailAction
                </td>
                <td>
                    @item.OnSuccessAction
                </td>
                <td class="align-center">
                    @item.LastRunOutCome
                </td>
                <td class="align-center">
                    <div class="action-wrp">
                        <span class="btn-action">Action</span>
                        <div class="relative">
                            <ul class="actions" style="visibility: hidden; opacity: 0;">
                                <li><a href="#" class="dd-site">Run</a></li>
                                <li><a href="#" class="dd-site">Copy to</a></li>
                            </ul>
                        </div>
                    </div>
                </td>
            </tr>
            }
        }
    </tbody>
</table>
</div>
</div>
@section Foot {
}
