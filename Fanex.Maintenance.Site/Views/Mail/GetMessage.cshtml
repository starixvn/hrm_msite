@using Fanex.MailDeliver.Model
@model MailRecord
@{
    Layout = null;
}
@if (!ReferenceEquals(Model, null))
{ 
    <div class="form">
        <div class="form-row required">
            <div class="lbl-field">
                @Html.LabelFor(m => m.MailTo)
            </div>
            <div class="edit-field">
                <label>@Html.Raw(@Model.MailTo.Replace(",", "<br/>"))</label>
            </div>
        </div>
        <div class="form-row required">
            <div class="lbl-field">
                @Html.LabelFor(m => m.MailCc)
            </div>
            <div class="edit-field">
                <label>@Html.Raw(Model.MailCc.Replace(",", "<br/>"))</label>
            </div>
        </div>
        <div class="form-row required">
            <div class="lbl-field">
                @Html.LabelFor(m => m.MailBcc)
            </div>
            <div class="edit-field">
                <label>@Html.Raw(@Model.MailBcc.Replace(",", "<br/>"))</label>
            </div>
        </div>
        <div class="form-row required">
            <div class="lbl-field">
                @Html.LabelFor(m => m.MailDate)
            </div>
            <div class="edit-field">
                <label>@Model.MailDate</label>
            </div>
        </div>
        <div class="form-row required">
            <div class="lbl-field">
                @Html.LabelFor(m => m.Title)
            </div>
            <div class="edit-field">
                <label>@Model.Title</label>
            </div>
        </div>
        <div class="form-row required">
            <div class="lbl-field">
                @Html.LabelFor(m => m.Subject)
            </div>
            <div class="edit-field">
                <label>@Model.Subject</label>
            </div>
        </div>
        <div class="form-row required">
            <div class="lbl-field">
                @Html.LabelFor(m => m.Body)
            </div>
            <div class="edit-field">
                <label>@Html.Raw(Model.Body)</label>
            </div>
        </div>
    </div>
}