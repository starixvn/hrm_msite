@model AliasUpdateCriteria
@{
    ViewBag.Title = ViewResource.Update;
    Layout = "~/Views/Shared/_Layout.cshtml";    
}
@{
    ViewBag.Title = string.Format("{0} {1}", ViewResource.Update, ViewResource.Alias);
    bool success = ViewBag.Success != null && ViewBag.Success;
    var listSite = (List<Site>)ViewBag.Site;
    var alias = (Alias)ViewBag.Alias;
    var listSiteAlias = (List<Site>)ViewBag.SiteAlias;
}
@section Head {
    <link href="~/themes/job/user/manage.less" rel="stylesheet" type="text/css" />
    <style type="text/css">
        .subteam
        {
            border: 1px solid #CCCCCC;
            height: 100px;
            overflow-x: hidden;
            overflow-y: scroll;
            padding-bottom: 8px;
            width: 290px;
            background-color: #fff;
        }
        .subteam label
        {
            border-top: 1px solid #ccc;
            display: block;
            line-height: 20px;
            margin-top: 4px;
            padding-top: 4px;
            background-color: #fff;
        }
        .subteam label:first-child
        {
            border-top: medium none !important;
        }
        
        .item
        {
            margin: 5px 5px;
        }
    </style>
}
@section Headline {
    <h1>
        <span class="title">@ViewBag.Title</span>
        @Html.ActionLink("← " + ViewResource.Back_To_List, "Alias", "ConnectionString", null, new { @class = "lnk" })
    </h1>
}
@using (Html.BeginForm())
{
    <div class="form">
        <div class="form-row summary">
            <div class="lbl-field">
            </div>
            <div class="edit-field">
                @Html.ValidationSummary()
            </div>
        </div>
        <div class="form-row required">
            <div class="lbl-field">
                @Html.LabelFor(m => m.Name)
            </div>
            <div class="edit-field">
                @Html.TextBox("Name", alias.Name)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.Description)
            </div>
            <div class="edit-field">
                @Html.TextBox("Description", alias.Description)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.Label(ViewResource.Site)
            </div>
            <div class="edit-field">
                <div class="input subteam">
                    @if (!ReferenceEquals(listSite, null))
                    {
                        foreach (var item in listSite)
                        {
                            var itemSite = listSiteAlias.Where(s => s.Id == item.Id).FirstOrDefault();
                            if (!ReferenceEquals(itemSite, null))
                            {                             
                        <label>
                            <input type="checkbox" class="item" value="@item.Id" name="siteId" checked="checked"/>@item.Name
                        </label>
                            }
                            else
                            {
                        <label>
                            <input type="checkbox" class="item" value="@item.Id" name="siteId" />@item.Name
                        </label>

                            }
                        }
                    }
                </div>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.Label(ViewResource.Status)
            </div>
            <div class="edit-field">
                @Html.CheckBox("IsActive", alias.IsActive)
                @Html.LabelFor(m => m.IsActive, ViewResource.Active)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
            </div>
            <div class="edit-field">
                @if (!success)
                {
                    <input type="submit" value="@ViewResource.Save" />
                    <button class="cancel" onclick="NAP.redirect('ConnectionString/Alias', 0); return false;">@ViewResource.Cancel</button>
                }
            </div>
        </div>
    </div>
    @Html.Hidden("AliasId", alias.Id)
}
@section Foot
{
    <script src="~/scripts/Connection/CreateAlias.js" type="text/javascript"></script>
    @if (success)
    {
        string dialogMsg = string.Format(ViewResource.UpSuccessMsg, ViewResource.Alias + " '" + alias.Name + "'", 3);

        <script type="text/javascript">
            $(function () {
                NAP.showSuccessMsg('@dialogMsg', 'ConnectionString/Alias', 2000);
            });
        </script>
    }
}
