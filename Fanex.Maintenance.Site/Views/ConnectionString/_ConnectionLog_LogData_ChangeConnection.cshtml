@{
    Layout = null;
    var listOld = ViewBag.ListOld as List<ConnectionString>;
}
@model List<ConnectionString>
<h1>@ViewResource.Old_Value</h1>
<table class="grid">
    <thead>
        <tr>
            <th>
                #
            </th>
            <th>
                @ViewResource.Alias
            </th>
            <th>
                @ViewResource.Connection_String
            </th>
        </tr>
    </thead>
    <tbody>
        @{               
            int i = 0;
            foreach (var item in Model)
            {
                string rowCss = i % 2 == 0 ? string.Empty : "class='alt'";
		
            <tr @Html.Raw(rowCss)>
                <td>
                    @(++i)
                </td>
                <td>
                    @item.Alias.Name
                </td>
                <td>
                    @item.Connection
                </td>
            </tr>             
                i++;
            }
        }
    </tbody>
</table>
<br />
<br />
<h1>@ViewResource.New_Value</h1>
<table class="grid">
    <thead>
        <tr>
            <th>
                #
            </th>
            <th>
                @ViewResource.Alias
            </th>
            <th>
                @ViewResource.Connection_String
            </th>
        </tr>
    </thead>
    <tbody>
        @{               
            i = 0;
            foreach (var item in listOld)
            {
                string rowCss = i % 2 == 0 ? string.Empty : "class='alt'";
		
            <tr @Html.Raw(rowCss)>
                <td>
                    @(++i)
                </td>
                <td>
                    @item.Alias.Name
                </td>
                <td>
                    @item.Connection
                </td>
            </tr>             
                i++;
            }
        }
    </tbody>
</table>
