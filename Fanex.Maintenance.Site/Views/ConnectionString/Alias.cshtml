@using Fanex.Maintenance.Entity.Model.ConnectionString
@model AliasGetAllCriteria
@{
    ViewBag.Title = ViewResource.Manage_Alias;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listAlias = (List<AliasConnectionString>)ViewBag.ListAlias;
}
@section Head {
    <link href="~/themes/job/user/manage.less" rel="stylesheet" type="text/css" />
    <style type="text/css">
        .form
        {
            background: none repeat scroll 0 0 transparent;
            border: 0 none;
            box-shadow: none;
            padding: 10px 0 0;
        }
    </style>
}
@section Headline {
    <h1>
        <span class="title">@ViewBag.Title</span>
        @Html.ActionLink("+ Create New", "CreateAlias", "ConnectionString", null, new { @class = "lnk" })
        @Html.ActionLink("-> Switch Backup Connection", "ChangeSecondConnection", "ConnectionString", null, new { @class = "lnk" })
    </h1>
}
@using (Html.BeginForm())
{ 
    <section id="filter-bar">
        <div class="filter-form">
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.DbServerId)
            </div>
            <div class="edit-field">
                @Html.DropDownListFor(m => m.DbServerId, (List<SelectListItem>)ViewBag.DatabaseServer, ViewResource.All_Server)
            </div>
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.SiteId)
            </div>
            <div class="edit-field">
                @Html.DropDownListFor(m => m.SiteId, (List<SelectListItem>)ViewBag.Site, ViewResource.All_Site)
            </div>
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.Alias)
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.Alias)
            </div>
            <div class="submit">
                <input type="submit" value="Submit" />
            </div>
        </div>
    </section>
}
<table class="grid">
    <thead>
        <tr>
            <th>
                #
            </th>
            <th>
                @ViewResource.Name
            </th>
            <th>
                @ViewResource.Sites
            </th>
            <th>
                @ViewResource.Connection_String
            </th>
            <th>
                @ViewResource.Modifier
            </th>
            <th>
                @ViewResource.Modified_Date
            </th>
            <th>
                @ViewResource.Active
            </th>
            <th>
                @ViewResource.Change_Connection
            </th>
            <th>
                @ViewResource.Edit_Connection
            </th>
        </tr>
    </thead>
    <tbody>
        @if (!ReferenceEquals(listAlias, null))
        {
            int i = 0;
            foreach (var item in listAlias)
            {
                string rowCss = i % 2 == 0 ? string.Empty : "class=\"alt\"";
                i++;
            <tr class="@rowCss">
                <td class="width-30 align-center">
                    @i
                </td>
                <td>
                    @Html.ActionLink(item.Alias.Name, "EditAlias", new { id = item.Alias.Id })
                </td>
                <td class="align-center">
                    @if (item.NumOfSite > 0)
                    {
                        <a href="#" aid="@item.Alias.Id" class="numofsite" aname="@item.Alias.Name">@item.NumOfSite</a>
                    }
                    else
                    {
                        <span>0</span>
                    }
                </td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(item.ConnectionString.Connection))
                    {
                        <span>@item.ConnectionString.Connection</span>
                    }
                    else
                    {
                        @ViewResource.N_A
                    }
                </td>
                <td>
                    @item.Alias.Modifier.Name
                </td>
                <td>
                    @item.Alias.ModifiedDate.ToFullDateString()
                </td>
                <td class="align-center">
                    @if (item.Alias.IsActive)
                    {
                        <input type="checkbox" checked="checked" aid="@item.Alias.Id" aname="@item.Alias.Name" class="update-status"/>
                    }
                    else
                    {
                        <input type="checkbox" aid="@item.Alias.Id" aname="@item.Alias.Name" class="update-status"/>
                    }
                </td>
                <td class="align-center">
                    @if (!string.IsNullOrWhiteSpace(item.ConnectionString.Connection))
                    {
                        <a href="#" class="change-connection" aid="@item.Alias.Id" aname="@item.Alias.Name">
                            Change</a>
                    }
                    else
                    {
                        @ViewResource.N_A
                    }
                </td>
                <td class="align-center">
                    @Html.ActionLink("Edit", "Connection", new { id = item.Alias.Id })
                </td>
            </tr>
            }
            if (i == 0)
            {
            <tr>
                <td colspan="10" class="align-center">
                    @ViewResource.NoInformationAvailable
                </td>
            </tr>
            }
        }
    </tbody>
</table>
<script src="~/scripts/Connection/Alias.js" type="text/javascript"></script>
