@model DatabaseServerGetAllCriteria
@{
    ViewBag.Title = ViewResource.Manage_Server;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listDbServer = (List<DatabaseServerSite>)ViewBag.ListDbServer;
}
@section Head {
    <link href="~/themes/job/user/manage.less" rel="stylesheet" type="text/css" />
}
@section Headline {
    <h1>
        <span class="title">@ViewBag.Title</span>
        @Html.ActionLink("+ Create New", "CreateDbServer", "ConnectionString", null, new { @class = "lnk" })
    </h1>
}
@using (Html.BeginForm())
{ 
    <section id="filter-bar">
        <div class="filter-form">
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.Name)
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.Name)
            </div>
            <div class="submit">
                <input type="submit" value="Submit" />
            </div>
        </div>
    </section>
}
<table class="grid">
    <thead>
        <tr>
            <th>
                #
            </th>
            <th>
                @ViewResource.Name
            </th>
            <th>
                @ViewResource.Server_IP
            </th>
            <th>
                @ViewResource.Sites
            </th>
            <th>
                @ViewResource.Modifier
            </th>
            <th>
                @ViewResource.Modified_Date
            </th>
            <th>
                @ViewResource.Active
            </th>
            <th>
                @ViewResource.Edit
            </th>
        </tr>
    </thead>
    <tbody>
        @if (!ReferenceEquals(listDbServer, null))
        {
            int i = 0;
            foreach (var item in listDbServer)
            {
                string rowCss = i % 2 == 0 ? string.Empty : "class=\"alt\"";
                i++;
            <tr class="@rowCss">
                <td class="width-30 align-center">
                    @i
                </td>
                <td>
                    @item.DatabaseServer.Name
                </td>
                <td>
                    @item.DatabaseServer.ServerIP
                </td>
                <td class="align-center">
                    @if (item.NumOfSite > 0)
                    {
                        <a href="#" did="@item.DatabaseServer.Id" class="num-site" dname="@item.DatabaseServer.Name">@item.NumOfSite</a>
                    }
                    else
                    {
                        <span>0</span>
                    }
                </td>
                <td>
                    @item.DatabaseServer.Modifier.Name
                </td>
                <td class="align-center">
                    @item.DatabaseServer.ModifiedDate.ToFullDateString()
                </td>
                <td class="align-center">
                    @if (item.DatabaseServer.IsActive)
                    {
                        <input type="checkbox" checked="checked" did="@item.DatabaseServer.Id" dname="@item.DatabaseServer.Name" class="update-status"/>
                    }
                    else
                    {
                        <input type="checkbox"did="@item.DatabaseServer.Id" dname="@item.DatabaseServer.Name" class="update-status"/>
                    }
                </td>
                <td class="align-center">
                    @Html.ActionLink("Edit", "EditDbServer", new { id = item.DatabaseServer.Id })
                </td>
            </tr>
            }
        }
    </tbody>
</table>
<script src="~/scripts/Connection/DatabaseSever.js" type="text/javascript"></script>
