@model ConnectionUpdateCriteria
@{  
    ViewBag.Title = ViewResource.Update + ViewResource.Connection;
    Layout = "~/Views/Shared/_Layout.cshtml";    
}
@{
    ViewBag.Title = string.Format("{0} {1}", ViewResource.Update, ViewResource.Connection);
    bool success = ViewBag.Success != null && ViewBag.Success;    
}
@section Head {
    <link href="~/themes/job/user/manage.less" rel="stylesheet" type="text/css" />
    <style type="text/css">
        .form .form-row .lbl-field
        {
            font-family: Tahoma;
            padding: 5px 25px 0 0;
            text-align: right;
            text-shadow: 0 1px #FAFAFA;
            vertical-align: top;
            width: 130px;
        }
    </style>
}
@section Headline {
    <h1>
        <span class="title">@ViewBag.Title</span>
        @Html.ActionLink("← " + ViewResource.Back_To_List, "Connection", "ConnectionString", new { id = Model.AliasId }, new { @class = "lnk" })
    </h1>
}
@using (Html.BeginForm())
{
    <div class="form">
        <div class="form-row summary">
            <div class="lbl-field">
            </div>
            <div class="edit-field">
                @Html.ValidationSummary()
            </div>
        </div>
        <div class="form-row required">
            <div class="lbl-field">
                @Html.LabelFor(m => m.ServerId)
            </div>
            <div class="edit-field">
                @Html.DropDownListFor(m => m.ServerId, (List<SelectListItem>)ViewBag.DbServer)
            </div>
        </div>
        <div class="form-row required">
            <div class="lbl-field">
                @Html.LabelFor(m => m.InitialCatalog)
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.InitialCatalog)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.IntegratedSecurity)
            </div>
            <div class="edit-field">
                @Html.CheckBoxFor(m => m.IntegratedSecurity)
                @Html.LabelFor(m => m.IntegratedSecurity, ViewResource.Yes)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.UserID)
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.UserID)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.Password)
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.Password)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.FreeText)
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.FreeText)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.SecondaryConnectionId)
            </div>
            <div class="edit-field">
                @Html.DropDownListFor(m => m.SecondaryConnectionId, (List<SelectListItem>)ViewBag.ListConnection, ViewResource.None)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.Label(ViewResource.Default)
            </div>
            <div class="edit-field">
                @Html.CheckBoxFor(m => m.IsDefault)
                @Html.LabelFor(m => m.IsDefault, ViewResource.Yes)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
            </div>
            <div class="edit-field">
                @if (!success)
                {
                    <input type="submit" value="@ViewResource.Save" />
                    <input type="reset" value="@ViewResource.Cancel" />  
                }
            </div>
        </div>
    </div>
    @Html.HiddenFor(m => m.AliasId)
    @Html.HiddenFor(m => m.ConnectionId)
}
@section Foot
{
    @if (success)
    {
        string dialogMsg = string.Format(ViewResource.UpSuccessMsg, ViewResource.Connection, 3);

        <script type="text/javascript">
            $(function () {
                NAP.showSuccessMsg('@dialogMsg', 'ConnectionString/Connection/' + @Model.AliasId, 2000);
            });
        </script>
    }
}
