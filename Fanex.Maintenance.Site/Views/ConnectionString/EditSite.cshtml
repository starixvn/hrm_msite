@model SiteUpdateCriteria
@{  
    ViewBag.Title = ViewResource.Update + ViewResource.Site;
    Layout = "~/Views/Shared/_Layout.cshtml";    
}
@{
    ViewBag.Title = string.Format("{0} {1}", ViewResource.Update, ViewResource.Site);
    bool success = ViewBag.Success != null && ViewBag.Success;    
}
@section Head {
    <link href="~/themes/job/user/manage.less" rel="stylesheet" type="text/css" />
}
@section Headline {
    <h1>
        <span class="title">@ViewBag.Title</span>
        @Html.ActionLink("← " + ViewResource.Back_To_List, "Site", "ConnectionString", null, new { @class = "lnk" })
    </h1>
}
@using (Html.BeginForm())
{
    <div class="form">
        <div class="form-row summary">
            <div class="lbl-field">
            </div>
            <div class="edit-field">
                @Html.ValidationSummary()
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.Name)
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.Name)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.Description)
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.Description)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.IsActive)
            </div>
            <div class="edit-field">
                @Html.CheckBoxFor(m => m.IsActive)
                @Html.LabelFor(m => m.IsActive, ViewResource.IsActive)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
            </div>
            <div class="edit-field">
                @if (!success)
                {
                    <input type="submit" value="@ViewResource.Save" />
                    <input type="reset" value="@ViewResource.Cancel" />  
                }
            </div>
        </div>
    </div>    
    @Html.HiddenFor(m => m.SiteId)
}
@section Foot
{
    @if (success)
    {
        string dialogMsg = string.Format(ViewResource.AddSuccessMsg, ViewResource.Conection, 3);

        <script type="text/javascript">
            $(function () {
                NAP.showSuccessMsg('@dialogMsg', 'ConnectionString/Site/', 2000);
            });
        </script>
    }
}
