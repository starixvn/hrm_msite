@model List<ConnectionStringConnection>
@{
    Layout = null;
    var aliasId = ViewBag.AliasId;
}
<table class="grid">
    <thead>
        <tr>
            <th class="first">
                #
            </th>
            <th>
                @ViewResource.Connection_String
            </th>
        </tr>
    </thead>
    <tbody>
        @if (!ReferenceEquals(Model, null) && Model.Count() > 0)
        {
            int i = 0;
            foreach (var item in Model)
            {
                string rowCss = i % 2 == 0 ? string.Empty : "class='alt'";
		
            <tr @Html.Raw(rowCss)>
                <td class="align-center width-30">
                    @if (item.ConnectionString.IsDefault)
                    {
                        <input type="radio" checked="checked" name="conection" cid="@item.ConnectionString.Id" aid="@aliasId"/>
                    }
                    else
                    {
                        <input type="radio" name="conection" cid="@item.ConnectionString.Id" aid="@aliasId"/>
                    }
                </td>
                <td>
                    @item.ConnectionString.Connection
                </td>
            </tr>
            }
        }
    </tbody>
</table>
@if (!ReferenceEquals(Model, null) && Model.Count() > 0)
{
    <div class="form">
        <div class="form-row">
            <div class="edit-field">
                <input type="submit" value="@ViewResource.Save" id="btnChangeConnection" />
            </div>
        </div>
    </div>
}