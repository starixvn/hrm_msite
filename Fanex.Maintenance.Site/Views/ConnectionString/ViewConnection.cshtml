@model IEnumerable<AliasConnectionString>
<pre>
@if (Model != null)
{
    string format = "<add name=\"{0}\" connectionString=\"{1}\" providerName=\"System.Data.SqlClient\" />";
    foreach (var item in Model)
    {
        var con = string.Format(format, item.Alias.Name, item.ConnectionString.Connection);
    <div>@con</div>       
    }
}
</pre>
