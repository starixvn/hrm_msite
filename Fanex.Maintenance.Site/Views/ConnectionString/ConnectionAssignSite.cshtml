@using Fanex.Maintenance.ViewModel.Connection
@model ConnectionAssignSiteViewModel
@{
    ViewBag.Title = ViewResource.Manage_Connection;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var disable = Model.HasEditPermission ? string.Empty : "disabled";
}
@section Head {
    <link href="~/themes/job/user/manage.less" rel="stylesheet" type="text/css" />
}
@section Headline {
    <h1>
        <span class="title">@ViewBag.Title / @Model.Name</span>
        @Html.ActionLink("← " + ViewResource.Back_To_List, "Connection", "ConnectionString", null, new { @class = "lnk" })
    </h1>
}
<table class="grid" style="width: 500px">
    <thead>
        <th>
            #
        </th>
        <th>
            @ViewResource.Site
        </th>
    </thead>
    <tbody>
        @foreach (var item in Model.SelectListSite)
        {
            <tr>
                <td class="align-center">
                    @if (item.Selected)
                    { 
                        <input type="checkbox" sid="@item.Value" class="select-site" checked="checked" name="@item.Text" @disable/>
                    }
                    else
                    { 
                        <input type="checkbox" sid="@item.Value" class="select-site" name="@item.Text" @disable/>
                    }
                </td>
                <td>@item.Text
                </td>
            </tr>
        }
    </tbody>
</table>
@Html.Hidden("ConnectionId", Model.Id)
@section Foot{
    <script type="text/javascript">
        $(document).ready(function () {
            $('.select-site').click(function () {
                var $this = $(this);
                var connectionId = $('#ConnectionId').val();
                var siteId = $(this).attr('sid');
                var isCheck = $(this).is(':checked');
                var name = $this.attr('name');

                var url = isCheck ? "ConnectionString/ConnectionAssignSite" : "ConnectionString/ConnectionRemoveSite";

                var action = isCheck ? 'assign' : 'unassigned',
                    msg = "Are you sure you want to " + action + " '" + name + "' ?";

                $this.attr('checked', !isCheck).change();

                NAP.headlineMsgBox.confirm(msg, function () {

                    $this.attr('checked', isCheck).change();

                    $.ajax({
                        url: NAP.resolveClientUrl(url),
                        data: { connectionId: connectionId, siteId: siteId },
                        type: 'POST',
                        cache: false,
                        beforeSend: function () {
                            NAP.loadingBox.show();
                        },
                        complete: function () {
                            NAP.loadingBox.close();
                        },
                        success: function (result) {
                            if (result == 'true') {
                                NAP.headlineMsgBox.showInfo('Your changes were saved!', { closeBtn: false });
                                NAP.redirect('ConnectionString/ConnectionAssignSite/' + connectionId);
                            }
                        },
                        error: function (xhr, status, err) {
                            NAP.handleAjaxError(xhr, status, err);
                        }
                    });
                });
            });
        });
    </script>
}
