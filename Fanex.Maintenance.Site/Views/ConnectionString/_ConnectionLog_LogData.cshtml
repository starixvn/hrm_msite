@{
    Layout = null;
    var isShow = !(bool)ViewBag.IsNew;
}
@model List<LogData>
<table class="grid">
    <thead>
        <tr>
            <th>
                @ViewResource.Field_Name
            </th>
            @if (isShow)
            { 
                <th>
                    @ViewResource.Old_Value
                </th>
            }
            <th>
                @ViewResource.New_Value
            </th>
        </tr>
    </thead>
    <tbody>
        @{               
            int i = 0;
            foreach (var item in Model)
            {
                string rowCss = i % 2 == 0 ? string.Empty : "class='alt'";
		
            <tr @Html.Raw(rowCss)>
                <td>@item.FieldName
                </td>
                @if (isShow)
                { 
                    <td>
                        @item.OldValue
                    </td>
                }
                <td>
                    @item.NewValue
                </td>
            </tr>             
                i++;
            }
        }
    </tbody>
</table>
