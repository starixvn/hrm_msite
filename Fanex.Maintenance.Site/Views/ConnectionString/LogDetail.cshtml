@{
    Layout = null;
    var listData = (List<LogData>)ViewBag.LogData ?? new List<LogData>();   
    
}
@model Fanex.Maintenance.Entity.Model.ConnectionString.LogExecSp
@if (!ReferenceEquals(Model, null))
{
    if (Model.ActionId == (int)ConLogAction.ConnectionString_Alias_Insert)
    { 
    @Html.Action("_ConnectionLog_Alias_Insert", "ConnectionString", Model)
    }
    else
        if (Model.ActionId == (int)ConLogAction.ConnectionString_Alias_Update)
        {
    @Html.Action("_ConnectionLog_Alias_Update", "ConnectionString", Model)
        }
        else if (Model.ActionId == (int)ConLogAction.ConnectionString_ConnectionString_ChangeConnectionFromDbServer)
        {
    @Html.Action("_ConnectionLog_LogData_ChangeConnection", "ConnectionString", Model)   
        }
        else
        {     
    @Html.Action("_ConnectionLog_LogData", "ConnectionString", Model)   
        }

}