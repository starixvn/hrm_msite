@{
    Layout = null;
    var listSite = ViewBag.ListSite as List<LogData>;
}
@model List<LogData>
<h1>@ViewResource.Alias</h1>
<table class="grid">
    <thead>
        <tr>
            <th>
                @ViewResource.Field_Name
            </th>
            <th>
                @ViewResource.Value
            </th>
        </tr>
    </thead>
    <tbody>
        @{               
            int i = 0;
            foreach (var item in Model)
            {
                string rowCss = i % 2 == 0 ? string.Empty : "class='alt'";
		
            <tr @Html.Raw(rowCss)>
                <td>@item.FieldName
                </td>
                <td>
                    @item.NewValue
                </td>
            </tr>             
                i++;
            }
        }
    </tbody>
</table>
<br />
<h1>@ViewResource.Sites</h1>
<table class="grid">
    <thead>
        <tr>
            <th>
                #
            </th>
            <th>
                @ViewResource.Site
            </th>
        </tr>
    </thead>
    <tbody>
        @{               
            i = 0;
            foreach (var item in listSite)
            {
                string rowCss = i % 2 == 0 ? string.Empty : "class='alt'";
		
            <tr @Html.Raw(rowCss)>
                <td>
                    @(++i)
                </td>
                <td>
                    @item.NewValue
                </td>
            </tr>                             
            }
        }
    </tbody>
</table>
