@model SiteGetAllCriteria
@{
    ViewBag.Title = ViewResource.Manage_Site;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listSite = (List<SiteAlias>)ViewBag.ListSite;
}
@section Head {
    <link href="~/themes/job/user/manage.less" rel="stylesheet" type="text/css" />
}
@section Headline {
    <h1>
        <span class="title">@ViewBag.Title</span>
        @Html.ActionLink("+ Create New", "CreateSite", "ConnectionString", null, new { @class = "lnk" })
    </h1>
}
@using (Html.BeginForm())
{ 
    <section id="filter-bar">
        <div class="filter-form">
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.Name)
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.Name)
            </div>
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.DbServerId)
            </div>
            <div class="edit-field">
                @Html.DropDownListFor(m => m.DbServerId, (List<SelectListItem>)ViewBag.DatabaseServer, ViewResource.All_Server)
            </div>
            <div class="submit">
                <input type="submit" value="Submit" />
            </div>
        </div>
    </section>
}
<table class="grid">
    <thead>
        <tr>
            <th>
                @ViewResource.ID
            </th>
            <th>
                @ViewResource.Name
            </th>
            <th>
                @ViewResource.Alias
            </th>
            <th>
                @ViewResource.Description
            </th>
            <th>
                @ViewResource.Modifier
            </th>
            <th>
                @ViewResource.Modified_Date
            </th>
            <th>
                @ViewResource.Active
            </th>
            <th>
                @ViewResource.Edit
            </th>
        </tr>
    </thead>
    <tbody>
        @if (!ReferenceEquals(listSite, null))
        {
            int i = 0;
            foreach (var item in listSite)
            {
                string rowCss = i % 2 == 0 ? string.Empty : "class=\"alt\"";
                i++;
            <tr class="@rowCss">
                <td class="width-30 align-center">
                    @item.Site.Id
                </td>
                <td>
                    @item.Site.Name
                </td>
                <td class="align-center">
                    @if (item.NumOfAlias > 0)
                    {
                        <a href="#" sid="@item.Site.Id" class="num-alias" sname="@item.Site.Name">@item.NumOfAlias</a>
                    }
                    else
                    {
                        <span>0</span>
                    }
                </td>
                <td>
                    @item.Site.Description
                </td>
                <td>
                    @item.Site.Modifier.Name
                </td>
                <td class="align-center">
                    @item.Site.ModifiedDate.ToFullDateString()
                </td>
                <td class="align-center">
                    @if (item.Site.IsActive)
                    {
                        <input type="checkbox" checked="checked" sid="@item.Site.Id" sname="@item.Site.Name" class="update-status"/>
                    }
                    else
                    {
                        <input type="checkbox" sid="@item.Site.Id" sname="@item.Site.Name" class="update-status"/>
                    }
                </td>
                <td class="align-center">
                    @Html.ActionLink("Edit", "EditSite", new { id = item.Site.Id })
                </td>
            </tr>
            }
        }
    </tbody>
</table>
<script src="~/scripts/Connection/Site.js" type="text/javascript"></script>
