@model List<ConnectionStringConnection>
@{
    ViewBag.Title = ViewResource.Manage_Connection;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var alias = ViewBag.Alias as Alias;
}
@section Head {
    <link href="~/themes/job/user/manage.less" rel="stylesheet" type="text/css" />
}
@section Headline {
    <h1>
        <span class="title">@ViewBag.Title / @alias.Name</span>
        @Html.ActionLink("← " + ViewResource.Back_To_List, "Alias", "ConnectionString", null, new { @class = "lnk" })
        @Html.ActionLink("+ Create New", "CreateConnection", "ConnectionString", new { id = alias.Id }, new { @class = "lnk" })
    </h1>
}
<table class="grid">
    <thead>
        <tr>
            <th>
                #
            </th>
            <th>
                @ViewResource.Connection_String
            </th>
            <th>
                @ViewResource.Modifier
            </th>
            <th>
                @ViewResource.Modified_Date
            </th>
            <th>
                @ViewResource.Default
            </th>
            <th>
                @ViewResource.Backup
            </th>
            <th>
                @ViewResource.Edit
            </th>
        </tr>
    </thead>
    <tbody>
        @if (!ReferenceEquals(Model, null))
        {
            int i = 0;
            foreach (var item in Model)
            {
                string rowCss = i % 2 == 0 ? string.Empty : "class=\"alt\"";
                i++;
            <tr class="@rowCss">
                <td class="width-30 align-center">
                    @i
                </td>
                <td>
                    @item.ConnectionString.Connection
                </td>
                <td class="align-center">
                    @if (item.ConnectionString.Modifier != null)
                    {
                        <span>@item.ConnectionString.Modifier.Name</span>
                    }
                    else
                    {
                        @ViewResource.N_A
                    }
                </td>
                <td class="align-center">
                    @item.ConnectionString.ModifiedDate.ToFullDateString()
                </td>
                <td class="align-center">
                    @if (item.ConnectionString.IsDefault)
                    {
                        <input type="radio" name="connection-default" checked="checked" cid="@item.ConnectionString.Id"/>
                    }
                    else
                    { 
                        <input type="radio" name="connection-default" cid="@item.ConnectionString.Id"/>
                    }
                </td>
                <td class="align-center">
                    @if (item.NumOfConection > 0)
                    { 
                        <a href="#" cid="@item.ConnectionString.Id" class="second-conection">View</a>
                    }
                </td>
                <td class="align-center">
                    @Html.ActionLink("Edit", "EditConnection", new { id = item.ConnectionString.Id })
                </td>
            </tr>
            }
            if (i == 0)
            {
            <tr>
                <td colspan="12" class="align-center">
                    @ViewResource.NoInformationAvailable
                </td>
            </tr>
            }
        }
    </tbody>
</table>
@Html.Hidden("aliasId", alias.Id)
@Html.Hidden("aliasName", alias.Name)
<script src="~/scripts/Connection/Connection.js" type="text/javascript"></script>
