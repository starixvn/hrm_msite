@using Fanex.NAP.Core.Criteria.Group
@model InsertGroupCriteria
@{
	ViewBag.Title = string.Format("{0} {1}", ViewResources.Create_New, ViewResources.Group);
	bool success = ViewBag.Success != null && ViewBag.Success;
}
@section Head {
	<link href="~/Areas/UserControl/themes/nap/style.less" rel="stylesheet" type="text/css" />
}
@section Headline {
	<h1>
		<span class="title">
			<span class="first">@ViewResources.Group @ViewResources.Management /</span>
			@ViewBag.Title
		</span>
		@Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "Group", null, new { @class = "lnk" })
	</h1>
}

@using (Html.BeginForm())
{
	<div class="form">
		<div class="form-row summary">
			<div class="lbl-field"></div>
			<div class="edit-field">
				@Html.ValidationSummary()
			</div>
		</div>
		<div class="form-row required">
			<div class="lbl-field">
				@Html.LabelFor(g => g.GroupName)
			</div>
			<div class="edit-field">
				@Html.TextBoxFor(g => g.GroupName)
			</div>
		</div>
		<div class="form-row">
			<div class="lbl-field">
				@Html.LabelFor(g => g.Description)
			</div>
			<div class="edit-field">
				@Html.TextBoxFor(g => g.Description)
			</div>
		</div>
		<div class="form-row">
			<div class="lbl-field">
				@Html.LabelFor(g => g.IsActive)
			</div>
			<div class="edit-field chk-field">
				@Html.CheckBoxFor(g => g.IsActive)
				@Html.Label(ViewResources.Active)
			</div>
		</div>
		<div class="form-row">
			<div class="lbl-field"></div>
			<div class="edit-field">
	@if (!success)
	{
				<input type="submit" value="@ViewResources.Create" />
				<button onclick="NAP.redirect('Group/Manage', 0); return false;">@ViewResources.Cancel</button>
	}
			</div>
		</div>
	</div>
}
@section Foot {
	<script src="~/Areas/UserControl/scripts/lib/jquery.numeric.js" type="text/javascript"></script>

	@if (success)
	{
		string dialogMsg = string.Format(ViewResources.AddSuccessMsg, ViewResources.Group + " '" + Model.GroupName + "'", 5);

		<script type="text/javascript">
			$(function () {
				NAP.showSuccessMsg('@dialogMsg', 'Group/Manage', 6000);
			});
		</script>
	}
}