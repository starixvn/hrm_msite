@{
	Layout = null;
	var listUser = (List<UserPolicy>)ViewBag.Users;
	var listGroup = (List<GroupPolicy>)ViewBag.Groups;
}
<h2>
	<span class="title">@ViewResources.Group @ViewResources.List</span>
</h2>
<table class="grid">
	<thead>
		<tr>
			<th>
				#
			</th>
			<th>
				@ViewResources.Group_Name
			</th>
			<th>
				@ViewResources.Description
			</th>
			<th>
				@ViewResources.Policy
			</th>
			<th>
				@ViewResources.Modified_Date
			</th>
			<th>
				@ViewResources.Modifier
			</th>
	</thead>
	<tbody>
@if (listGroup != null && listGroup.Count > 0)
{
	int i = 0;
	foreach (var item in listGroup)
	{
		string rowCss = i % 2 == 0 ? string.Empty : "class=\"alt\"";
		
		<tr @Html.Raw(rowCss)>
			<td class="align-center">
				@(i + 1)
			</td>
			<td>
				@item.Group.Name
			</td>
			<td>
				@item.Group.Description
			</td>
			<td class="align-center">
		@if (item.Policy == (int)Constant.Policy.Host)
  {
				<span class="crud-host">@ViewResources.Host</span>
  }
  else
  {
				<span class="crud-read">@ViewResources.Read</span>
  }
			</td>
			<td>
				@Html.Raw(item.ModifiedDate.ToFullDateString())
			</td>
			<td>
				@(item.Creator != null ? item.Creator.Username : string.Empty)
			</td>
		</tr>
	
  i++;
	}
}
else
{
		<tr>
			<td colspan="6" class="align-center">
				@ViewResources.NoInformationAvailable
			</td>
		</tr>
}
	</tbody>
</table>
<br />
<br />
<h2>
	<span class="title">@ViewResources.User @ViewResources.List</span>
</h2>
<table class="grid">
	<thead>
		<tr>
			<th>
				#
			</th>
			<th>
				@ViewResources.Username
			</th>
			<th>
				@ViewResources.First_Name
			</th>
			<th>
				@ViewResources.Last_Name
			</th>
			<th>
				@ViewResources.Email
			</th>
			<th>
				@ViewResources.Group
			</th>
			<th>
				@ViewResources.Policy
			</th>
			<th>
				@ViewResources.Creator
			</th>
			<th>
				@ViewResources.Created_Date
			</th>
			<th>
				@ViewResources.Last_Login_Date
			</th>
		</tr>
	</thead>
	<tbody>
@if (listUser != null && listUser.Count > 0)
{
	int i = 0;
	foreach (var item in listUser)
	{
		string rowCss = i % 2 == 0 ? string.Empty : "class=\"alt\"";
		
		<tr @Html.Raw(rowCss)>
			<td class="align-center">
				@(i + 1)
			</td>
			<td>
				@item.User.Username
			</td>
			<td>
				@item.User.FirstName
			</td>
			<td>
				@item.User.LastName
			</td>
			<td>
				@item.User.Email
			</td>
			<td>
				@(item.User.Group != null ? item.User.Group.Name : string.Empty)
			</td>
			<td class="align-center">
		@if (item.Policy == (int)Constant.Policy.Host)
  {
				<span class="crud-host">@ViewResources.Host</span>
  }
  else
  {
				<span class="crud-read">@ViewResources.Read</span>
  }
			</td>
			<td>
				@(item.Creator != null ? item.Creator.Username : string.Empty)
			</td>
			<td>
				@Html.Raw(item.CreatedDate.ToFullDateString())
			</td>
			<td class="align-center">
		@if (item.User.LastLoginDate != DateTime.MinValue)
  {
				@item.User.LastLoginDate.ToFullDateString()
  }
  else
  {
				@ViewResources.NA
  }
			</td>
		</tr>
		
  i++;
	}
}
else
{
		<tr>
			<td colspan="10" class="align-center">
				@ViewResources.NoInformationAvailable
			</td>
		</tr>
}
	</tbody>
</table>
<br />