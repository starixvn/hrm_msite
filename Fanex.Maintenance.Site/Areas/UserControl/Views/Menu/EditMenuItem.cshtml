@using Fanex.NAP.Core.Criteria.MenuItem
@using Fanex.NAP.Core.Business
@model UpdateMenuItemCriteria
@{
	ViewBag.Title = string.Format("{0} {1}", ViewResources.Update, ViewResources.Menu_Item);
	bool success = ViewBag.Success != null && ViewBag.Success;
	var viewFlags = (ViewFlags)ViewBag.ViewFlags;
}
@section Head {
	<link href="~/Areas/UserControl/themes/nap/style.less" rel="stylesheet" type="text/css" />
	<script src="~/Areas/UserControl/scripts/lib/jsrender.js" type="text/javascript"></script>
	<script type="text/x-jsrender" id="templateDropdownList">
		<option value="{{:Id}}">{{:Name}}</option>
	</script>
}
@section Headline {
	<h1>
		<span class="title">
			<span class="first">@ViewResources.Menu @ViewResources.Management /</span>
			@ViewBag.Title
		</span>
		@Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "Menu", null, new { @class = "lnk" })
	</h1>
}
@using (Html.BeginForm())
{
	@Html.HiddenFor((m => m.MenuItemId))
	<div class="form">
		<div class="form-row">
			<div class="lbl-field"></div>
			<div class="edit-field">
				@Html.ValidationSummary()
			</div>
		</div>
		<div class="form-row required">
			<div class="lbl-field">
				@Html.LabelFor(m => m.MenuItemName)
			</div>
			<div class="edit-field">
				@Html.TextBoxFor(m => m.MenuItemName)
			</div>
		</div>
		<div class="form-row required">
			<div class="lbl-field">
				@Html.LabelFor(m => m.SiteId)
			</div>
			<div class="edit-field rdo-field">
				@Html.Label(Model.SiteName)
				@Html.HiddenFor(m => m.SiteId, Model.SiteId)
				@Html.HiddenFor(m => m.SiteName, Model.SiteName)
			</div>
		</div>
		<div class="form-row">
			<div class="lbl-field">
				@Html.LabelFor(m => m.Description)
			</div>
			<div class="edit-field">
				@Html.TextBoxFor(m => m.Description)
			</div>
		</div>
		<div class="form-row">
			<div class="lbl-field">
				@Html.LabelFor(m => m.Url)
			</div>
			<div class="edit-field">
				@Html.TextBoxFor(m => m.Url)
			</div>
		</div>
		<div class="form-row required">
			<div class="lbl-field">
				@Html.LabelFor(m => m.IsActive)
			</div>
			<div class="edit-field chk-field">
				@Html.CheckBoxFor(m => m.IsActive)
				@Html.Label(ViewResources.Active)
			</div>
		</div>
		<div class="form-row">
			<div class="lbl-field">
				@Html.LabelFor(m => m.ParentId)
			</div>
			<div class="edit-field">
				@Html.DropDownListFor(m => m.ParentId, (List<SelectListItem>)ViewBag.Parent, ViewResources.None, new { @class = "chzn-select" })
				@Html.HiddenFor(m => m.ParentName)
			</div>
		</div>
		<div class="form-row required">
			<div class="lbl-field">
				@Html.LabelFor(m => m.FunctionId)
			</div>
			<div class="edit-field">
				@Html.DropDownListFor(m => m.FunctionId, (List<SelectListItem>)ViewBag.Function, new { @class = "chzn-select" })
			</div>
		</div>
		<div class="form-row required">
			<div class="lbl-field">
				@Html.LabelFor(m => m.Policy)
			</div>
			<div class="edit-field rdo-field">
				@Html.RadioButtonFor(m => m.Policy, (int)Constant.Policy.Read, new { @id = "Policy-Read", @name = "Policy" })
				@Html.Label(Constant.Policy.Read.ToString())
				@Html.RadioButtonFor(m => m.Policy, (int)Constant.Policy.Host, new { @id = "Policy-Host", @name = "Policy" })
				@Html.Label(Constant.Policy.Host.ToString())
			</div>
		</div>
	@if (!viewFlags.IsLive)
	{
		<div class="form-row">
			<div class="lbl-field">
				@Html.LabelFor(m => m.Environment)
			</div>
			<div class="edit-field rdo-field">
				@Html.RadioButtonFor(m => m.Environment, "UAT", new { @id = "Environment-UAT", @name = "Policy" })
				@Html.Label("Environment-UAT", ViewResources.UAT)
				@Html.RadioButtonFor(m => m.Environment, "LIVE", new { @id = "Environment-LIVE", @name = "Policy" })
				@Html.Label("Environment-LIVE", ViewResources.LIVE)
			</div>
		</div>
	}
	else
	{
		@Html.HiddenFor(m => m.Environment)
	}
		<div class="form-row required">
			<div class="lbl-field">
				@Html.LabelFor(m => m.DisplayOrder)
			</div>
			<div class="edit-field">
				@Html.TextBoxFor(m => m.DisplayOrder, new { @class = "numeric" })
			</div>
		</div>
		<div class="form-row">
			<div class="lbl-field"></div>
			<div class="edit-field">
	@if (!success)
	{
				<input type="submit" value="@ViewResources.Save" />
				<button onclick="NAP.redirect('Menu/Manage', 0); return false;">@ViewResources.Cancel</button>
	}
			</div>
		</div>
	</div>
}
@section Foot {
	<script type="text/javascript">
		$(function () {
			$('input[type=reset]').bind('click', function () {
				window.location.replace(NAP.resolveClientUrl('Function/Manage'));
			});
		});
	</script>

	<script src="~/Areas/UserControl/scripts/Menu/EditMenuItem.js" type="text/javascript"></script>
	<script src="~/Areas/UserControl/scripts/lib/jquery.numeric.js" type="text/javascript"></script>

	@if (success)
	{
		string dialogMsg = string.Format(ViewResources.EditSuccessMsg, ViewResources.Menu_Item + " '" + Model.MenuItemName + "'", 5);

		<script type="text/javascript">
			$(function () {
				NAP.showSuccessMsg('@dialogMsg', 'Menu/Manage', 6000);
			});
		</script>
	}
}