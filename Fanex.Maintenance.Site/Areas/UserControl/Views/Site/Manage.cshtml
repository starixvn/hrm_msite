@model GetAllSiteCriteria
@{
	ViewBag.Title = string.Format("{0} {1}", ViewResources.Manage, ViewResources.Site);
	var siteList = ViewBag.SiteList as List<ISite>;
	var viewFlags = (ViewFlags)ViewBag.ViewFlags;
}
@section Head {
	<link href="~/Areas/UserControl/themes/nap/style.less" rel="stylesheet" type="text/css" />
}
@section Headline {
	<h1>
		<span class="title"><span class="first">@ViewResources.Site @ViewResources.Management
			/</span>
			@ViewBag.Title
		</span>
		@if (viewFlags.HasEditRight)
		{
			@Html.ActionLink("+ " + ViewResources.Create_New + " " + ViewResources.Site, "AddNew", 
				"Site", null, new { @class = "lnk" })
		}
	</h1>
}
<table class="grid">
	<thead>
		<tr>
			<th> # </th>
			<th> @ViewResources.Name </th>
			<th> @ViewResources.Users </th>
			<th> @ViewResources.Description </th>
			<th> @ViewResources.URL </th>
@if (!viewFlags.IsLive)
{
			<th> @ViewResources.Test_URL </th>
}
			<th> @ViewResources.Active </th>
@if (!viewFlags.IsLive)
{
			<th> @ViewResources.Environment </th>
}
@if (viewFlags.HasEditRight)
{
			<th> @ViewResources.Edit </th>
}
		</tr>
	</thead>
	<tbody>
@for (int i = 0; i < siteList.Count; i++)
{
	string rowCss = i % 2 == 0 ? string.Empty : "class=\"alt\"";
	var site = siteList[i];

		<tr @Html.Raw(rowCss)>
			<td class="align-center"> @(i + 1) </td>
			<td> @site.Name </td>
			<td class="align-center">
	@if (site.NumOfUser > 0)
	{
		string text = string.Format("{0} {1} '{2}'", ViewResources.Users, ViewResources.Of, site.Name);

				<a href="@Url.Action("Manage", "User", new { siteId = site.Id })"
					sid="@site.Id" sname="@site.Name" class="num-of-user" title="@text">@site.NumOfUser</a>
	}
	else
	{
				@site.NumOfUser
	}
			</td>
			<td> @site.Description </td>
			<td> @site.Url </td>
	@if (!viewFlags.IsLive)
	{
			<td> @site.TestUrl </td>
	}
			<td class="align-center">
	@if (viewFlags.HasEditRight)
	{
		string activateText = site.IsActive ? "Deactivate" : "Activate";

				@Html.CheckBox(string.Format("chk-site-{0}", site.Id),
					site.IsActive, new
					{
						sid = site.Id,
						sname = site.Name,
						title = string.Format("{0} '{1}'", activateText, site.Name)
					})
	}
	else if (site.IsActive)
	{
				<img src="~/areas/usercontrol/themes/nap/img/blank.png" alt="" class="ico-tick" />
	}
			</td>
	@if (!viewFlags.IsLive)
	{
			<td class="align-center"> @site.Environment </td>
	}
	@if (viewFlags.HasEditRight)
	{
			<td>
				@Html.ActionLink(".", "Edit", new { id = site.Id }, 
					new 
					{ 
						@class = "btn-edit tip", 
						title = string.Format("{0} '{1}'", ViewResources.Edit, site.Name) 
					})
			</td>
 }
		</tr>
}
	</tbody>
</table>
@section Foot {
	<script src="~/Areas/UserControl/scripts/Site/Manage.js" type="text/javascript"></script>
}