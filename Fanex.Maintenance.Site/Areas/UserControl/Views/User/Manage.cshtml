@using Fanex.NAP.Core.Criteria.User
@model IEnumerable<UserLevel>
@{
	ViewBag.Title = string.Format("{0} {1}", ViewResources.Manage, ViewResources.User);
	var viewFlags = (ViewFlags)ViewBag.ViewFlags;
	var level = ViewBag.Level != null ? (int)ViewBag.Level : 0;
	var userId = ViewBag.UserId != null ? (int)ViewBag.UserId : 0;
	var siteId = ViewBag.SiteId != null ? (int)ViewBag.SiteId : 0;
}
@section Head {
	<link href="~/Areas/UserControl/themes/nap/user/manage.less" rel="stylesheet" type="text/css" />
}
@section Headline {
	<h1>
		<span class="title">
			<span class="first">@ViewResources.User_Management /</span>
			@ViewBag.Title
		</span>
@if (viewFlags.HasEditRight)
{
		@Html.ActionLink("+ " + ViewResources.Create_New_User, "AddNew", "User", null, new { @class = "lnk" })
		@Html.ActionLink("+ " + ViewResources.Add_Existing_User, "AddUser", "User", null, new { @class = "lnk" })
}
	</h1>
}
<section id="filter-bar">
	@using (Html.BeginForm())
	{
		<div class="filter-form">
			<div class="lbl-field width-auto">
				@Html.Label(ViewResources.Username)
			</div>
			<div class="edit-field">
				@Html.TextBox("Username", string.Empty)
			</div>
			<div class="lbl-field width-auto">
				@Html.Label("GroupId", ViewResources.Group)
			</div>
			<div class="edit-field">
				@Html.DropDownList("GroupId", (List<SelectListItem>)ViewBag.Groups, ViewResources.All_Groups)
			</div>
		@if (viewFlags.IsNapAdminSite)
		{
			<div class="lbl-field width-auto">
				@Html.Label("SiteId", ViewResources.Site)
			</div>
			<div class="edit-field">
				@Html.DropDownList("SiteId", (List<SelectListItem>)ViewBag.Sites)
			</div>
		}
			<div class="submit">
				<input type="submit" value="@ViewResources.Submit" />
			</div>
		</div>		
	}
</section>
<table class="grid">
	<thead>
		<tr>
			<th class="first">
				#
			</th>
			<th>
				@ViewResources.Username
			</th>
			<th>
				@ViewResources.First_Name
			</th>
			<th>
				@ViewResources.Last_Name
			</th>
			<th>
				@ViewResources.Email
			</th>
			<th>
				@ViewResources.Group
			</th>
@if (viewFlags.HasLevelRight)
{
			<th>
				@ViewResources.Level
			</th>
}
			<th>
				@ViewResources.Creator
			</th>
			<th>
				@ViewResources.Created_Date
			</th>
			<th>
				@ViewResources.Last_Login_Date
			</th>
@if (viewFlags.HasLevelRight)
{
			<th>
				@ViewResources.Active
			</th>
}
@if (viewFlags.HasEditRight || viewFlags.HasAssignSiteRight || viewFlags.HasLevelRight)
{
			<th>
				@ViewResources.Action
			</th>
}
		</tr>
	</thead>
	<tbody>
@if (!ReferenceEquals(Model, null) && Model.Count() > 0)
{
	int i = 0;
	foreach (var item in Model)
	{
		string rowCss = i % 2 == 0 ? string.Empty : "class=\"alt\"";
		
		<tr @Html.Raw(rowCss)>
			<td class="align-center">
				@(i + 1)
			</td>
			<td>
				<a href="javascript:;" uid="@item.User.Id" class="lnk-user-info"
					title="@ViewResources.View_details_of '@item.User.Username'">@item.User.Username</a>
			</td>
			<td>
				@item.User.FirstName
			</td>
			<td>
				@item.User.LastName
			</td>
			<td>
				@item.User.Email
			</td>
			<td>
				@(item.User.Group != null ? item.User.Group.Name : string.Empty)
			</td>
		@if (viewFlags.HasLevelRight)
  {
			<td class="align-center">
			@if (item.Level == (int)Constant.Level.PortalAdmin)
   {
				@ViewResources.Portal_Admin
   }
   else if (item.Level == (int)Constant.Level.SiteAdmin)
   {
				@ViewResources.Site_Admin
   }
   else
   {
				@ViewResources.User
   }
			</td>
  }
			<td>
				@(item.User.Creator != null ? item.User.Creator.Username : string.Empty)
			</td>
			<td class="align-center">
				@item.User.CreatedDate.ToFullDateString()
			</td>
			<td class="align-center">
		@if (item.User.LastLoginDate != DateTime.MinValue)
  {
				@item.User.LastLoginDate.ToFullDateString()
  }
  else
  {
				@ViewResources.NA
  }
			</td>
		@if (viewFlags.HasLevelRight)
  {
			<td class="align-center">
			@if (item.IsActive)
   {
				<img src="~/areas/usercontrol/themes/nap/img/blank.png" alt="" class="ico-tick" />
   }
			</td>
  }
		@if (viewFlags.HasEditRight || viewFlags.HasAssignSiteRight || viewFlags.HasLevelRight)
  {
			<td class="align-center">
				<div class="action-wrp">
					<span class="btn-action">@ViewResources.Action</span>
					<div class="relative">
						<ul class="actions">
			@if (viewFlags.HasEditRight)
   {
							<li>
								@Html.ActionLink(string.Format("{0} '{1}' {2}", ViewResources.Edit, item.User.Username, ViewResources.Details),
									"Edit", new { id = item.User.Id }, new { @class = "dd-edit" })
							</li>
							<li>
								@Html.ActionLink(string.Format("{0} '{1}' {2}", ViewResources.Reset, item.User.Username, ViewResources.Password),
									"ResetPassword", new { id = item.User.Id }, new { @class = "dd-chgpwd" })
							</li>
   }
			@if (viewFlags.HasAssignSiteRight)
   {
	   if (item.User.Id != userId)
	   {
		   if (level > item.Level || !item.IsActive)
		   {
							<li>@Html.ActionLink("Assign site to '" + item.User.Username + "'", "AssignSite",
										new { id = item.User.Id }, new { @class = "dd-site" })</li>
		   }
	   }
	   else if (level == (int)Constant.Level.PortalAdmin)
	   {
							<li>@Html.ActionLink("Assign site to '" + item.User.Username + "'", "AssignSite",
										new { id = item.User.Id }, new { @class = "dd-site" })</li>
	   }
   }
			@if (viewFlags.HasLevelRight)
   {
	   if (item.User.Id != userId)
	   {
		   if (level > item.Level || !item.IsActive)
		   {
							<li>@Html.ActionLink("Assign permission to '" + item.User.Username + "'", "AssignPermission", "User",
									new { id = item.User.Id }, new { @class = "dd-permission" })</li>
		   }
	   }
	   else if (level == (int)Constant.Level.PortalAdmin)
	   {
							<li>@Html.ActionLink("Assign permission to '" + item.User.Username + "'", "AssignPermission", "User",
									new { id = item.User.Id }, new { @class = "dd-permission" })</li>
	   }
   }
						</ul>
					</div>
				</div>
			</td>
  }
		</tr>

  i++;
	}
}
else
{
		<tr>
			<td colspan="12" class="align-center">
				@ViewResources.NoInformationAvailable
			</td>
		</tr>
}
	</tbody>
</table>
@section Foot {
	<script src="~/Areas/UserControl/scripts/User/Manage.js" type="text/javascript"></script>
}