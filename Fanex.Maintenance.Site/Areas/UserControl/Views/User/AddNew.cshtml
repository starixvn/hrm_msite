@using Fanex.NAP.Core.Criteria.User
@model InsertCustCriteria
@{
	ViewBag.Title = string.Format("{0} {1}", ViewResources.Create_New, ViewResources.User);
	bool success = ViewBag.Success != null && ViewBag.Success;
}
@section Head {
	<link href="~/Areas/UserControl/themes/nap/style.less" rel="stylesheet" type="text/css" />
}
@section Headline {
	<h1>
		<span class="title">
			<span class="first">@ViewResources.User_Management /</span>
			@ViewBag.Title
		</span>
		@Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "User", null, new { @class = "lnk" })
	</h1>
}
@using (Html.BeginForm())
{
	<div class="form">
		<div class="form-row summary">
			<div class="lbl-field"></div>
			<div class="edit-field">
				@Html.ValidationSummary()
			</div>
		</div>
		<div class="form-row required">
			<div class="lbl-field">
				@Html.LabelFor(c => c.Username)
			</div>
			<div class="edit-field">
				@Html.TextBoxFor(c => c.Username)
			</div>
		</div>
		<div class="form-row required">
			<div class="lbl-field">
				@Html.LabelFor(c => c.UserPwd)
			</div>
			<div class="edit-field">
				@Html.PasswordFor(c => c.UserPwd)
			</div>
		</div>
		<div class="form-row">
			<div class="lbl-field">
				@Html.LabelFor(c => c.FirstName)
			</div>
			<div class="edit-field">
				@Html.TextBoxFor(c => c.FirstName)
			</div>
		</div>
		<div class="form-row">
			<div class="lbl-field">
				@Html.LabelFor(c => c.LastName)
			</div>
			<div class="edit-field">
				@Html.TextBoxFor(c => c.LastName)
			</div>
		</div>
		<div class="form-row">
			<div class="lbl-field">
				@Html.LabelFor(c => c.Email)
			</div>
			<div class="edit-field">
				@Html.TextBoxFor(c => c.Email)
			</div>
		</div>
		<div class="form-row">
			<div class="lbl-field">
				@Html.LabelFor(c => c.GroupId)
			</div>
			<div class="edit-field">
				@Html.DropDownListFor(c => c.GroupId, (List<SelectListItem>)ViewBag.Groups)
			</div>
		</div>
		<div class="form-row">
			<div class="lbl-field"></div>
			<div class="edit-field">
	@if (!success)
	{
				<input type="submit" value="@ViewResources.Create" />
				<button onclick="NAP.redirect('User/Manage', 0); return false;">@ViewResources.Cancel</button>
	}
			</div>
		</div>
	</div>
}
@section Foot {
	<script src="~/Areas/UserControl/scripts/lib/jquery.numeric.js" type="text/javascript"></script>

	@if (success)
	{
		string dialogMsg = string.Format(ViewResources.AddSuccessMsg, ViewResources.User + " '" + Model.Username + "'", 5);

		<script type="text/javascript">
			$(function () {
				NAP.showSuccessMsg('@dialogMsg', 'User/Manage', 6000);
			});
		</script>
	}
}