@using Fanex.NAP.Core.Criteria.User
@model AssignFunctionUserCriteria
@{
	ViewBag.Title = string.Format("{0} to {1} '{2}'", ViewResources.Assign_Permission, ViewResources.User,
		Model.Username);
	bool success = ViewBag.Success != null && ViewBag.Success;
	var viewFlags = ViewBag.ViewFlags as ViewFlags;

	var functionList = ViewBag.FunctionList as List<IFunction>;
	var userFuncPolicyList = ViewBag.UserFuncPolicyList as List<FunctionPolicy>;
	var currentUserFuncPolicyList = ViewBag.CurrentUserFuncPolicyList as List<FunctionPolicy>;
	var groupFuncPolicyList = ViewBag.GroupFuncPolicyList as List<FunctionPolicy>;
	var userLevel = ViewBag.UserLevel as int?;
}
@section Head {
	<link href="~/Areas/UserControl/themes/nap/style.less" rel="stylesheet" type="text/css" />
}
@section Headline {
	<h1>
		<span class="title">
			<span class="first">@ViewResources.User_Management /</span>
			@ViewBag.Title
		</span>
		@Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "User", null, new { @class = "lnk" })
	</h1>
}
@if (viewFlags.IsNapAdminSite)
{
<section id="filter-bar">
	@using (Html.BeginForm("AssignPermission", "User", FormMethod.Get))
	{
		<div class="filter-form">
			<div class="lbl-field width-auto">
				@Html.LabelFor(m => m.SiteId)
			</div>
			<div class="edit-field">
				@Html.DropDownListFor(m => m.SiteId, ViewBag.Sites as List<SelectListItem>,
					new { onchange = "this.form.submit()" })
			</div>
		</div>
}
</section>
}
@using (Html.BeginForm())
{
	<div class="form">
		<div class="form-row summary">
			<div class="edit-field">
				@Html.ValidationSummary()
			</div>
		</div>
		@Html.Hidden("HasAssignPermission", viewFlags.HasAssignFunctionRight)
		<input type="hidden" name="UserId" value="@Model.UserId" />
		<input type="hidden" name="SiteId" value="@Model.SiteId" />
		<table class="grid">
			<thead>
				<tr>
					<th rowspan="2"> @ViewResources.Function </th>
					<th colspan="2"> @ViewResources.User @ViewResources.Permission </th>
					<th colspan="2"> @ViewResources.Group @ViewResources.Permission </th>
				</tr>
				<tr>
					<th style="width: 50px"> @ViewResources.Read </th>
					<th style="width: 50px"> @ViewResources.Host </th>
					<th style="width: 50px"> @ViewResources.Read </th>
					<th style="width: 50px"> @ViewResources.Host </th>
				</tr>
			</thead>
			<tbody>
@if (functionList.Count > 0)
{
	var functionCount = functionList.Count;
	for (int i = 0; i < functionCount; i++)
	{
		var function = functionList[i];
		var userFuncPolicy = userFuncPolicyList.Where(x => x.Function.Id == function.Id).SingleOrDefault();
		var currentUserFuncPolicy = currentUserFuncPolicyList.Where(x => x.Function.Id == function.Id).SingleOrDefault();
		var groupFuncPolicy = new FunctionPolicy();
		if (!ReferenceEquals(groupFuncPolicyList, null))
		{
			groupFuncPolicy = groupFuncPolicyList.Where(x => x.Function.Id == function.Id).FirstOrDefault();
		}

		var funcNameStyle = i == functionCount - 1 ? "nbt" : "nbt nbb";
		if (function.Parent == null)
		{
			funcNameStyle = i == functionCount - 1 ? string.Empty : "nbb";
		}
		string parentId = function.Parent != null ? function.Parent.Id.ToString() : string.Empty;
		string chkReadId = "funcRead" + function.Id;
		string checkedReadCss = userFuncPolicy != null && userFuncPolicy.Policy >= (int)Constant.Policy.Read 
			? "checked=\"checked\"" : string.Empty;
		bool isReadDisabled = userLevel != (int)Constant.Level.PortalAdmin
			&& (currentUserFuncPolicy == null || currentUserFuncPolicy.Policy < (int)Constant.Policy.Read
			|| (userFuncPolicy != null && currentUserFuncPolicy.Policy < userFuncPolicy.Policy));
	 
				<tr>
					<td class="@Html.Raw(funcNameStyle)">@IndentChildFunctions(functionList, function)
					</td>
					<td class="align-center">
			@if (isReadDisabled)
			{
						<input disabled="disabled" type="checkbox" @Html.Raw(checkedReadCss) />
			}
			else
			{
						<input id="@chkReadId" name="funcRead" value="@function.Id" pid="@parentId" 
							type="checkbox" @Html.Raw(checkedReadCss) />
			}
					</td>
					<td class="align-center">
		@if (function.Crud > 0)
		{
			string chkHostId = "funcHost" + function.Id;
			string checkedHostCss = userFuncPolicy != null && userFuncPolicy.Policy >= (int)Constant.Policy.Host 
				? "checked=\"checked\"" : string.Empty;
			bool isHostDisabled = userLevel != (int)Constant.Level.PortalAdmin
				&& (currentUserFuncPolicy == null || currentUserFuncPolicy.Policy < (int)Constant.Policy.Host
				|| (userFuncPolicy != null && currentUserFuncPolicy.Policy < userFuncPolicy.Policy));

			if (isHostDisabled)
			{
					<input disabled="disabled" type="checkbox" @Html.Raw(checkedHostCss) />
			}
			else
			{
					<input id="@chkHostId" name="funcHost" value="@function.Id" pid="@parentId" 
						type="checkbox" @Html.Raw(checkedHostCss) />
			}
		}
					</td>
					<td class="align-center">
		@if (!ReferenceEquals(groupFuncPolicyList, null))
		{
			string checkedGroupReadCss = groupFuncPolicy != null && groupFuncPolicy.Policy >= (int)Constant.Policy.Read
				? "checked=\"checked\"" : string.Empty;

						<input disabled="disabled" type="checkbox" @Html.Raw(checkedGroupReadCss) />
		}
					</td>
					<td class="align-center">
		@if (function.Crud > 0)
		{
			if (!ReferenceEquals(groupFuncPolicyList, null))
			{
				string checkedGroupHostCss = groupFuncPolicy != null && groupFuncPolicy.Policy >= (int)Constant.Policy.Host
					? "checked=\"checked\"" : string.Empty;

							<input disabled="disabled" type="checkbox" @Html.Raw(checkedGroupHostCss) />
			}
		}
					</td>
				</tr>
	}
}
else
{
				<tr>
					<td colspan="5" class="align-center"> @ViewResources.NoInformationAvailable </td>
				</tr>
}
			</tbody>
		</table>
		<br class="clear-fix" />
		<div class="form-row">
			<div class="edit-field">
@if (!success)
{
				<input type="submit" value="@ViewResources.Save" id="btnAssignFunction" />
				<button onclick="NAP.redirect('User/Manage', 0); return false;">@ViewResources.Cancel</button>
}
			</div>
		</div>
	</div>
}

@section Foot {
	<script src="~/Areas/UserControl/scripts/User/AssignPermission.js" type="text/javascript"></script>
	<script src="~/Areas/UserControl/scripts/lib/jquery.numeric.js" type="text/javascript"></script>

	@if (success)
	{
		string dialogMsg = string.Format(ViewResources.AssignPermissionSuccessMsg, 
			ViewResources.User + " '" + Model.Username + "'", 5);

		<script type="text/javascript">
			$(function () {
				NAP.showSuccessMsg('@dialogMsg', 'User/Manage', 6000);
			});
		</script>
	}
}
@helper IndentChildFunctions(List<IFunction> functionList, IFunction function, int level = 0)
	{
		if (function.Parent != null)
		{
			var parent = functionList.Where(x => x.Id == function.Parent.Id).SingleOrDefault();

	@IndentChildFunctions(functionList, parent, level + 1)
		}
		else
		{
			for (int i = 0; i < level; i++)
			{
				if (i == level - 1)
				{
	<span>&#9492;&#9472;&#9472;</span>
				}
				else
				{
	<span class="invisible">&#9492;&#9472;&#9472;</span>
				}
			}
		}

		if (level == 0)
		{
	@function.Name
		}
}