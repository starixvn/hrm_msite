@using Fanex.NAP.Core.Criteria.User
@model ResetPasswordCustCriteria
@{
    ViewBag.Title = string.Format("{0} {1}", ViewResources.Reset, ViewResources.Password);
    bool success = ViewBag.Success != null && ViewBag.Success;
}
@section Head {
    <link href="~/Areas/UserControl/themes/nap/style.less" rel="stylesheet" type="text/css" />
}
@section Headline {
    <h1>
        <span class="title"><span class="first">@ViewResources.User_Management
            /</span>
            @ViewBag.Title</span>
        @Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "User", null, new { @class = "lnk" })
    </h1>
}
@using (Html.BeginForm())
{
    <div class="form w120">
        <div class="form-row summary">
            <div class="lbl-field">
            </div>
            <div class="edit-field">
                @Html.ValidationSummary()
            </div>
        </div>
        @Html.HiddenFor(c => c.CustId)
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.Username, new { @for = "", @class = "read-only" })
            </div>
            <div class="edit-field">
                <label class="read-only">@Model.Username</label>
                @Html.HiddenFor(m => m.Username)
            </div>
        </div>
        <div class="form-row required">
            <div class="lbl-field">
                @Html.LabelFor(c => c.UserPwd)
            </div>
            <div class="edit-field">
                @Html.PasswordFor(c => c.UserPwd)
            </div>
        </div>
        <div class="form-row required">
            <div class="lbl-field">
                @Html.LabelFor(c => c.ConfirmUserPwd)
            </div>
            <div class="edit-field">
                @Html.PasswordFor(c => c.ConfirmUserPwd)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
            </div>
            <div class="edit-field">
                @if (!success)
                {                   
                    <input type="submit" value="@ViewResources.Save" />
                    <button onclick="NAP.redirect('User/Manage', 0); return false;">@ViewResources.Cancel</button>
                }
            </div>
        </div>
    </div>
}
@section Foot
{
    @if (success)
    {
        string dialogMsg = string.Format(ViewResources.ResetPwdSuccessMsg, Model.Username, 5);

        <script type="text/javascript">
            $(function () {
                NAP.showSuccessMsg('@dialogMsg', 'User/Manage', 6000);
            });

        </script>
    }
}
