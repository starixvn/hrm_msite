@using Fanex.NAP.Core.Criteria.User
@model UpdateCustCriteria
@{
    ViewBag.Title = string.Format("{0} {1}", ViewResources.Update, ViewResources.User);
    bool success = ViewBag.Success != null && ViewBag.Success;
}
@section Head {
    <link href="~/Areas/UserControl/themes/nap/style.less" rel="stylesheet" type="text/css" />
}
@section Headline {
    <h1>
        <span class="title"><span class="first">@ViewResources.User_Management
            /</span>
            @ViewBag.Title
        </span>
        @Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "User", null, new { @class = "lnk" })
    </h1>
}
@using (Html.BeginForm())
{
    @Html.HiddenFor(c => c.CustId)
    @Html.HiddenFor(c => c.Username)

    <div class="form">
        <div class="form-row summary">
            <div class="lbl-field">
            </div>
            <div class="edit-field">
                @Html.ValidationSummary()
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.CustId, ViewResources.Username, new { @class = "read-only" })
            </div>
            <div class="edit-field">
                @Html.Label(Model.Username, new { @class = "read-only" })
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(c => c.FirstName)
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(c => c.FirstName)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(c => c.LastName)
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(c => c.LastName)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(c => c.Email)
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(c => c.Email)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(c => c.GroupId)</div>
            <div class="edit-field">
                @Html.DropDownListFor(c => c.GroupId, (List<SelectListItem>)ViewBag.Groups)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
            </div>
            <div class="edit-field">
                @if (!success)
                {                   
                    <input type="submit" value="@ViewResources.Save" />
                    <button onclick="NAP.redirect('User/Manage', 0); return false;">@ViewResources.Cancel</button>
                }
            </div>
        </div>
    </div>
}
@section Foot {
    @if (success)
    {
        string dialogMsg = string.Format(ViewResources.EditSuccessMsg, Model.Username, 5);

        <script type="text/javascript">
            $(function () {
                NAP.showSuccessMsg('@dialogMsg', 'User/Manage', 6000);
            });

        </script>
    }
}
