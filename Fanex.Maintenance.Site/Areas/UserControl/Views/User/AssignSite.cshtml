<div class="form">
    <div class="site-container-wrp">
        <table class="site-container">
            <thead>
                <tr>
                    <th class="user-site">
                        @ViewBag.Username's Site(s)
                    </th>
                    <th>
                        Available Site(s)
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="user-site">
                    </td>
                    <td class="available-site">
                        @if (sites != null && sites.Count > 0)
                        {
                            foreach (var site in sites)
                            {
                            <div class="site">
                                @site.Name
                                <a href="javascript:;" title="@ViewResources.Remove">&times;</a>
                            </div>
                            }
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="form-row">
        <div class="edit-field">
            <input type="submit" value="@ViewResources.Save" id="btnAssignSite" />
            <button onclick="NAP.redirect('User/Manage', 0); return false;">@ViewResources.Cancel</button>
        </div>
    </div>
</div>
@section Foot {
    <script src="~/Areas/UserControl/scripts/User/AssignSite.js" type="text/javascript"></script>
}
