@{
    ViewBag.Title = string.Format("{0} {1} {2} '{3}'", ViewResources.Assign_Site, ViewResources.To, ViewResources.User, ViewBag.Username);
    var viewFlags = (ViewFlags)ViewBag.ViewFlags;
    var level = ViewBag.Level != null ? (int)ViewBag.Level : 0;
    var isPortalAdminSelftEdit = ViewBag.IsPortalAdminSelfEdit != null ? (bool)ViewBag.IsPortalAdminSelfEdit : false;
    int NapAdminId = 1;
    var sites = ViewBag.Sites as List<ISite>;
}
@section Head {
    <link href="~/Areas/UserControl/themes/nap/user/assign-site.less" rel="stylesheet"
        type="text/css" />
}
@section Headline {
    <h1>
        <span class="title"><span class="first">@ViewResources.User_Management
            /</span>
            @ViewBag.Title</span>
        @Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "User", null, new { @class = "lnk" })
    </h1>
}
@Html.Hidden("UserId", (int)ViewBag.UserId)
@Html.Hidden("HasAssignSite", viewFlags.HasAssignSiteRight)
