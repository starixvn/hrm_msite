<head>
	<meta charset="utf-8" />
	<title>Sign In</title>
	<link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
	<meta name="viewport" content="width=device-width" />
	<link href="~/areas/userlogin/themes/login.css" rel="stylesheet" type="text/css" />
</head>
<body>
	<div id='not-supported-browser-panel' style="display: none">
		Your browser is no longer supported. Some parts will not work and you may experience problems.<br />
		If you are having problems, try <a href='http://browsehappy.com/'>this</a> for full browsing experience. Thank you!
	</div>
@using (Html.BeginForm())
{
	<div id="login-box">
		<div id="msg">
			<span id="inner-msg">@ViewBag.Message</span>
		</div>
		<div class="header">
			<div class="welcome"></div>
			<div class="secure"></div>
		</div>
		<div class="auth">
			<input type="text" id="username" name="username" autocomplete="off" />
			<input type="password" id="password" name="password" />
			<input type="submit" id="submit" value="Sign In" />
		</div>
	</div>
}
</body>
</html>

